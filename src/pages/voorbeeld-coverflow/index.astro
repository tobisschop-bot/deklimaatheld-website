---
import Base from '../../layouts/Base.astro';
const K = [
  { img: '/img/werk-installatie-binnen.webp', type: 'All-electric', titel: 'Weheat all-electric', plaats: 'Den Haag', jaar: '2026', info: 'Volledig gasvrij gemaakt met een Weheat warmtepomp, boiler en buffervat. Waterzijdig ingeregeld op lage temperatuur.', punten: ['Weheat Blackbird', 'Boiler 200 L', 'Radiatoren'] },
  { img: '/img/werk-installatie-buiten.webp', type: 'Warmtepomp', titel: 'Buitenunit aan de gevel', plaats: 'Rijswijk', jaar: '2026', info: 'Stille buitenunit netjes tegen de gevel, leidingwerk strak weggewerkt.', punten: ['R290', 'Gevelmontage'] },
  { img: '/img/jaga-strada-interieur.webp', type: 'LT-verwarming', titel: 'Jaga Strada radiatoren', plaats: 'Delft', jaar: '2025', info: 'Lage-temperatuurradiatoren zodat de warmtepomp extra zuinig draait.', punten: ['Jaga Strada', '3 ruimtes'] },
  { img: '/img/werk-installatie-binnen.webp', type: 'Hybride', titel: 'Hybride met cv-ketel', plaats: 'Voorburg', jaar: '2025', info: 'Warmtepomp naast de bestaande ketel: ruim 70% minder gas.', punten: ['Weheat Sparrow', 'Bestaande ketel'] },
  { img: '/img/werk-installatie-buiten.webp', type: 'Airco', titel: 'Airco slaapkamer', plaats: 'Den Haag', jaar: '2025', info: 'Koelen in de zomer, bijverwarmen in het voorjaar.', punten: ['Single split', '2,5 kW'] },
];
const dots = K.map((_, i) => i);
---
<Base title="Coverflow-voorbeelden" description="voorbeeld">
<main class="vb">

<section id="V1" class="blok blok--d"><span class="tag">1 · Flow + schuifpaneel</span><h2>Ons werk</h2><p class="hint">Sleep ↔ · tik op de middelste</p>
  <div class="cf" data-v="1">{K.map(k=>(<div class="k"><img src={k.img} alt="" draggable="false"/><span class="pill">{k.type}</span><b class="kt">{k.titel}<small>{k.plaats}</small></b></div>))}</div>
  <div class="dots">{dots.map(()=> <i/>)}</div>
</section>
<div class="sheet" id="sheet" hidden><div class="sheet__bg"></div><div class="sheet__p">
  <div class="sheet__foto"><img alt=""/><button class="nav nav--l" aria-label="vorige">‹</button><button class="nav nav--r" aria-label="volgende">›</button></div>
  <div class="sheet__grip"></div>
  <div class="sheet__i"><span class="pill pill--s"></span><h3></h3><p class="meta"></p><p class="tx"></p><div class="chips"></div><a class="cta" href="/offerte/">Ook zoiets? Vraag advies aan →</a></div>
</div></div>

<section id="V2" class="blok blok--d2"><span class="tag">2 · Draaiende ring</span><h2>Ons werk</h2><p class="hint">Draai de ring ↔ · tik om om te draaien</p>
  <div class="ring" data-v="2">{K.map(k=>(<div class="k"><div class="k__in">
    <div class="k__v"><img src={k.img} alt="" draggable="false"/><span class="pill">{k.type}</span><b class="kt">{k.titel}<small>{k.plaats}</small></b></div>
    <div class="k__a"><span class="pill pill--s">{k.type}</span><h3>{k.titel}</h3><p class="meta">📍 {k.plaats} · {k.jaar}</p><p>{k.info}</p><div class="chips">{k.punten.map(p=><span>{p}</span>)}</div></div>
  </div></div>))}</div>
  <div class="dots">{dots.map(()=> <i/>)}</div>
</section>

<section id="V3" class="blok"><span class="tag">3 · Flow + live info</span><h2>Ons werk</h2><p class="hint">Sleep ↔ · tik voor het hele verhaal</p>
  <div class="cf cf--3" data-v="3">{K.map(k=>(<div class="k"><img src={k.img} alt="" draggable="false"/>
    <div class="k__la"><span class="pill pill--s">{k.type}</span><b>{k.titel}</b><p class="meta">📍 {k.plaats} · {k.jaar}</p><div class="k__meer"><p>{k.info}</p><div class="chips">{k.punten.map(p=><span>{p}</span>)}</div><a class="cta cta--k" href="/offerte/">Ook zoiets? →</a></div><span class="k__pijl">⌃</span></div>
  </div>))}</div>
  <div class="mini">{K.map(k=>(<i style={`background-image:url(${k.img})`}/>))}</div>
</section>
</main>
<script type="application/json" id="kd" set:html={JSON.stringify(K)}/>
<script>
const K=JSON.parse(document.getElementById('kd')!.textContent!);
type R=(el:HTMLElement,d:number)=>void;
function flow(root:HTMLElement,render:R,onTap:(i:number,el:HTMLElement)=>void,ind:HTMLElement[]){
  const ks=[...root.querySelectorAll<HTMLElement>(':scope > .k')];let pos=0,start=0,x0=0,moved=0,down=false,anim=0;
  const w=()=>root.clientWidth*0.5;
  const draw=()=>{ks.forEach((k,i)=>render(k,i-pos));const c=Math.round(pos);ind.forEach((d,i)=>d.classList.toggle('on',i===c));ks.forEach((k,i)=>k.classList.toggle('mid',i===c));};
  const snap=(t:number)=>{cancelAnimationFrame(anim);t=Math.max(0,Math.min(ks.length-1,t));const f=pos,t0=performance.now();const st=(n:number)=>{const p=Math.min(1,(n-t0)/380),e=1-Math.pow(1-p,3);pos=f+(t-f)*e;draw();if(p<1)anim=requestAnimationFrame(st);};anim=requestAnimationFrame(st);};
  root.addEventListener('pointerdown',e=>{down=true;x0=e.clientX;start=pos;moved=0;cancelAnimationFrame(anim);root.setPointerCapture(e.pointerId);root.classList.add('drag');});
  root.addEventListener('pointermove',e=>{if(!down)return;const dx=e.clientX-x0;moved=Math.max(moved,Math.abs(dx));pos=start-dx/w();pos=Math.max(-.4,Math.min(ks.length-.6,pos));draw();});
  root.addEventListener('pointerup',e=>{down=false;root.classList.remove('drag');if(moved<6){const el=document.elementsFromPoint(e.clientX,e.clientY).find(x=>(x as HTMLElement).classList?.contains('k')) as HTMLElement;const i=ks.indexOf(el);if(i<0)return;if(i===Math.round(pos))onTap(i,el);else snap(i);return;}const dx=e.clientX-x0;snap(Math.abs(dx)>30&&Math.round(pos)===Math.round(start)?start+(dx<0?1:-1):Math.round(pos));});
  ind.forEach((d,i)=>d.addEventListener('click',()=>snap(i)));
  draw();return {snap,get pos(){return pos}};
}
const dotsOf=(s:string)=>[...document.querySelectorAll<HTMLElement>(s)];
// V1
const sheet=document.getElementById('sheet')!;let cur=0;
const fill=(i:number)=>{cur=i;const k=K[i],q=(s:string)=>sheet.querySelector(s) as HTMLElement;(q('img') as HTMLImageElement).src=k.img;q('.pill').textContent=k.type;q('h3').textContent=k.titel;q('.meta').textContent='📍 '+k.plaats+' · '+k.jaar;q('.tx').textContent=k.info;q('.chips').innerHTML=k.punten.map((p:string)=>`<span>${p}</span>`).join('');};
const f1=flow(document.querySelector('[data-v="1"]')!,(k,d)=>{const a=Math.max(-1,Math.min(1,d));k.style.transform=`translateX(${d*58}%) translateZ(${-Math.abs(d)*120}px) rotateY(${-a*35}deg)`;k.style.zIndex=String(100-Math.round(Math.abs(d)*10));k.style.opacity=String(Math.max(0,1-Math.abs(d)*.35));k.style.filter=`brightness(${1-Math.min(1,Math.abs(d))*.45})`;},
 (i)=>{fill(i);sheet.hidden=false;document.body.style.overflow='hidden';requestAnimationFrame(()=>sheet.classList.add('open'));},dotsOf('#V1 .dots i'));
const close=()=>{sheet.classList.remove('open');document.body.style.overflow='';setTimeout(()=>sheet.hidden=true,350);};
sheet.querySelector('.sheet__bg')!.addEventListener('click',close);
sheet.querySelector('.nav--l')!.addEventListener('click',()=>{const i=(cur-1+K.length)%K.length;fill(i);f1.snap(i);});
sheet.querySelector('.nav--r')!.addEventListener('click',()=>{const i=(cur+1)%K.length;fill(i);f1.snap(i);});
{const p=sheet.querySelector<HTMLElement>('.sheet__p')!;let y0=0,dy=0,on=false;
 p.addEventListener('touchstart',e=>{if(p.scrollTop>0)return;on=true;y0=e.touches[0].clientY;},{passive:true});
 p.addEventListener('touchmove',e=>{if(!on)return;dy=Math.max(0,e.touches[0].clientY-y0);p.style.transform=`translateY(${dy}px)`;},{passive:true});
 p.addEventListener('touchend',()=>{on=false;p.style.transform='';if(dy>90)close();dy=0;});}
// V2
const n=K.length,ang=360/n;
flow(document.querySelector('[data-v="2"]')!,(k,d)=>{k.style.transform=`rotateY(${d*ang}deg) translateZ(var(--r))`;const v=Math.cos(d*ang*Math.PI/180);k.style.opacity=String(Math.max(.15,v));k.style.zIndex=String(Math.round(v*100)+100);if(Math.abs(d)>.5)k.classList.remove('om');},
 (_,el)=>el.classList.toggle('om'),dotsOf('#V2 .dots i'));
// V3
const mini=dotsOf('.mini i');
flow(document.querySelector('[data-v="3"]')!,(k,d)=>{const a=Math.max(-1,Math.min(1,d));k.style.transform=`translateX(${d*72}%) scale(${1-Math.min(1,Math.abs(d))*.14}) rotateY(${-a*18}deg)`;k.style.zIndex=String(100-Math.round(Math.abs(d)*10));k.style.opacity=String(Math.max(0,1-Math.abs(d)*.4));if(Math.abs(d)>.5)k.classList.remove('open');},
 (_,el)=>el.classList.toggle('open'),mini);
</script>
</Base>
<style>
.vb{background:#F3F4F8}
.blok{padding:40px 0 44px;overflow:hidden}.blok>.tag,.blok>h2,.blok>.hint{margin-left:16px;margin-right:16px}
.blok--d{background:var(--navy);color:#fff}.blok--d2{background:linear-gradient(#0f1424,#1d2440);color:#fff}.blok--d h2,.blok--d2 h2{color:#fff}
.tag{display:inline-block;font-size:.75rem;font-weight:700;background:#111;color:#fff;padding:3px 10px;border-radius:6px}.blok--d .tag,.blok--d2 .tag{background:#fff;color:#111}
h2{margin:10px 16px 2px}.hint{font-size:.85rem;color:#778;margin:0 16px 22px}.blok--d .hint,.blok--d2 .hint{color:#9AA3B5}
.pill{position:absolute;left:12px;top:12px;font-size:.72rem;font-weight:700;color:#fff;background:var(--red);padding:3px 10px;border-radius:999px;z-index:2}.pill--s{position:static;display:inline-block}
.meta{color:#778;margin:2px 0 10px;font-size:.88rem}
.chips{display:flex;flex-wrap:wrap;gap:6px}.chips :global(span){font-size:.75rem;font-weight:700;background:var(--navy);color:#fff;padding:3px 9px;border-radius:999px}
.cta{display:inline-block;margin-top:16px;background:var(--red);color:#fff;font-weight:700;padding:11px 16px;border-radius:10px;text-decoration:none}
.dots{display:flex;justify-content:center;gap:6px;margin-top:22px}.dots i{width:7px;height:7px;border-radius:4px;background:rgba(255,255,255,.3);transition:.25s;cursor:pointer}.dots i.on{width:22px;background:var(--red)}
.k img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;user-select:none}
.kt{position:absolute;left:14px;right:14px;bottom:14px;color:#fff;z-index:2;font-size:1.05rem}.kt small{display:block;font-weight:500;font-size:.82rem;color:#C9CFDA}
/* V1 */
.cf{position:relative;height:360px;perspective:1000px;touch-action:pan-y;user-select:none;cursor:grab}
.cf>.k{position:absolute;left:50%;top:0;width:64%;margin-left:-32%;height:100%;border-radius:18px;overflow:hidden;background:#000;box-shadow:0 30px 50px -25px rgba(0,0,0,.8)}
.cf>.k::after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,rgba(5,8,20,.9))}
.cf>.k.mid::before{content:'Tik voor info';position:absolute;right:12px;top:12px;z-index:3;font-size:.7rem;font-weight:700;color:#fff;background:rgba(255,255,255,.18);backdrop-filter:blur(6px);padding:4px 9px;border-radius:999px}
.sheet{position:fixed;inset:0;z-index:200}.sheet__bg{position:absolute;inset:0;background:rgba(5,8,20,.7);opacity:0;transition:.35s}
.sheet__p{position:absolute;left:0;right:0;bottom:0;max-height:92vh;overflow-y:auto;background:#fff;color:#111;border-radius:22px 22px 0 0;transform:translateY(100%);transition:transform .4s cubic-bezier(.2,.9,.2,1)}
.sheet.open .sheet__bg{opacity:1}.sheet.open .sheet__p{transform:none}
.sheet__foto{position:relative;height:46vh}.sheet__foto img{width:100%;height:100%;object-fit:cover}
.sheet__grip{position:absolute;top:8px;left:50%;width:44px;height:5px;margin-left:-22px;border-radius:3px;background:rgba(255,255,255,.8);z-index:3}
.nav{position:absolute;top:50%;margin-top:-20px;width:40px;height:40px;border-radius:50%;border:0;background:rgba(255,255,255,.85);font-size:1.6rem;line-height:1;cursor:pointer}.nav--l{left:10px}.nav--r{right:10px}
.sheet__i{padding:18px 18px 34px}.sheet__i h3{margin:8px 0 0}
/* V2 */
.ring{--r:230px;position:relative;height:340px;perspective:1100px;transform-style:preserve-3d;touch-action:pan-y;user-select:none;cursor:grab}
.ring>.k{position:absolute;left:50%;top:10px;width:200px;margin-left:-100px;height:300px;transform-style:preserve-3d}
.k__in{position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.3,1.3,.5,1);transform-style:preserve-3d}.k.om .k__in{transform:rotateY(180deg) scale(1.08)}
.k__v,.k__a{position:absolute;inset:0;border-radius:16px;overflow:hidden;backface-visibility:hidden;box-shadow:0 25px 45px -20px rgba(0,0,0,.9)}
.k__v::after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,rgba(5,8,20,.9))}
.k__a{transform:rotateY(180deg);background:#fff;color:#111;padding:14px;font-size:.78rem;line-height:1.4;overflow-y:auto}.k__a h3{margin:6px 0 0;font-size:.95rem}.k__a .chips span{font-size:.68rem}.k__a p{margin:0 0 10px}
.blok--d2::after{content:'';display:block;height:1px}
/* V3 */
.cf--3{height:430px}.cf--3>.k{width:78%;margin-left:-39%;background:#ddd;box-shadow:0 25px 45px -25px rgba(10,14,30,.6)}.cf--3>.k::after,.cf--3>.k.mid::before{display:none}
.k__la{position:absolute;left:10px;right:10px;bottom:10px;background:rgba(255,255,255,.86);backdrop-filter:blur(14px);border-radius:14px;padding:12px 14px;z-index:2;transition:.3s}
.k__la b{display:block;margin-top:6px;font-size:1.02rem}.k__la .meta{margin:0}
.k__meer{max-height:0;overflow:hidden;opacity:0;transition:max-height .45s,opacity .3s}.k.open .k__meer{max-height:260px;opacity:1}.k__meer p{margin:10px 0 8px;font-size:.9rem}
.cta--k{margin-top:12px;padding:8px 14px;font-size:.9rem}
.k__pijl{position:absolute;right:12px;top:10px;width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:900;transition:.3s}.k.open .k__pijl{transform:rotate(180deg)}
.mini{display:flex;justify-content:center;gap:6px;margin-top:16px}.mini i{width:34px;height:34px;border-radius:8px;background-size:cover;background-position:center;opacity:.4;transition:.25s;cursor:pointer}.mini i.on{opacity:1;outline:2px solid var(--red);outline-offset:2px;transform:translateY(-3px)}
</style>
