---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { projecten } from '../../data/projecten';
const redenen = [
  { t: 'Meer comfort', p: 'Een warmtepomp verwarmt rustig en gelijkmatig op lage temperatuur. Geen koude hoeken en geen pieken: het hele huis blijft constant op temperatuur. Dat merken onze klanten na de overstap het meest.' },
  { t: 'Lagere energierekening', p: 'Een goed ontworpen warmtepomp haalt het grootste deel van zijn warmte gratis uit de buitenlucht. Je betaalt alleen de stroom om die warmte binnen te brengen, en je bent minder afhankelijk van de gasprijs.' },
  { t: 'Beter voor het milieu', p: 'Je verbrandt thuis geen gas meer en stoot dus geen CO₂ uit bij het verwarmen. Met stroom van zonnepanelen of groene stroom wordt de winst nog groter.' },
];
---
<Base title="Gasvrij of hybride wonen – De Klimaatheld" description="Advies over gasvrij of hybride wonen: meer comfort, lagere kosten en beter voor het milieu.">
  <PageHero label="Advies" title="Gasvrij of hybride wonen" lead="Wij staan achter onze warmtepompen en helpen je stap voor stap van het gas af. Met een systeem dat écht bij je huis past." />

  <section class="section">
    <div class="container narrow">
      <h2>Waarom van het gas af?</h2>
      <div class="gw__kaarten">
        {redenen.map(r => (<div class="gw__kaart"><h3>{r.t}</h3><p>{r.p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section gw__alt">
    <div class="container narrow">
      <h2>Hybride of all-electric?</h2>
      <div class="gw__keuze">
        <div class="gw__kaart">
          <span class="gw__pill">Hybride</span>
          <h3>De eerste stap</h3>
          <p>De warmtepomp doet het grootste deel van het werk; je cv-ketel springt alleen bij op de koudste dagen en voor warm tapwater. Ideaal als je huis nog niet volledig geïsoleerd is of als je het geleidelijk wilt doen.</p>
        </div>
        <div class="gw__kaart">
          <span class="gw__pill">All-electric</span>
          <h3>Helemaal gasvrij</h3>
          <p>De warmtepomp verzorgt alle verwarming én warm tapwater via een boiler. Geen gasaansluiting meer nodig, dus ook geen vastrecht voor gas. Past het best bij een redelijk geïsoleerd huis.</p>
        </div>
      </div>
      <p>Twijfel je? We kijken samen naar je woning, isolatie en afgiftesysteem en adviseren eerlijk wat het beste werkt. Soms is hybride nu slim en stap je later over.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Toekomstbestendig met R290</h2>
      <p>We werken met warmtepompen op <strong>R290 (propaan)</strong>, een natuurlijk koudemiddel. Het broeikaseffect daarvan (GWP) is ongeveer <strong>3</strong>, tegenover zo'n 675 voor R32 en ruim 2000 voor het oudere R410A. Bovendien worden synthetische koudemiddelen in Europa steeds verder beperkt, dus met R290 zit je ook op de lange termijn goed.</p>
      <p>R290 haalt daarnaast hoge aanvoertemperaturen, wat handig is als je bestaande radiatoren wilt blijven gebruiken.</p>
    </div>
  </section>

  <section class="section gw__klus">
    <div class="container">
      <h2>Ons werk</h2>
      <p>Tik op een klus voor meer informatie.</p>
    </div>
    <div class="kr" id="kr">
      {projecten.map(k => (
        <button class="kr__kaart" type="button" data-id={k.id}>
          <img src={k.img} alt={k.alt} loading="lazy" />
          <span class="kr__type">{k.type}</span>
          <span class="kr__naam">{k.titel}<small>{k.plaats}</small></span>
        </button>
      ))}
    </div>
    <div class="kr__dots">{projecten.map((_, i) => <span class:list={['kr__dot', { on: i === 0 }]} />)}</div>
  </section>

  <div class="ks" id="ks" hidden>
    <div class="ks__bg" data-close></div>
    <div class="ks__paneel" role="dialog" aria-modal="true">
      <button class="ks__x" type="button" data-close aria-label="Sluiten">×</button>
      <img class="ks__img" alt="" />
      <div class="ks__info">
        <span class="kr__type ks__type"></span>
        <h3 class="ks__titel"></h3>
        <p class="ks__plaats"></p>
        <p class="ks__tekst"></p>
        <ul class="ks__punten"></ul>
      </div>
    </div>
  </div>
  <script type="application/json" id="kr-data" set:html={JSON.stringify(projecten)} />
  <script>
    const data = JSON.parse(document.getElementById('kr-data')!.textContent!);
    const kr = document.getElementById('kr')!, ks = document.getElementById('ks')!;
    const dots = [...document.querySelectorAll('.kr__dot')];
    kr.addEventListener('scroll', () => {
      const i = Math.round(kr.scrollLeft / (kr.firstElementChild as HTMLElement).offsetWidth);
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
    }, { passive: true });
    const q = (s: string) => ks.querySelector(s) as HTMLElement;
    kr.querySelectorAll<HTMLElement>('.kr__kaart').forEach(b => b.addEventListener('click', () => {
      const k = data.find((x: any) => x.id === b.dataset.id);
      (q('.ks__img') as HTMLImageElement).src = k.img; (q('.ks__img') as HTMLImageElement).alt = k.alt;
      q('.ks__type').textContent = k.type; q('.ks__titel').textContent = k.titel;
      q('.ks__plaats').textContent = k.plaats; q('.ks__tekst').textContent = k.info;
      q('.ks__punten').innerHTML = k.punten.map((p: string) => `<li>${p}</li>`).join('');
      ks.hidden = false; document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => ks.classList.add('open'));
    }));
    const sluit = () => { ks.classList.remove('open'); document.body.style.overflow = ''; setTimeout(() => ks.hidden = true, 300); };
    ks.querySelectorAll('[data-close]').forEach(e => e.addEventListener('click', sluit));
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && !ks.hidden) sluit(); });
  </script>

  <section class="section gw__belofte">
    <div class="container narrow">
      <h2>Onze belofte</h2>
      <p>We ontwerpen je systeem op lage temperatuur en regelen het waterzijdig in. Zo zorgen we ervoor dat je huis comfortabel warm wordt én dat de warmtepomp zo zuinig mogelijk draait. Daar staan we voor.</p>
      <div class="gw__knoppen">
        <Button href="/offerte/">Vraag gratis advies aan</Button>
        <a class="gw__link" href="/warmtepompen/">Bekijk warmtepompen →</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .gw__kaarten, .gw__keuze { display: grid; gap: 12px; margin: 20px 0; }
  .gw__kaart { background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 6px 20px -12px rgba(20,25,45,.3); }
  .gw__kaart h3 { margin: 0 0 6px; }
  .gw__kaart p { margin: 0; }
  .gw__alt { background: #EEF0F5; }
  .gw__pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; margin-bottom: 8px; }
  .gw__belofte { background: var(--navy); color: #fff; }
  .gw__belofte h2 { color: #fff; }
  .gw__belofte p { color: #C9CFDA; }
  .gw__knoppen { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .gw__link { color: #fff; font-weight: 700; text-decoration: none; }
  @media (min-width: 760px) { .gw__kaarten { grid-template-columns: repeat(3,1fr); } .gw__keuze { grid-template-columns: 1fr 1fr; } }
  .kr { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 16px 8px; scroll-padding: 0 16px; scrollbar-width: none; }
  .kr::-webkit-scrollbar { display: none; }
  .kr__kaart { position: relative; flex: 0 0 78%; max-width: 340px; aspect-ratio: 4 / 5; scroll-snap-align: start; border: 0; padding: 0; border-radius: 14px; overflow: hidden; cursor: pointer; background: #222; text-align: left; font: inherit; }
  .kr__kaart img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kr__kaart::after { content: ''; position: absolute; inset: 50% 0 0; background: linear-gradient(transparent, rgba(10,14,30,.85)); }
  .kr__type { position: absolute; left: 12px; top: 12px; z-index: 1; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; }
  .kr__naam { position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 1; color: #fff; font-weight: 800; font-size: 1.05rem; }
  .kr__naam small { display: block; font-weight: 500; font-size: .82rem; color: #C9CFDA; }
  .kr__dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; }
  .kr__dot { width: 7px; height: 7px; border-radius: 50%; background: #C9CFDA; transition: .2s; }
  .kr__dot.on { background: var(--red); width: 18px; border-radius: 4px; }
  .ks { position: fixed; inset: 0; z-index: 100; }
  .ks__bg { position: absolute; inset: 0; background: rgba(10,14,30,.6); opacity: 0; transition: opacity .3s; }
  .ks__paneel { position: absolute; left: 0; right: 0; bottom: 0; max-height: 88vh; overflow-y: auto; background: #fff; border-radius: 18px 18px 0 0; transform: translateY(100%); transition: transform .3s ease; }
  .ks.open .ks__bg { opacity: 1; }
  .ks.open .ks__paneel { transform: none; }
  .ks__x { position: absolute; right: 12px; top: 12px; z-index: 2; width: 36px; height: 36px; border-radius: 50%; border: 0; background: rgba(255,255,255,.9); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .ks__img { width: 100%; max-height: 50vh; object-fit: cover; display: block; }
  .ks__info { position: relative; padding: 20px 16px 32px; }
  .ks__type { position: static; display: inline-block; margin-bottom: 8px; }
  .ks__titel { margin: 0; }
  .ks__plaats { margin: 2px 0 10px; color: #667; }
  .ks__punten { padding-left: 18px; }
  @media (min-width: 760px) { .ks__paneel { max-width: 560px; margin: 0 auto; } .kr__kaart { flex-basis: 300px; } }
</style>
