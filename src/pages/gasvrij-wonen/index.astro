---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { cases, soortLabel } from '../../data/projecten';
const redenen = [
  { t: 'Meer comfort', p: 'Een warmtepomp verwarmt rustig en gelijkmatig op lage temperatuur. Geen koude hoeken en geen pieken: het hele huis blijft constant op temperatuur. Dat merken onze klanten na de overstap het meest.' },
  { t: 'Lagere energierekening', p: 'Een goed ontworpen warmtepomp haalt het grootste deel van zijn warmte gratis uit de buitenlucht. Je betaalt alleen de stroom om die warmte binnen te brengen, en je bent minder afhankelijk van de gasprijs.' },
  { t: 'Beter voor het milieu', p: 'Je verbrandt thuis geen gas meer en stoot dus geen CO₂ uit bij het verwarmen. Met stroom van zonnepanelen of groene stroom wordt de winst nog groter.' },
];
---
<Base title="Gasvrij of hybride wonen – De Klimaatheld" description="Advies over gasvrij of hybride wonen: meer comfort, lagere kosten en beter voor het milieu.">
  <PageHero label="Advies" title="Gasvrij of hybride wonen" lead="Wij staan achter onze warmtepompen en helpen je stap voor stap van het gas af. Met een systeem dat écht bij je huis past." />

  <section class="section">
    <div class="container narrow">
      <h2>Waarom van het gas af?</h2>
      <div class="gw__kaarten">
        {redenen.map(r => (<div class="gw__kaart"><h3>{r.t}</h3><p>{r.p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section gw__alt">
    <div class="container narrow">
      <h2>Hybride of all-electric?</h2>
      <div class="gw__keuze">
        <div class="gw__kaart">
          <span class="gw__pill">Hybride</span>
          <h3>De eerste stap</h3>
          <p>De warmtepomp doet het grootste deel van het werk; je cv-ketel springt alleen bij op de koudste dagen en voor warm tapwater. Ideaal als je huis nog niet volledig geïsoleerd is of als je het geleidelijk wilt doen.</p>
        </div>
        <div class="gw__kaart">
          <span class="gw__pill">All-electric</span>
          <h3>Helemaal gasvrij</h3>
          <p>De warmtepomp verzorgt alle verwarming én warm tapwater via een boiler. Geen gasaansluiting meer nodig, dus ook geen vastrecht voor gas. Past het best bij een redelijk geïsoleerd huis.</p>
        </div>
      </div>
      <p>Twijfel je? We kijken samen naar je woning, isolatie en afgiftesysteem en adviseren eerlijk wat het beste werkt. Soms is hybride nu slim en stap je later over.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Toekomstbestendig met R290</h2>
      <p>We werken met warmtepompen op <strong>R290 (propaan)</strong>, een natuurlijk koudemiddel. Het broeikaseffect daarvan (GWP) is ongeveer <strong>3</strong>, tegenover zo'n 675 voor R32 en ruim 2000 voor het oudere R410A. Bovendien worden synthetische koudemiddelen in Europa steeds verder beperkt, dus met R290 zit je ook op de lange termijn goed.</p>
      <p>R290 haalt daarnaast hoge aanvoertemperaturen, wat handig is als je bestaande radiatoren wilt blijven gebruiken.</p>
    </div>
  </section>

  <section class="gw__klus">
    <div class="container">
      <span class="label">Ons werk</span>
      <h2>In de praktijk</h2>
      <p class="cs__hint">Swipe door onze projecten · tik voor het verhaal</p>
    </div>
    <div class="cs" id="cs">
      {cases.map((c, i) => (
        <article class="sl" data-i={i}>
          <div class="sl__beeld">
            <img class="sl__groot" src={c.groot.src} alt={c.groot.alt} loading={i > 1 ? 'lazy' : undefined} draggable="false" />
            <span class:list={['pill', 'pill--' + c.soort]}>{soortLabel[c.soort]}</span>
            <div class="sl__klein"><img src={c.klein.src} alt={c.klein.alt} loading="lazy" draggable="false" /></div>
            <span class="sl__tik">Tik voor info</span>
            <div class="sl__info">
              <b>{c.titel}</b>
              <p class="meta">📍 {c.plaats} · {c.jaar}</p>
              <p>{c.info}</p>
              {c.quote && <blockquote>“{c.quote.tekst}”<cite>— {c.quote.naam}</cite></blockquote>}
              <a class="cta" href="/offerte/">Ook zoiets? →</a>
            </div>
          </div>
          <div class="sl__onder"><b>{c.titel}</b><small>📍 {c.plaats}</small></div>
        </article>
      ))}
    </div>
    <div class="container cs__nav">
      <span class="cs__tel"><b>1</b> / {cases.length}</span>
      <div class="cs__bar"><i></i></div>
      <button class="cs__pijl" data-d="-1" aria-label="Vorige">‹</button>
      <button class="cs__pijl" data-d="1" aria-label="Volgende">›</button>
    </div>
  </section>
  <script>
    const rail = document.getElementById('cs')!;
    const sl = [...rail.querySelectorAll<HTMLElement>('.sl')];
    const tel = document.querySelector('.cs__tel b')!, bar = document.querySelector<HTMLElement>('.cs__bar i')!;
    let cur = 0;
    const idx = () => Math.round(rail.scrollLeft / (sl[0].offsetWidth + 14));
    const upd = () => { const i = Math.min(sl.length - 1, idx()); if (i !== cur) { sl[cur].classList.remove('open'); cur = i; }
      tel.textContent = String(i + 1); bar.style.width = ((i + 1) / sl.length * 100) + '%'; };
    rail.addEventListener('scroll', upd, { passive: true });
    sl.forEach((s, i) => s.querySelector('.sl__beeld')!.addEventListener('click', e => {
      if ((e.target as HTMLElement).closest('a')) return;
      if (i !== cur) { rail.scrollTo({ left: s.offsetLeft - rail.offsetLeft - 16, behavior: 'smooth' }); return; }
      s.classList.toggle('open');
    }));
    document.querySelectorAll<HTMLElement>('.cs__pijl').forEach(b => b.addEventListener('click', () => {
      const t = sl[Math.max(0, Math.min(sl.length - 1, cur + +b.dataset.d!))]; rail.scrollTo({ left: t.offsetLeft - rail.offsetLeft - 16, behavior: 'smooth' }); }));
    upd();
  </script>

  <section class="section gw__belofte">
    <div class="container narrow">
      <h2>Onze belofte</h2>
      <p>We ontwerpen je systeem op lage temperatuur en regelen het waterzijdig in. Zo zorgen we ervoor dat je huis comfortabel warm wordt én dat de warmtepomp zo zuinig mogelijk draait. Daar staan we voor.</p>
      <div class="gw__knoppen">
        <Button href="/offerte/">Vraag gratis advies aan</Button>
        <a class="gw__link" href="/warmtepompen/">Bekijk warmtepompen →</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .gw__kaarten, .gw__keuze { display: grid; gap: 12px; margin: 20px 0; }
  .gw__kaart { background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 6px 20px -12px rgba(20,25,45,.3); }
  .gw__kaart h3 { margin: 0 0 6px; }
  .gw__kaart p { margin: 0; }
  .gw__alt { background: #EEF0F5; }
  .gw__pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; margin-bottom: 8px; }
  .gw__belofte { background: var(--navy); color: #fff; }
  .gw__belofte h2 { color: #fff; }
  .gw__belofte p { color: #C9CFDA; }
  .gw__knoppen { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .gw__link { color: #fff; font-weight: 700; text-decoration: none; }
  @media (min-width: 760px) { .gw__kaarten { grid-template-columns: repeat(3,1fr); } .gw__keuze { grid-template-columns: 1fr 1fr; } }
  .gw__klus { background: var(--navy); color: #fff; padding: 56px 0 48px; overflow: hidden; }
  .gw__klus h2 { color: #fff; margin-top: 4px; }
  .gw__klus .label { color: #FF8A95; }
  .cs__hint { color: #9AA3B5; font-size: .9rem; margin: 0 0 22px; }
  .cs { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 16px 8px; scroll-padding: 0 16px; scrollbar-width: none; }
  .cs::-webkit-scrollbar { display: none; }
  .sl { flex: 0 0 84%; max-width: 420px; scroll-snap-align: start; }
  .sl__beeld { position: relative; aspect-ratio: 4 / 5; cursor: pointer; }
  .sl__groot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%); border-radius: 0 0 14px 14px; pointer-events: none; }
  .sl .pill { position: absolute; right: 12px; top: 18px; z-index: 2; }
  .sl__klein { position: absolute; left: 10px; bottom: 14px; width: 46%; background: #fff; padding: 5px; border-radius: 10px; box-shadow: 0 18px 36px -10px rgba(0,0,0,.6); transform: rotate(-4deg); transition: transform .45s cubic-bezier(.3,1.4,.5,1), opacity .3s; z-index: 2; }
  .sl__klein img { display: block; width: 100%; aspect-ratio: 1.15; object-fit: cover; border-radius: 7px; pointer-events: none; }
  .sl__tik { position: absolute; right: 12px; bottom: 14px; z-index: 2; font-size: .72rem; font-weight: 700; color: #fff; background: rgba(10,14,30,.55); backdrop-filter: blur(6px); padding: 5px 10px; border-radius: 999px; transition: opacity .3s; }
  .sl__info { position: absolute; inset: 8% 0 0; z-index: 3; background: rgba(15,20,38,.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-radius: 0 0 14px 14px; padding: 22px 18px; overflow-y: auto; transform: translateY(102%); opacity: 0; transition: transform .45s cubic-bezier(.2,.9,.2,1), opacity .3s; clip-path: polygon(0 4%, 100% 0, 100% 100%, 0 100%); padding-top: 34px; }
  .sl.open .sl__info { transform: none; opacity: 1; }
  .sl.open .sl__klein { transform: rotate(-12deg) translate(-30%, 40%) scale(.6); opacity: 0; }
  .sl.open .sl__tik { opacity: 0; }
  .sl__info b { font-size: 1.15rem; display: block; }
  .sl__info .meta { color: #9AA3B5; margin: 2px 0 12px; font-size: .85rem; }
  .sl__info p { color: #DDE2EC; font-size: .92rem; margin: 0 0 12px; }
  .sl__info blockquote { margin: 0 0 12px; padding: 8px 12px; border-left: 3px solid var(--red); background: rgba(255,255,255,.07); border-radius: 0 8px 8px 0; font-style: italic; font-size: .9rem; }
  .sl__info cite { display: block; font-style: normal; font-weight: 700; font-size: .78rem; margin-top: 4px; color: #9AA3B5; }
  .sl__onder { padding: 12px 2px 0; } .sl__onder b { display: block; } .sl__onder small { color: #9AA3B5; }
  .pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; }
  .pill--klant { background: #1E9E6A; } .pill--groot { background: #3B4A7A; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; } .chips span { font-size: .75rem; font-weight: 700; background: rgba(255,255,255,.12); color: #fff; padding: 3px 9px; border-radius: 999px; }
  .cta { display: inline-block; margin-top: 14px; background: var(--red); color: #fff; font-weight: 700; padding: 9px 14px; border-radius: 10px; text-decoration: none; font-size: .9rem; }
  .cs__nav { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
  .cs__tel { font-weight: 700; font-size: .9rem; color: #9AA3B5; white-space: nowrap; } .cs__tel b { color: #fff; }
  .cs__bar { flex: 1; height: 3px; background: rgba(255,255,255,.15); border-radius: 2px; } .cs__bar i { display: block; height: 100%; background: var(--red); border-radius: 2px; transition: width .3s; }
  .cs__pijl { width: 40px; height: 40px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,.4); background: none; color: #fff; font-size: 1.4rem; line-height: 1; cursor: pointer; }
</style>
