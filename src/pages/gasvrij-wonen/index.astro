---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import { cases, soortLabel } from '../../data/projecten';
const soorten = [...new Set(cases.map(c => c.soort))];
const redenen = [
  { t: 'Meer comfort', p: 'Een warmtepomp verwarmt rustig en gelijkmatig op lage temperatuur. Geen koude hoeken en geen pieken: het hele huis blijft constant op temperatuur. Dat merken onze klanten na de overstap het meest.' },
  { t: 'Lagere energierekening', p: 'Een goed ontworpen warmtepomp haalt het grootste deel van zijn warmte gratis uit de buitenlucht. Je betaalt alleen de stroom om die warmte binnen te brengen, en je bent minder afhankelijk van de gasprijs.' },
  { t: 'Beter voor het milieu', p: 'Je verbrandt thuis geen gas meer en stoot dus geen CO₂ uit bij het verwarmen. Met stroom van zonnepanelen of groene stroom wordt de winst nog groter.' },
];
---
<Base title="Gasvrij of hybride wonen – De Klimaatheld" description="Advies over gasvrij of hybride wonen: meer comfort, lagere kosten en beter voor het milieu.">
  <PageHero label="Advies" title="Gasvrij of hybride wonen" lead="Wij staan achter onze warmtepompen en helpen je stap voor stap van het gas af. Met een systeem dat écht bij je huis past." />

  <section class="section">
    <div class="container narrow">
      <h2>Waarom van het gas af?</h2>
      <div class="gw__kaarten">
        {redenen.map(r => (<div class="gw__kaart"><h3>{r.t}</h3><p>{r.p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section gw__alt">
    <div class="container narrow">
      <h2>Hybride of all-electric?</h2>
      <div class="gw__keuze">
        <div class="gw__kaart">
          <span class="gw__pill">Hybride</span>
          <h3>De eerste stap</h3>
          <p>De warmtepomp doet het grootste deel van het werk; je cv-ketel springt alleen bij op de koudste dagen en voor warm tapwater. Ideaal als je huis nog niet volledig geïsoleerd is of als je het geleidelijk wilt doen.</p>
        </div>
        <div class="gw__kaart">
          <span class="gw__pill">All-electric</span>
          <h3>Helemaal gasvrij</h3>
          <p>De warmtepomp verzorgt alle verwarming én warm tapwater via een boiler. Geen gasaansluiting meer nodig, dus ook geen vastrecht voor gas. Past het best bij een redelijk geïsoleerd huis.</p>
        </div>
      </div>
      <p>Twijfel je? We kijken samen naar je woning, isolatie en afgiftesysteem en adviseren eerlijk wat het beste werkt. Soms is hybride nu slim en stap je later over.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Toekomstbestendig met R290</h2>
      <p>We werken met warmtepompen op <strong>R290 (propaan)</strong>, een natuurlijk koudemiddel. Het broeikaseffect daarvan (GWP) is ongeveer <strong>3</strong>, tegenover zo'n 675 voor R32 en ruim 2000 voor het oudere R410A. Bovendien worden synthetische koudemiddelen in Europa steeds verder beperkt, dus met R290 zit je ook op de lange termijn goed.</p>
      <p>R290 haalt daarnaast hoge aanvoertemperaturen, wat handig is als je bestaande radiatoren wilt blijven gebruiken.</p>
    </div>
  </section>

  <section class="section gw__klus">
    <div class="container">
      <h2>Ons werk in de praktijk</h2>
      <p class="cs__hint">Swipe door onze cases · tik voor het hele verhaal</p>
      <div class="cs__filter" role="tablist">
        <button class="on" data-f="alle">Alles</button>
        {soorten.map(s => <button data-f={s}>{({ klant: 'Klantverhalen', project: 'Projecten', groot: 'Grote projecten' })[s]}</button>)}
      </div>
    </div>
    <div class="cs" id="cs">
      {cases.map(c => (
        <article class="k" data-s={c.soort}>
          {c.fotos.map((f, i) => <img class:list={['k__foto', { on: i === 0 }]} src={f.src} alt={f.alt} draggable="false" loading={i ? 'lazy' : undefined} />)}
          {c.fotos.length > 1 && <span class="k__tel"><span>1</span>/{c.fotos.length}</span>}
          <div class="k__la">
            <span class:list={['pill', 'pill--' + c.soort]}>{soortLabel[c.soort]}</span>
            <b>{c.titel}</b>
            <p class="meta">📍 {c.plaats} · {c.jaar}</p>
            <div class="k__meer">
              {c.fotos.length > 1 && <div class="k__thumbs">{c.fotos.map((f, i) => <button type="button" class:list={{ on: i === 0 }} data-n={i} style={`background-image:url(${f.src})`} aria-label={`Foto ${i + 1}`} />)}</div>}
              <p>{c.info}</p>
              {c.quote && <blockquote>“{c.quote.tekst}”<cite>— {c.quote.naam}</cite></blockquote>}
              <div class="chips">{c.punten.map(p => <span>{p}</span>)}</div>
              <a class="cta" href="/offerte/">Ook zoiets? →</a>
            </div>
            <span class="k__pijl" aria-hidden="true">⌃</span>
          </div>
        </article>
      ))}
    </div>
    <div class="mini">{cases.map(c => <i data-s={c.soort} style={`background-image:url(${c.fotos[0].src})`} />)}</div>
  </section>
  <script>
    const root = document.getElementById('cs')!;
    const all = [...root.querySelectorAll<HTMLElement>('.k')];
    const allMini = [...document.querySelectorAll<HTMLElement>('.mini i')];
    let ks = all, mini = allMini, pos = 0, start = 0, x0 = 0, moved = 0, down = false, anim = 0;
    const draw = () => {
      ks.forEach((k, i) => { const d = i - pos, a = Math.max(-1, Math.min(1, d));
        k.style.transform = `translateX(${d * 72}%) scale(${1 - Math.min(1, Math.abs(d)) * .14}) rotateY(${-a * 18}deg)`;
        k.style.zIndex = String(100 - Math.round(Math.abs(d) * 10)); k.style.opacity = String(Math.max(0, 1 - Math.abs(d) * .4));
        if (Math.abs(d) > .5) k.classList.remove('open'); });
      const c = Math.round(pos); mini.forEach((m, i) => m.classList.toggle('on', i === c));
    };
    const snap = (t: number) => { cancelAnimationFrame(anim); t = Math.max(0, Math.min(ks.length - 1, t)); const f = pos, t0 = performance.now();
      const st = (n: number) => { const p = Math.min(1, (n - t0) / 380), e = 1 - Math.pow(1 - p, 3); pos = f + (t - f) * e; draw(); if (p < 1) anim = requestAnimationFrame(st); }; anim = requestAnimationFrame(st); };
    root.addEventListener('pointerdown', e => { if ((e.target as HTMLElement).closest('a')) return; down = true; x0 = e.clientX; start = pos; moved = 0; cancelAnimationFrame(anim); root.setPointerCapture(e.pointerId); });
    root.addEventListener('pointermove', e => { if (!down) return; const dx = e.clientX - x0; moved = Math.max(moved, Math.abs(dx)); pos = Math.max(-.4, Math.min(ks.length - .6, start - dx / (root.clientWidth * .5))); draw(); });
    root.addEventListener('pointerup', e => { if (!down) return; down = false;
      if (moved < 6) { const el = document.elementsFromPoint(e.clientX, e.clientY).find(x => x.classList?.contains('k')) as HTMLElement; const i = ks.indexOf(el);
        if (i < 0) return; if (i !== Math.round(pos)) { snap(i); return; }
        const t = (e.target as HTMLElement), th = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement;
        if (th?.matches('.k__thumbs button')) { toon(el, +th.dataset.n!); return; }
        if (el.classList.contains('open') && !th?.closest('.k__la')) { toon(el, (+(el.dataset.n || 0) + 1) % el.querySelectorAll('.k__foto').length); return; }
        el.classList.toggle('open'); return; }
      const dx = e.clientX - x0; snap(Math.abs(dx) > 30 && Math.round(pos) === Math.round(start) ? start + (dx < 0 ? 1 : -1) : Math.round(pos)); });
    function toon(k: HTMLElement, n: number) {
      k.dataset.n = String(n);
      k.querySelectorAll('.k__foto').forEach((f, i) => f.classList.toggle('on', i === n));
      k.querySelectorAll('.k__thumbs button').forEach((f, i) => f.classList.toggle('on', i === n));
      const t = k.querySelector('.k__tel span'); if (t) t.textContent = String(n + 1);
    }
    allMini.forEach(m => m.addEventListener('click', () => snap(mini.indexOf(m))));
    document.querySelectorAll<HTMLElement>('.cs__filter button').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('.cs__filter button').forEach(x => x.classList.toggle('on', x === b));
      const f = b.dataset.f; ks = all.filter(k => f === 'alle' || k.dataset.s === f); mini = allMini.filter(m => f === 'alle' || m.dataset.s === f);
      all.forEach(k => { const v = ks.includes(k); k.style.display = v ? '' : 'none'; }); allMini.forEach(m => m.style.display = mini.includes(m) ? '' : 'none');
      pos = 0; draw();
    }));
    draw();
  </script>

  <section class="section gw__belofte">
    <div class="container narrow">
      <h2>Onze belofte</h2>
      <p>We ontwerpen je systeem op lage temperatuur en regelen het waterzijdig in. Zo zorgen we ervoor dat je huis comfortabel warm wordt én dat de warmtepomp zo zuinig mogelijk draait. Daar staan we voor.</p>
      <div class="gw__knoppen">
        <Button href="/offerte/">Vraag gratis advies aan</Button>
        <a class="gw__link" href="/warmtepompen/">Bekijk warmtepompen →</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .gw__kaarten, .gw__keuze { display: grid; gap: 12px; margin: 20px 0; }
  .gw__kaart { background: #fff; border-radius: 12px; padding: 18px; box-shadow: 0 6px 20px -12px rgba(20,25,45,.3); }
  .gw__kaart h3 { margin: 0 0 6px; }
  .gw__kaart p { margin: 0; }
  .gw__alt { background: #EEF0F5; }
  .gw__pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; margin-bottom: 8px; }
  .gw__belofte { background: var(--navy); color: #fff; }
  .gw__belofte h2 { color: #fff; }
  .gw__belofte p { color: #C9CFDA; }
  .gw__knoppen { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .gw__link { color: #fff; font-weight: 700; text-decoration: none; }
  @media (min-width: 760px) { .gw__kaarten { grid-template-columns: repeat(3,1fr); } .gw__keuze { grid-template-columns: 1fr 1fr; } }
  .gw__klus { overflow: hidden; }
  .cs__hint { color: #778; font-size: .9rem; margin: 0 0 14px; }
  .cs__filter { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 -16px 22px; padding: 0 16px; }
  .cs__filter button { flex: none; border: 1.5px solid #D5D9E3; background: #fff; color: var(--navy); font: inherit; font-size: .85rem; font-weight: 700; padding: 7px 14px; border-radius: 999px; cursor: pointer; }
  .cs__filter button.on { background: var(--navy); border-color: var(--navy); color: #fff; }
  .cs { position: relative; height: 440px; perspective: 1000px; touch-action: pan-y; user-select: none; cursor: grab; }
  .cs > .k { position: absolute; left: 50%; top: 0; width: min(78%, 380px); margin-left: calc(min(78%, 380px) / -2); height: 100%; border-radius: 18px; overflow: hidden; background: #ddd; box-shadow: 0 25px 45px -25px rgba(10,14,30,.6); }
  .cs .k__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; opacity: 0; transition: opacity .35s; }
  .cs .k__foto.on { opacity: 1; }
  .k__tel { position: absolute; right: 12px; top: 12px; z-index: 2; font-size: .72rem; font-weight: 700; color: #fff; background: rgba(10,14,30,.55); backdrop-filter: blur(6px); padding: 3px 9px; border-radius: 999px; }
  .k__tel::before { content: '📷 '; }
  .k__thumbs { display: flex; gap: 6px; margin: 12px 0 4px; overflow-x: auto; scrollbar-width: none; }
  .k__thumbs button { flex: none; width: 52px; height: 52px; border-radius: 8px; border: 2px solid transparent; background-size: cover; background-position: center; opacity: .55; cursor: pointer; padding: 0; transition: .2s; }
  .k__thumbs button.on { opacity: 1; border-color: var(--red); }
  .k__la { position: absolute; left: 10px; right: 10px; bottom: 10px; background: rgba(255,255,255,.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 14px; padding: 12px 14px; z-index: 2; max-height: calc(100% - 20px); overflow-y: auto; }
  .k__la b { display: block; margin-top: 6px; font-size: 1.02rem; padding-right: 30px; }
  .k__la .meta { margin: 0; color: #667; font-size: .85rem; }
  .pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; }
  .pill--klant { background: #1E9E6A; } .pill--groot { background: var(--navy); }
  .k__meer { max-height: 0; overflow: hidden; opacity: 0; transition: max-height .45s, opacity .3s; }
  .k.open .k__meer { max-height: 420px; opacity: 1; }
  .k__meer p { margin: 10px 0 8px; font-size: .9rem; }
  .k__meer blockquote { margin: 0 0 10px; padding: 8px 12px; border-left: 3px solid var(--red); background: rgba(255,255,255,.7); border-radius: 0 8px 8px 0; font-style: italic; font-size: .9rem; }
  .k__meer cite { display: block; font-style: normal; font-weight: 700; font-size: .78rem; margin-top: 4px; color: #556; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; } .chips span { font-size: .75rem; font-weight: 700; background: var(--navy); color: #fff; padding: 3px 9px; border-radius: 999px; }
  .cta { display: inline-block; margin-top: 12px; background: var(--red); color: #fff; font-weight: 700; padding: 8px 14px; border-radius: 10px; text-decoration: none; font-size: .9rem; }
  .k__pijl { position: absolute; right: 12px; top: 10px; width: 28px; height: 28px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 900; transition: .3s; }
  .k.open .k__pijl { transform: rotate(180deg); }
  .mini { display: flex; justify-content: center; gap: 6px; margin-top: 16px; }
  .mini i { width: 34px; height: 34px; border-radius: 8px; background-size: cover; background-position: center; opacity: .4; transition: .25s; cursor: pointer; }
  .mini i.on { opacity: 1; outline: 2px solid var(--red); outline-offset: 2px; transform: translateY(-3px); }
</style>
