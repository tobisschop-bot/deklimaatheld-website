---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import CasesCarrousel from '../../components/CasesCarrousel.astro';
import Faq from '../../components/Faq.astro';

const routes = [
  { pill: 'Hybride', t: 'De eerste stap', p: 'De warmtepomp doet het grootste deel van het werk; je cv-ketel springt alleen bij op de koudste dagen. Ideaal als je huis nog niet volledig geïsoleerd is of als je het geleidelijk wilt doen.' },
  { pill: 'All-electric', t: 'Helemaal van het gas af', p: 'De warmtepomp verzorgt alle verwarming én warm tapwater via een boiler. Geen gasaansluiting meer, dus ook geen vastrecht voor gas. Past het best bij een redelijk geïsoleerd huis.' },
  { pill: 'Zon & batterij', t: 'Zelf opwekken en opslaan', p: 'Zonnepanelen met een thuisbatterij, zo nodig met een meterkast naar drie fasen. Je gebruikt meer van je eigen stroom, ook voor je warmtepomp of airco.' },
];
const redenen = [
  { t: 'Meer comfort', p: 'Rustig en gelijkmatig warm op lage temperatuur. Geen koude hoeken, geen pieken.' },
  { t: 'Lagere energierekening', p: 'Het grootste deel van de warmte komt gratis uit de buitenlucht. Je bent minder afhankelijk van de gasprijs.' },
  { t: 'Beter voor het milieu', p: 'Thuis geen gas meer verbranden. Met zonnestroom of groene stroom wordt de winst nog groter.' },
];
const vragen = [
  { q: 'Past een warmtepomp bij mijn huis?', a: 'Dat hangt af van je isolatie, je radiatoren of vloerverwarming en je meterkast. We kijken er samen naar en adviseren eerlijk wat werkt. Soms is hybride nu slim en stap je later over op all-electric.' },
  { q: 'Wat is R290 en waarom kiezen jullie ervoor?', a: "R290 (propaan) is een natuurlijk koudemiddel met een broeikaseffect (GWP) van ongeveer 3, tegenover zo'n 675 voor R32 en ruim 2000 voor het oudere R410A. Synthetische koudemiddelen worden in Europa steeds verder beperkt, dus met R290 zit je ook op de lange termijn goed. Het haalt bovendien hoge aanvoertemperaturen, handig als je je bestaande radiatoren wilt houden." },
  { q: 'Wat kost het?', a: 'Dat verschilt per woning en per systeem. Na de gratis check krijg je een offerte op maat. De ISDE-subsidie regelen wij voor je, en met de Energiebespaarlening kun je de rest gespreid betalen.' },
];
---
<Base title="Ons werk & verduurzamen – De Klimaatheld" description="Bekijk ons werk en ontdek welke route naar duurzaam wonen bij jouw huis past: hybride, all-electric of zon en batterij.">
  <PageHero label="Ons werk" title="Ons werk & verduurzamen" lead="Bekijk wat we bij anderen deden en ontdek welke route bij jouw huis past." />

  <CasesCarrousel id="ons-werk" label="Projecten" title="In de praktijk" />

  <section class="section gw__wit" id="routes">
    <div class="container narrow">
      <span class="label">Jouw huis</span>
      <h2>Welke route past bij jou?</h2>
      <div class="gw__routes">
        {routes.map(r => (<div class="gw__route"><span class="gw__pill">{r.pill}</span><h3>{r.t}</h3><p>{r.p}</p></div>))}
      </div>
      <p class="gw__hint">Twijfel je? We kijken samen naar je woning en adviseren eerlijk wat het beste werkt.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <span class="label">Waarom verduurzamen</span>
      <h2>Drie voordelen</h2>
      <div class="gw__kaarten">
        {redenen.map(r => (<div class="gw__kaart"><h3>{r.t}</h3><p>{r.p}</p></div>))}
      </div>
    </div>
  </section>

  <section class="section gw__wit">
    <div class="container narrow">
      <span class="label">Goed om te weten</span>
      <Faq title="Vragen" items={vragen} />
    </div>
  </section>

  <section class="section gw__belofte">
    <div class="container narrow">
      <h2>Onze belofte</h2>
      <p>We ontwerpen je systeem op lage temperatuur en regelen het waterzijdig in. Zo wordt je huis comfortabel warm én draait de warmtepomp zo zuinig mogelijk. Daar staan we voor.</p>
      <div class="gw__knoppen">
        <Button href="/offerte/">Vraag gratis advies aan</Button>
        <a class="gw__link" href="/warmtepompen/">Bekijk warmtepompen →</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .gw__wit { background: #fff; }
  .gw__routes { display: grid; gap: 12px; margin: 18px 0 14px; }
  .gw__route { background: #fff; border: 1px solid var(--border); border-left: 4px solid var(--red); border-radius: 12px; padding: 16px; }
  .gw__route h3 { margin: 0 0 4px; }
  .gw__route p { margin: 0; color: var(--muted); font-size: .95rem; }
  .gw__pill { display: inline-block; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; margin-bottom: 8px; }
  .gw__hint { color: var(--muted); font-size: .95rem; margin: 0; }
  .gw__kaarten { display: grid; gap: 12px; margin: 18px 0 0; }
  .gw__kaart { background: #fff; border-radius: 12px; padding: 16px; box-shadow: 0 6px 20px -12px rgba(20,25,45,.3); }
  .gw__kaart h3 { margin: 0 0 4px; }
  .gw__kaart p { margin: 0; color: var(--muted); font-size: .95rem; }
  .gw__belofte { background: var(--navy); color: #fff; }
  .gw__belofte h2 { color: #fff; }
  .gw__belofte p { color: #C9CFDA; }
  .gw__knoppen { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 24px; }
  .gw__link { color: #fff; font-weight: 700; text-decoration: none; }
  @media (min-width: 760px) { .gw__routes, .gw__kaarten { grid-template-columns: repeat(3,1fr); } }
</style>
