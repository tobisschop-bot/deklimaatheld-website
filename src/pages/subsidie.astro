---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaCard from '../components/CtaCard.astro';
import { warmtepompen } from '../data/warmtepompen';

const stappen = [
  { t: 'Installatie door ons', d: 'Onze eigen monteurs plaatsen je warmtepomp en nemen hem in bedrijf.' },
  { t: 'Wij verzamelen factuur, betaalbewijs en foto’s', d: 'We zetten alle gegevens die RVO vraagt op een rij, inclusief de meldcode van je warmtepomp.' },
  { t: 'Wij dienen de aanvraag in bij RVO', d: 'Na de installatie dienen we de aanvraag namens jou in bij RVO.' },
  { t: 'Subsidie op jouw rekening', d: 'RVO beoordeelt de aanvraag. Na goedkeuring wordt de subsidie op jouw rekening gestort.' },
];

const voorwaarden = [
  'Je bent eigenaar én bewoner van de woning',
  'De warmtepomp wordt geïnstalleerd door een installateur',
  'De warmtepomp staat op de meldcodelijst van RVO',
  'Je dient de aanvraag in ná de installatie',
];

const faq = [
  { q: 'Moet ik de subsidie zelf voorschieten?', a: 'Ja. Je betaalt eerst de installatie. De ISDE-subsidie wordt achteraf door RVO uitgekeerd, nadat de aanvraag is goedgekeurd.' },
  { q: 'Kan ik subsidie krijgen voor een hybride warmtepomp?', a: 'Ja, zowel hybride als all-electric warmtepompen kunnen in aanmerking komen, zolang het type op de meldcodelijst van RVO staat.' },
  { q: 'Hoe lang duurt het voor ik het geld krijg?', a: 'Dat verschilt per aanvraag en hangt af van de behandeling door RVO. Kijk op rvo.nl voor de actuele behandeltermijnen.' },
  { q: 'Wat als mijn aanvraag wordt afgewezen?', a: 'We controleren vooraf of je warmtepomp op de meldcodelijst staat en of de gegevens compleet zijn. Komt er toch een vraag of afwijzing van RVO, dan kijken we samen met je wat de mogelijkheden zijn.' },
];
---
<Base title="ISDE-subsidie voor je warmtepomp – De Klimaatheld" description="Uitleg over de ISDE-subsidie voor warmtepompen. De Klimaatheld regelt de aanvraag bij RVO voor je.">
  <PageHero
    label="Subsidie"
    title="ISDE-subsidie: wij regelen het"
    lead="De overheid betaalt mee aan je warmtepomp. Wij doen de aanvraag voor je, jij hoeft niets uit te zoeken."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Subsidie' }]}
  />

  <!-- WAT IS ISDE -->
  <section class="section section--white">
    <div class="container">
      <span class="label">Wat is ISDE?</span>
      <h2>Subsidie voor duurzame warmte</h2>
      <p>De ISDE (Investeringssubsidie duurzame energie en energiebesparing) is een regeling van de overheid, uitgevoerd door RVO. Huiseigenaren die een warmtepomp laten installeren, kunnen hiermee een deel van de kosten terugkrijgen.</p>
      <p>Hoeveel je krijgt, hangt af van het type en vermogen van de warmtepomp. Actuele bedragen en voorwaarden vind je altijd op <a href="https://www.rvo.nl/subsidies-financiering/isde" target="_blank" rel="noopener">rvo.nl</a>.</p>
    </div>
  </section>

  <!-- BEDRAGEN -->
  <section class="section">
    <div class="container">
      <span class="label">Per model</span>
      <h2>Hoeveel subsidie krijg je?</h2>
      <ul class="card amounts">
        {warmtepompen.map((w) => (
          <li>
            <img src={w.img} alt={w.name} width="48" height="48" loading="lazy" />
            <div class="amounts__name">
              {w.page ? <a href={w.page}>{w.name}</a> : <span class="amounts__title">{w.name}</span>}
              <small>{w.tag}</small>
            </div>
            <strong class="amounts__value">€ [bedrag]</strong>
          </li>
        ))}
      </ul>
      <p class="note">Indicatief, zie de RVO-lijst. Het exacte bedrag hangt af van het type en vermogen.</p>
    </div>
  </section>

  <!-- ZO WERKT HET -->
  <section class="section section--white">
    <div class="container">
      <span class="label">Zo werkt het</span>
      <h2>Van montage tot geld op je rekening</h2>
      <ol class="timeline">
        {stappen.map((s, i) => (
          <li>
            <span class="timeline__nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- VOORWAARDEN -->
  <section class="section">
    <div class="container">
      <div class="card">
        <h2 class="card-title">Voorwaarden in het kort</h2>
        <ul class="checks">
          {voorwaarden.map((v) => <li>{v}</li>)}
        </ul>
        <p class="note">Dit is een samenvatting. De volledige en actuele voorwaarden staan op <a href="https://www.rvo.nl/subsidies-financiering/isde" target="_blank" rel="noopener">rvo.nl</a>.</p>
      </div>
    </div>
  </section>

  <!-- REKENVOORBEELD -->
  <section class="section section--white">
    <div class="container">
      <div class="card calc">
        <div class="calc__head">
          <h2 class="card-title">Rekenvoorbeeld</h2>
          <span class="calc__tag">Indicatief</span>
        </div>
        <dl>
          <div><dt>Prijs warmtepomp</dt><dd>€ [bedrag]</dd></div>
          <div class="calc__minus"><dt>ISDE-subsidie</dt><dd>– € [bedrag]</dd></div>
          <div class="calc__total"><dt>Jouw investering<small>Netto na ISDE-uitkering</small></dt><dd>€ [bedrag]</dd></div>
        </dl>
        <p class="note">Rekenvoorbeeld, bedragen volgen. Indicatief, zie de RVO-lijst.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <Faq title="Veelgestelde vragen over ISDE" items={faq} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--cta">
    <div class="container">
      <CtaCard
        title="Benieuwd wat jij terugkrijgt?"
        text="Laat ons vrijblijvend uitzoeken welke subsidie bij jouw woning en warmtepomp hoort."
        button="Vraag gratis advies aan →"
      />
    </div>
  </section>
</Base>

<style>
  .section--white { background: #fff; }
  .section--cta { padding-top: 0; }
  .section a:not(.btn) { color: var(--red); font-weight: 600; }
  .note { font-size: .85rem; color: var(--muted); margin: 12px 0 0; }
  .card-title { font-size: 1.4rem; margin-bottom: 14px; }

  .amounts { list-style: none; margin: 0; padding: 4px 16px; }
  .amounts li { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .amounts li:last-child { border-bottom: 0; }
  .amounts img { width: 48px; height: 48px; object-fit: contain; background: var(--bg); border-radius: 8px; padding: 4px; flex: 0 0 48px; }
  .amounts__name { display: grid; flex: 1; min-width: 0; }
  .section .amounts__name a, .amounts__title { color: var(--text); font-weight: 700; text-decoration: none; }
  .section .amounts__name a { text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; }
  .amounts__name small { color: var(--muted); font-size: .85rem; }
  .amounts__value { color: var(--green); font-size: 1.05rem; white-space: nowrap; }

  .timeline { list-style: none; margin: 20px 0 0; padding: 0; }
  .timeline li { position: relative; display: flex; gap: 14px; padding-bottom: 22px; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li:not(:last-child)::before { content: ''; position: absolute; left: 17px; top: 36px; bottom: 0; width: 2px; background: var(--border); }
  .timeline__nr { flex: 0 0 36px; height: 36px; border-radius: 50%; background: var(--red); color: #fff; font-weight: 800; font-size: .8rem; display: grid; place-items: center; }
  .timeline h3 { font-size: 1.1rem; margin: 6px 0 4px; }
  .timeline p { margin: 0; color: var(--muted); font-size: .95rem; }

  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .checks li { position: relative; padding-left: 30px; }
  .checks li::before { content: '✓'; position: absolute; left: 0; top: 1px; width: 20px; height: 20px; border-radius: 50%; background: var(--green-soft); color: var(--green); font-weight: 800; font-size: .75rem; display: grid; place-items: center; }

  .calc__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .calc__tag { background: var(--bg); color: var(--muted); font-size: .75rem; font-weight: 700; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; letter-spacing: .05em; }
  .calc dl { margin: 0; display: grid; gap: 10px; }
  .calc dl div { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); }
  .calc dd { margin: 0; font-weight: 700; color: var(--text); white-space: nowrap; }
  .calc .calc__minus, .calc .calc__minus dd { color: var(--green); }
  .calc .calc__total { border-top: 1px solid var(--border); padding-top: 12px; align-items: center; }
  .calc__total dt { display: grid; font-weight: 700; color: var(--text); }
  .calc__total small { font-weight: 400; color: var(--muted); font-size: .8rem; }
  .calc__total dd { font-size: 1.3rem; }
</style>
