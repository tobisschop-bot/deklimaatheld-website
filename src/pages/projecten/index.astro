---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
const fotos = [
  { src: '/img/werk-installatie-binnen.webp', alt: 'Weheat-installatie met boiler- en buffervat', tag: 'Binnen', groot: true },
  { src: '/img/werk-installatie-buiten.webp', alt: 'Weheat-buitenunit tegen de gevel', tag: 'Buiten' },
];
---
<Base title="Uitgevoerd werk – De Klimaatheld" description="Een greep uit de installaties die De Klimaatheld heeft geplaatst.">
  <PageHero label="Projecten" title="Uitgevoerd werk" lead="Een greep uit de warmtepompen, airco's en verwarmingssystemen die we hebben geplaatst." />
  <section class="section">
    <div class="container">
      <div class="col">
        {fotos.map(f => (
          <figure class:list={['col__item', { 'col__item--groot': f.groot }]}>
            <img src={f.src} alt={f.alt} loading="lazy" />
            <span class="col__tag">{f.tag}</span>
          </figure>
        ))}
      </div>
      <p class="col__meer">Binnenkort meer projecten.</p>
      <Button href="/offerte/">Vraag een offerte aan</Button>
    </div>
  </section>
</Base>
<style>
  .col { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .col__item { position: relative; margin: 0; border-radius: 10px; overflow: hidden; aspect-ratio: 1; }
  .col__item--groot { grid-column: span 2; aspect-ratio: 4 / 3; }
  .col__item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .col__tag { position: absolute; left: 10px; bottom: 10px; font-size: .72rem; font-weight: 700; color: #fff; background: var(--red); padding: 3px 10px; border-radius: 999px; }
  .col__meer { color: var(--muted, #667); margin: 20px 0; }
  @media (min-width: 760px) { .col { grid-template-columns: repeat(3, 1fr); } }
</style>
