---
import ProductImage from '../components/ProductImage.astro';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Besparingscheck from '../components/besparingscheck/Besparingscheck.astro';
import { warmtepompen, euro, kaartLink } from '../data/warmtepompen';

const stappen = [
  { n: '01', icon: '/icons/01-besparingscheck.svg', t: 'Besparingscheck', d: 'Je doet vrijblijvend de gratis online besparingscheck. Zo zie je direct hoeveel gas en euro’s je kunt besparen.' },
  { n: '02', icon: '/icons/02-installatiecheck.svg', t: 'Installatiecheck', d: 'We beoordelen je huidige verwarming, radiatoren en meterkast. Zo weet je precies welke warmtepomp bij jouw woning past.' },
  { n: '03', icon: '/icons/03-installatieplan.svg', t: 'Installatieplan', d: 'We maken een technisch installatieplan op maat en bespreken alle details via videocall of bij je thuis.' },
  { n: '04', icon: '/icons/04-installatie.svg', t: 'Vakkundige installatie', d: 'Onze eigen monteurs plaatsen en regelen je hybride of all-electric warmtepomp in, meestal binnen één tot twee dagen.' },
  { n: '05', icon: '/icons/05-subsidie-nazorg.svg', t: 'Subsidie & nazorg', d: 'Wij regelen de ISDE-subsidieaanvraag en blijven bereikbaar voor onderhoud en service.' },
];
---
<Base title="De Klimaatheld – Zorgeloos duurzaam verwarmen in Den Haag">
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="hero__chip">🔥 Direct energiekosten verlagen</span>
        <h1>Duizenden euro’s besparen op je energierekening?</h1>
        <p class="hero__lead">Kies voor een duurzame warmtepomp, inclusief vakkundige installatie en de ISDE-subsidie voor je geregeld.</p>
      </div>
      <div id="besparingscheck"><Besparingscheck /></div>
    </div>
    <div class="hero__flight" aria-hidden="true">
      <!-- Kleine actiestreepjes (stripstijl) bij de benen, in zijn vliegrichting -->
      <svg class="hero__zoef" viewBox="0 0 260 220">
        <g stroke-linecap="round" fill="none">
          <path d="M126 160 l-16 12" stroke="#D6283A" stroke-opacity=".75" stroke-width="3" />
          <path d="M148 178 l-12 10" stroke="#D6283A" stroke-opacity=".6" stroke-width="3" />
          <path d="M112 186 l-9 7" stroke="#D6283A" stroke-opacity=".45" stroke-width="2.5" />
        </g>
      </svg>
      <span class="hero__gloed"></span>
      <img class="hero__mascotte" src="/img/mascotte.webp" alt="" width="640" height="620" loading="eager" decoding="async" />
    </div>
  </section>

  <!-- COP -->
  <section class="section section--white">
    <div class="container grid grid-2 cop">
      <div>
        <span class="label">Meer rendement</span>
        <h2>Hogere COP bij elke installatie</h2>
        <p class="lead">Als De Klimaatheld × Heat Geek ontwerpen we je systeem op lage temperatuur en regelen we het waterzijdig in. Daardoor haalt je warmtepomp meer warmte uit elke kWh.</p>
      </div>
      <div class="card">
        <svg viewBox="0 -26 310 226" role="img" aria-label="Grafiek: COP van De Klimaatheld hoger dan standaard installateur" font-family="Archivo,sans-serif" font-size="10" fill="#5A6475"><path d="M40 160H300M40 125H300M40 90H300M40 55H300M40 20H300" stroke="#E3E7ED"/><text x="32" y="164" text-anchor="end">2</text><text x="32" y="129" text-anchor="end">3</text><text x="32" y="94" text-anchor="end">4</text><text x="32" y="59" text-anchor="end">5</text><text x="32" y="24" text-anchor="end">6</text><text x="40" y="178" text-anchor="middle">-10°</text><text x="92" y="178" text-anchor="middle">-5°</text><text x="144" y="178" text-anchor="middle">0°</text><text x="196" y="178" text-anchor="middle">5°</text><text x="248" y="178" text-anchor="middle">10°</text><text x="300" y="178" text-anchor="middle">15°</text><polygon points="40,132 92,111 144,90 196,69 248,52 300,38 300,94 248,104 196,118 144,132 92,146 40,160" fill="#D6283A" opacity=".08"/><polyline points="40,160 92,146 144,132 196,118 248,104 300,94" fill="none" stroke="#9AA3B2" stroke-width="2.5" stroke-dasharray="5 4" stroke-linecap="round"/><polyline points="40,132 92,111 144,90 196,69 248,52 300,38" fill="none" stroke="#D6283A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="300" cy="38" r="4.5" fill="#D6283A" stroke="#fff" stroke-width="2"/><g class="cop__held" transform="rotate(8 278 24)"><image href="/img/kh-held.webp" x="260" y="6" width="36" height="34"/></g><text x="40" y="196">Buitentemperatuur</text><text x="40" y="10">COP</text></svg>
        <div class="legend"><span><i class="l-red"></i>De Klimaatheld × Heat Geek</span><span><i class="l-grey"></i>Standaard installateur</span></div>
        <p class="note">Indicatief. Werkelijke COP hangt af van woning en systeem.</p>
      </div>
    </div>
  </section>

  <!-- ZORGELOOS -->
  <section class="section">
    <div class="container narrow">
      <h2>Zorgeloos verduurzamen</h2>
      <p class="lead">De Klimaatheld doet meer dan alleen een warmtepomp installeren. We ontzorgen je van A tot Z.</p>
      <p>We begeleiden je bij het hele traject: van isolatieadvies tot het aanvragen van de ISDE-subsidie. Is je woning nog niet goed genoeg geïsoleerd? Dan stippelen we samen het juiste traject uit.</p>
      <Button href="#besparingscheck">Doe de besparingscheck</Button>
    </div>
  </section>

  <!-- STAPPEN -->
  <section class="section section--white">
    <div class="container">
      <span class="label">Helder & transparant</span>
      <h2>Zo werkt De Klimaatheld</h2>
      <p class="lead">In vijf stappen naar een zorgeloze en duurzame woning.</p>
      <ol class="steps">
        {stappen.map((s) => (
          <li class="card step">
            <div class="step__icon"><span>{s.n}</span><img src={s.icon} alt="" width="80" height="80" loading="lazy" /></div>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- WARMTEPOMPEN -->
  <section class="section">
    <div class="container">
      <span class="label">Onze warmtepompen</span>
      <h2>Weheat, Vaillant, Daikin en Haier</h2>
      <div class="grid grid-3">
        {warmtepompen.map((w) => (
          <a class="card pump" href={kaartLink(w).href}>
            <div class="pump__img"><ProductImage src={w.img} alt={w.name} class="pump__pi" /></div>
            <span class="pump__tag">{w.tag}</span>
            <h3>{w.name}</h3>
            <p class="pump__price">{w.from == null ? <strong>Prijs op aanvraag</strong> : <>v.a. <strong>{euro(w.from)}</strong> <small>indicatief</small></>}</p>
            <span class="pump__link">{w.page ? 'Stel samen' : kaartLink(w).label} →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><Button href="/warmtepompen/" variant="outline">Alle warmtepompen</Button></p>
    </div>
  </section>

  <!-- GASVRIJ / HYBRIDE -->
  <section class="section section--white">
    <div class="container narrow">
      <span class="label">Comfortabel wonen</span>
      <h2>Gasvrij of hybride wonen</h2>
      <p>Met de hoge en wisselende gasprijzen is overstappen financieel slim. Je verlaagt direct je maandelijkse energiekosten, waardoor je de installatie sneller terugverdient.</p>
      <p>Een warmtepomp haalt warmte uit de buitenlucht en geeft hetzelfde comfort als een cv-ketel: een warm huis en warm tapwater, zonder gas te verbranden.</p>
    </div>
  </section>

  <!-- ISDE + LENING -->
  <section class="section">
    <div class="container grid grid-2">
      <div class="card feature">
        <span class="badge">Voordeel van de overheid</span>
        <h3>Maak gebruik van de ISDE-subsidie</h3>
        <p>De overheid geeft subsidie aan huiseigenaren die een warmtepomp laten installeren. Hoeveel je krijgt hangt af van het type en vermogen.</p>
        <p>Geen zin in papierwerk? De Klimaatheld verzorgt de volledige subsidieaanvraag voor je.</p>
        <a class="more" href="/subsidie/">Meer over de ISDE-subsidie →</a>
      </div>
      <div class="card feature">
        <span class="badge">Lage rente</span>
        <h3>Energiebespaarlening</h3>
        <p>Met de Energiebespaarlening van het Nationaal Warmtefonds financier je je warmtepomp tegen een lage rente. Bij een lager inkomen kan dat zelfs tegen 0% rente.</p>
        <p>Zo betaal je de lening af met wat je maandelijks bespaart op je gasrekening. Bekijk de actuele voorwaarden op warmtefonds.nl.</p>
        <a class="more" href="https://www.warmtefonds.nl" rel="noopener" target="_blank">Check financieringsopties →</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final">
    <div class="container final__grid">
      <div>
        <span class="label">Klaar voor de volgende stap?</span>
        <h2>Start jouw besparing vandaag</h2>
        <ul class="checks">
          <li>Gratis advies van specialisten</li>
          <li>Eigen monteurs, geen onderaannemers</li>
          <li>ISDE-subsidie voor je geregeld</li>
        </ul>
      </div>
      <div><Button href="#besparingscheck" variant="light">Doe de besparingscheck →</Button></div>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }
  .section--white { background: #fff; }

  .hero { background: radial-gradient(120% 80% at 100% 0%, rgba(214,40,58,.35) 0%, transparent 55%), linear-gradient(165deg, #0B132B 0%, var(--navy) 55%, #1A1A1A 100%); color: #fff; padding: 48px 0 64px; }
  .hero h1 { color: #fff; }
  /* Mascotte: vliegt vanaf de overgang naar wit omhoog, rechtsonder in de hero */
  .hero { position: relative; padding-bottom: 116px; }
  .hero__flight { position: absolute; right: 0; bottom: -70px; width: 250px; height: 220px; z-index: 2; pointer-events: none; }
  .hero__zoef { position: absolute; left: -10px; bottom: 0; width: 260px; height: 220px; animation: zoef 3.2s ease-in-out infinite; }
  .hero__gloed { position: absolute; right: 30px; top: 30px; width: 170px; height: 150px; border-radius: 50%; background: radial-gradient(closest-side, rgba(214,40,58,.45), rgba(214,40,58,0)); filter: blur(6px); }
  .hero__mascotte { position: absolute; right: 6px; bottom: 0; width: 178px; height: auto; transform: rotate(-4deg); filter: drop-shadow(0 6px 6px rgba(11,19,43,.28)); animation: zweef 3.2s ease-in-out infinite; }
  @keyframes zweef { 0%, 100% { transform: translate(0, 0) rotate(-4deg); } 50% { transform: translate(4px, -6px) rotate(-3deg); } }
  @keyframes zoef { 0%, 100% { opacity: .85; transform: translate(0, 0); } 50% { opacity: 1; transform: translate(4px, -6px); } }
  @media (prefers-reduced-motion: reduce) { .hero__mascotte, .hero__zoef { animation: none; } }
  .hero__chip { display: inline-block; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); padding: 6px 12px; border-radius: 999px; font-size: .85rem; font-weight: 600; margin-bottom: 16px; }
  .hero__lead { color: #C9CFDA; font-size: 1.1rem; max-width: 560px; }
  .hero__grid { display: grid; gap: 28px; align-items: center; }
  #besparingscheck { scroll-margin-top: 90px; }
  .hero__card { background: #fff; color: var(--text); border-radius: 12px; padding: 22px; box-shadow: 0 24px 48px -12px rgba(11,19,43,.4); border-top: 3px solid var(--red); }
  .hero__card-title { font-size: 1.6rem; margin-bottom: 4px; }
  .hero__card > p { color: var(--muted); }
  .hero__hint { font-size: .85rem; margin: 12px 0 0; }
  
  .cop { align-items: center; }
  .legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: .85rem; margin-top: 8px; }
  .legend i { display: inline-block; width: 18px; height: 3px; vertical-align: middle; margin-right: 6px; }
  .l-red { background: var(--red); }
  .l-grey { background: repeating-linear-gradient(90deg, #9AA3B2 0 5px, transparent 5px 9px); }
  .note { font-size: .8rem; color: var(--muted); margin: 8px 0 0; }

  .steps { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
  .step { display: flex; gap: 16px; align-items: flex-start; }
  .step h3 { margin-bottom: 4px; }
  .step p { margin: 0; color: var(--muted); font-size: .95rem; }
  .step__icon { position: relative; flex: 0 0 88px; height: 88px; border-radius: 50%; background: var(--bg); border: 1px solid var(--border); display: grid; place-items: center; }
  .step__icon img { width: 68px; height: 68px; }
  .step__icon span { position: absolute; top: -4px; left: -4px; background: var(--red); color: #fff; font-size: .7rem; font-weight: 800; padding: 3px 6px; border-radius: 6px; }
  
  .pump { text-decoration: none; display: flex; flex-direction: column; transition: transform .15s, box-shadow .15s; }
  .pump:hover { transform: translateY(-2px); box-shadow: 0 12px 24px -4px rgba(11,19,43,.08); }
  .pump__img { background: var(--bg); border-radius: 8px; aspect-ratio: 4/3; display: grid; place-items: center; padding: 16px; margin-bottom: 14px; }
  .pump__img :global(.pump__pi) { width: 80%; filter: drop-shadow(0 10px 12px rgba(20,26,46,.18)); }
  .pump__img > img { max-height: 100%; object-fit: contain; }
  .pump__tag { font-size: .75rem; color: var(--muted); font-weight: 600; }
  .pump__price { margin: 0 0 8px; }
  .pump__price small { color: var(--muted); }
  .pump__link { color: var(--red); font-weight: 700; margin-top: auto; }

  .feature { border-top: 3px solid var(--red); }
  .badge { display: inline-block; background: #FFF0F3; color: var(--red); font-size: .75rem; font-weight: 700; padding: 4px 8px; border-radius: 4px; margin-bottom: 10px; }
  .more { color: var(--red); font-weight: 700; text-decoration: none; }

  .final { background: linear-gradient(165deg, #0B132B, var(--navy)); color: #fff; padding: 56px 0; }
  .final h2 { color: #fff; }
  .final .label { color: #FF8A95; }
  .final__grid { display: grid; gap: 28px; align-items: center; }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .checks li::before { content: '✓  '; color: #4CC38A; font-weight: 800; }
  </style>
