---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { warmtepompen, euro } from '../data/warmtepompen';

const stappen = [
  { n: '01', icon: '/icons/01-besparingscheck.svg', t: 'Besparingscheck', d: 'Online in 2 minuten inzicht in wat jij kunt besparen.' },
  { n: '02', icon: '/icons/02-installatiecheck.svg', t: 'Installatiecheck', d: 'We komen langs en meten je woning en radiatoren door.' },
  { n: '03', icon: '/icons/03-installatieplan.svg', t: 'Installatieplan', d: 'Een helder plan en offerte op maat, subsidie al verrekend.' },
  { n: '04', icon: '/icons/04-installatie.svg', t: 'Installatie', d: 'Vakkundig geplaatst en ingeregeld door onze eigen monteurs.' },
  { n: '05', icon: '/icons/05-subsidie-nazorg.svg', t: 'Subsidie & nazorg', d: 'Wij regelen de ISDE-aanvraag en blijven bereikbaar.' },
];
---
<Base title="De Klimaatheld – Warmtepomp & duurzaam verwarmen in Den Haag">
  <section class="hero">
    <div class="container hero__inner">
      <span class="label label--pill">Warmtepomp specialist</span>
      <h1>Duurzaam verwarmen,<br/>zonder gedoe</h1>
      <p class="hero__lead">Eerlijk advies, vakkundige installatie en de subsidie geregeld. Wij zijn De Klimaatheld.</p>
      <form class="postcode" action="/offerte/" method="get">
        <label for="pc" class="sr-only">Postcode</label>
        <input id="pc" name="postcode" placeholder="Postcode, bijv. 2511 AB" autocomplete="postal-code" />
        <button type="submit">Check besparing →</button>
      </form>
      <ul class="usp">
        <li>Eigen monteurs</li><li>Heat Geek-methode</li><li>ISDE-aanvraag geregeld</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="label">Zo werkt het</span>
      <h2>Zo werkt de Klimaatheld</h2>
      <ol class="steps">
        {stappen.map((s) => (
          <li class="card step">
            <div class="step__icon"><span>{s.n}</span><img src={s.icon} alt="" width="80" height="80" loading="lazy" /></div>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white">
    <div class="container grid grid-2 cop">
      <div>
        <span class="label">Meer rendement</span>
        <h2>Hogere COP bij elke installatie</h2>
        <p class="lead">Als De Klimaatheld × Heat Geek ontwerpen we je systeem op lage temperatuur en regelen we het waterzijdig in. Daardoor haalt je warmtepomp meer warmte uit elke kWh.</p>
      </div>
      <div class="card">
        <svg viewBox="0 0 310 200" role="img" aria-label="Grafiek: COP De Klimaatheld hoger dan standaard installateur" font-family="Archivo,sans-serif" font-size="10" fill="#5A6475"><path d="M40 160H300M40 125H300M40 90H300M40 55H300M40 20H300" stroke="#E3E7ED"/><text x="32" y="164" text-anchor="end">2</text><text x="32" y="129" text-anchor="end">3</text><text x="32" y="94" text-anchor="end">4</text><text x="32" y="59" text-anchor="end">5</text><text x="32" y="24" text-anchor="end">6</text><text x="40" y="178" text-anchor="middle">-10°</text><text x="92" y="178" text-anchor="middle">-5°</text><text x="144" y="178" text-anchor="middle">0°</text><text x="196" y="178" text-anchor="middle">5°</text><text x="248" y="178" text-anchor="middle">10°</text><text x="300" y="178" text-anchor="middle">15°</text><polygon points="40,132 92,111 144,90 196,69 248,52 300,38 300,94 248,104 196,118 144,132 92,146 40,160" fill="#D6283A" opacity=".08"/><polyline points="40,160 92,146 144,132 196,118 248,104 300,94" fill="none" stroke="#9AA3B2" stroke-width="2.5" stroke-dasharray="5 4" stroke-linecap="round"/><polyline points="40,132 92,111 144,90 196,69 248,52 300,38" fill="none" stroke="#D6283A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="300" cy="38" r="4.5" fill="#D6283A" stroke="#fff" stroke-width="2"/><text x="40" y="196">Buitentemperatuur</text><text x="40" y="10">COP</text></svg>
        <div class="legend"><span><i class="l-red"></i>De Klimaatheld × Heat Geek</span><span><i class="l-grey"></i>Standaard installateur</span></div>
        <p class="note">Indicatief. Werkelijke COP hangt af van woning en systeem.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="label">Onze warmtepompen</span>
      <h2>Weheat warmtepompen</h2>
      <div class="grid grid-3">
        {warmtepompen.map((w) => (
          <a class="card pump" href={`/warmtepompen/${w.slug}/`}>
            <div class="pump__img"><img src={w.img} alt={w.name} loading="lazy" /></div>
            <span class="pump__tag">{w.tag}</span>
            <h3>{w.name}</h3>
            <p class="pump__price">v.a. <strong>{euro(w.from)}</strong> <small>indicatief</small></p>
            <span class="pump__link">Stel samen →</span>
          </a>
        ))}
      </div>
      <p style="margin-top:24px"><Button href="/warmtepompen/" variant="outline">Alle warmtepompen</Button></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-card">
        <h2>Benieuwd wat jij bespaart?</h2>
        <p>Vraag gratis en vrijblijvend advies aan. We reageren binnen 1 werkdag.</p>
        <Button href="/offerte/" variant="light">Vraag je offerte aan →</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hero { background: linear-gradient(160deg, var(--navy) 0%, var(--navy-2) 70%, #3a1420 100%); color: #fff; padding: 56px 0 64px; }
  .hero h1 { color: #fff; }
  .hero__lead { color: #C9CFDA; font-size: 1.1rem; max-width: 560px; }
  .postcode { display: flex; flex-wrap: wrap; gap: 8px; background: #fff; padding: 8px; border-radius: var(--radius); max-width: 520px; margin: 24px 0 16px; }
  .postcode input { flex: 1 1 180px; border: 0; font: inherit; padding: 12px; min-width: 0; outline: none; }
  .postcode button { flex: 1 1 auto; background: var(--red); color: #fff; border: 0; border-radius: 8px; font: inherit; font-weight: 700; padding: 12px 18px; cursor: pointer; }
  .usp { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: .9rem; }
  .usp li::before { content: '✓ '; color: var(--green); font-weight: 800; }

  .steps { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
  .step { display: flex; gap: 16px; align-items: center; }
  .step h3 { margin-bottom: 4px; }
  .step p { margin: 0; color: var(--muted); }
  .step__icon { position: relative; flex: 0 0 96px; height: 96px; border-radius: 50%; background: var(--bg); border: 1px solid var(--border); display: grid; place-items: center; }
  .step__icon span { position: absolute; top: -4px; left: -4px; background: var(--red); color: #fff; font-size: .7rem; font-weight: 800; padding: 3px 6px; border-radius: 6px; }
  @media (min-width: 960px) {
    .steps { grid-template-columns: repeat(5, 1fr); }
    .step { flex-direction: column; text-align: center; }
  }

  .section--white { background: #fff; }
  .cop { align-items: center; }
  .legend { display: flex; flex-wrap: wrap; gap: 16px; font-size: .85rem; margin-top: 8px; }
  .legend i { display: inline-block; width: 18px; height: 3px; vertical-align: middle; margin-right: 6px; }
  .l-red { background: var(--red); }
  .l-grey { background: repeating-linear-gradient(90deg, #9AA3B2 0 5px, transparent 5px 9px); }
  .note { font-size: .8rem; color: var(--muted); margin: 8px 0 0; }

  .pump { text-decoration: none; display: flex; flex-direction: column; transition: transform .15s; }
  .pump:hover { transform: translateY(-2px); }
  .pump__img { background: var(--bg); border-radius: 8px; aspect-ratio: 4/3; display: grid; place-items: center; padding: 16px; margin-bottom: 14px; }
  .pump__img img { max-height: 100%; object-fit: contain; filter: drop-shadow(0 10px 12px rgba(20,26,46,.18)); }
  .pump__tag { font-size: .75rem; color: var(--muted); font-weight: 600; }
  .pump__price { margin: 0 0 8px; }
  .pump__price small { color: var(--muted); }
  .pump__link { color: var(--red); font-weight: 700; margin-top: auto; }

  .cta-card { background: var(--red); color: #fff; border-radius: var(--radius); padding: 36px 24px; }
  .cta-card h2 { color: #fff; }
</style>
