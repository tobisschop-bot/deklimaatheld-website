---
// Herbruikbaar dienstpagina-sjabloon (airco, cv-ketel, vloerverwarming, zonnepanelen…).
// Alle inhoud komt uit één data-object (zie src/data/diensten.ts).
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Button from '../Button.astro';
import Faq from '../Faq.astro';
import CtaCard from '../CtaCard.astro';
import { site } from '../../data/site';
import { andereDiensten, type DienstData, type IconNaam } from '../../data/diensten';

interface Props { data: DienstData }
const { data } = Astro.props;
const anderen = andereDiensten(data.slug);

// Lijn-iconen (24x24, stroke). Alleen paden; de <svg>-wrapper staat hieronder.
const icons: Record<IconNaam, string> = {
  airco: '<rect x="2" y="6" width="20" height="11" rx="2"/><path d="M6 13h12M6 10h4M6 19l2 2M12 19v3M18 19l-2 2"/>',
  zon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  geluid: '<path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/>',
  blad: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  app: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01M9 7c1.5-1 4.5-1 6 0M10.5 9.5c.7-.5 2.3-.5 3 0"/>',
  warmtepomp: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="10" cy="12" r="4"/><path d="M10 8v8M6 12h8M17 8h1M17 12h1M17 16h1"/>',
  vlam: '<path d="M8.5 14.5A3.5 3.5 0 0 0 12 18a3.5 3.5 0 0 0 3.5-3.5c0-2-1.5-3.5-2.5-5-.5 1-1.5 1.5-2 1.5-1 0-1.5-.5-1.5-1.5 0-1.5 1-3.5 2.5-5.5-4 1.5-7 5.5-7 10a7 7 0 0 0 14 0c0-4-2.5-7.5-6-9.5"/>',
  vloer: '<path d="M3 5h14a3 3 0 0 1 0 6H7a3 3 0 0 0 0 6h14"/>',
  zonnepaneel: '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M12 4v12M3 10h18M7 20h10M12 16v4"/>',
};
const check = '<path d="M20 6 9 17l-5-5"/>';
---
<Base title={data.meta.title} description={data.meta.description}>
  <!-- HERO -->
  <PageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: data.hero.label }]}
    label={data.hero.label}
    title={data.hero.title}
    lead={data.hero.lead}
  >
    <div class="d-hero__btns">
      <Button href={data.hero.cta.href} full>{data.hero.cta.label} →</Button>
      <a class="d-ghost" href={site.phoneHref} aria-label={`Bel ons: ${site.phone}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
        Bel ons
      </a>
    </div>
  </PageHero>

  <!-- PRODUCTVLAK -->
  <section class="d-product" aria-label="Productfoto">
    <div class="container">
      <div class="placeholder d-product__ph">
        <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[data.product.icon]} />
        <span>{data.product.placeholder}</span>
        {data.product.caption && <small>{data.product.caption}</small>}
      </div>
    </div>
  </section>

  <!-- KEUZE -->
  <section class="section section--white">
    <div class="container">
      <h2>{data.keuze.title}</h2>
      {data.keuze.lead && <p class="lead">{data.keuze.lead}</p>}
      <div class="grid">
        {data.keuze.kaarten.map((k) => (
          <article class="card d-keuze">
            <div class="d-keuze__top">
              <div>
                <span class="label">{k.tag}</span>
                <h3>{k.title}</h3>
              </div>
              <div class="d-keuze__prijs">
                <strong>{k.prijs}</strong>
                <small>{k.prijsNoot}</small>
              </div>
            </div>
            <p>{k.tekst}</p>
            <a class="d-more" href={k.href}>{k.cta} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- VOORDELEN -->
  <section class="section">
    <div class="container">
      <h2>{data.voordelen.title}</h2>
      <ul class="d-voordelen">
        {data.voordelen.items.map((v) => (
          <li class="card">
            <span class="d-icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[v.icon]} /></span>
            <h3>{v.title}</h3>
            <p>{v.tekst}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- WAT ZIT ER IN DE PRIJS -->
  <section class="section section--white">
    <div class="container">
      <h2>{data.prijs.title}</h2>
      <ul class="d-checks">
        {data.prijs.items.map((p) => (
          <li>
            <span class="d-check"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check} /></span>
            <div><strong>{p.title}</strong><span>{p.tekst}</span></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STAPPEN -->
  <section class="section">
    <div class="container">
      <h2>{data.stappen.title}</h2>
      <ol class="d-steps">
        {data.stappen.items.map((s, i) => (
          <li>
            <span class="d-steps__n">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{s.title}</h3><p>{s.tekst}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white">
    <div class="container d-faq">
      <Faq items={data.faq} />
    </div>
  </section>

  <!-- ANDERE DIENSTEN -->
  <section class="section">
    <div class="container">
      <div class="d-anderen__head">
        <h2>Andere diensten</h2>
        <span aria-hidden="true">Veeg voor meer →</span>
      </div>
      <ul class="d-anderen" aria-label="Andere diensten">
        {anderen.map((d) => (
          <li>
            <a class="card d-dienst" href={d.href}>
              <span class="d-icon"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[d.icon]} /></span>
              <span class="d-dienst__t">{d.title} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="section d-cta">
    <div class="container">
      <CtaCard title={data.cta.title} text={data.cta.text} button={data.cta.button} href={data.cta.href} />
    </div>
  </section>
</Base>

<script>
  // Eén FAQ tegelijk open (zonder JS werken de <details> gewoon los van elkaar).
  document.querySelectorAll<HTMLDetailsElement>('.d-faq details').forEach((el, _, all) => {
    el.addEventListener('toggle', () => {
      if (el.open) all.forEach((o) => { if (o !== el) o.open = false; });
    });
  });
</script>

<style>
  .section--white { background: #fff; }

  /* Hero-knoppen */
  .d-hero__btns { display: grid; gap: 10px; margin-top: 24px; }
  .d-ghost {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 12px 22px; border-radius: var(--radius);
    border: 2px solid rgba(255,255,255,.35); color: #fff; font-weight: 700; text-decoration: none;
  }
  .d-ghost:hover { border-color: #fff; background: rgba(255,255,255,.06); }

  /* Productvlak */
  .d-product { background: #fff; padding: 24px 0 0; }
  .d-product__ph { aspect-ratio: 4 / 3; gap: 6px; align-content: center; }
  .d-product__ph svg { color: var(--navy); opacity: .5; }
  .d-product__ph span { font-weight: 700; color: var(--navy); }
  .d-product__ph small { font-size: .8rem; }

  /* Keuzekaarten */
  .d-keuze { border-top: 3px solid var(--red); display: flex; flex-direction: column; }
  .d-keuze__top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; margin-bottom: 8px; }
  .d-keuze h3 { margin: 0; font-size: 1.5rem; }
  .d-keuze .label { margin-bottom: 4px; }
  .d-keuze__prijs { text-align: right; flex-shrink: 0; }
  .d-keuze__prijs strong { display: block; font-size: 1.1rem; color: var(--navy); white-space: nowrap; }
  .d-keuze__prijs small { display: block; font-size: .72rem; color: var(--muted); }
  .d-keuze p { color: var(--muted); margin-bottom: 12px; }
  .d-more { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--red); font-weight: 700; text-decoration: none; align-self: flex-start; }

  /* Iconen */
  .d-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; background: var(--red-soft); color: var(--red); margin-bottom: 12px; }

  /* Voordelen 2x2 */
  .d-voordelen { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .d-voordelen li { padding: 16px; }
  .d-voordelen h3 { font-size: 1.05rem; margin-bottom: 4px; }
  .d-voordelen p { margin: 0; font-size: .88rem; color: var(--muted); line-height: 1.4; }

  /* Wat zit er in de prijs */
  .d-checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .d-checks li { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .d-checks li:last-child { border-bottom: 0; }
  .d-check { flex: 0 0 28px; height: 28px; border-radius: 50%; background: var(--green-soft); color: var(--green); display: grid; place-items: center; margin-top: 2px; }
  .d-checks strong { display: block; }
  .d-checks span:not(.d-check) { display: block; font-size: .92rem; color: var(--muted); }

  /* Stappen met verbindingslijn */
  .d-steps { list-style: none; padding: 0; margin: 0; position: relative; display: grid; gap: 22px; }
  .d-steps li:not(:last-child)::before { content: ''; position: absolute; left: 21px; top: 44px; bottom: -22px; width: 2px; background: var(--border); }
  .d-steps li { display: flex; gap: 16px; align-items: flex-start; position: relative; }
  .d-steps__n { flex: 0 0 44px; height: 44px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 800; display: grid; place-items: center; font-size: .9rem; box-shadow: 0 0 0 4px var(--bg); }
  .d-steps h3 { margin: 10px 0 4px; font-size: 1.1rem; }
  .d-steps p { margin: 0; color: var(--muted); font-size: .95rem; }

  /* Andere diensten – horizontaal scrollbaar */
  .d-anderen__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .d-anderen__head span { font-size: .8rem; color: var(--muted); white-space: nowrap; }
  .d-anderen {
    list-style: none; margin: 8px calc(-1 * var(--gutter)) 0; padding: 4px var(--gutter) 12px;
    display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--gutter); scrollbar-width: none;
  }
  .d-anderen::-webkit-scrollbar { display: none; }
  .d-anderen li { flex: 0 0 150px; scroll-snap-align: start; }
  .d-dienst { display: flex; flex-direction: column; height: 100%; min-height: 120px; padding: 16px; text-decoration: none; }
  .d-dienst__t { margin-top: auto; font-weight: 700; display: flex; justify-content: space-between; gap: 6px; }
  .d-dienst__t span { color: var(--red); }

  .d-cta { padding-top: 0; }
</style>
