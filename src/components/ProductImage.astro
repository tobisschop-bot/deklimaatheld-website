---
// Productfoto die automatisch de transparante rand wegsnijdt (zie fotoCrop),
// zodat het apparaat het vak vult in de juiste verhouding.
import { fotoCrop } from '../data/warmtepompen';
interface Props { src: string; alt: string; loading?: 'lazy' | 'eager'; class?: string }
const { src, alt, loading = 'lazy', class: cls } = Astro.props;
const c = fotoCrop[src];
if (!c && src.startsWith('http')) {
  // Elke productfoto hoort een bijsnijdkader te hebben, anders staat het product klein in het vak.
  console.warn(`[ProductImage] Geen fotoCrop voor ${src} – voeg het kader toe in src/data/warmtepompen.ts`);
}
const bw = c ? c.box[2] - c.box[0] : 0;
const bh = c ? c.box[3] - c.box[1] : 0;
---
{c ? (
  <span class:list={['pi', cls]} style={`aspect-ratio:${bw}/${bh}`}>
    <img src={src} alt={alt} loading={loading} width={c.w} height={c.h}
      style={`width:${(c.w / bw) * 100}%;left:${(-c.box[0] / bw) * 100}%;top:${(-c.box[1] / bh) * 100}%`} />
  </span>
) : (
  <span class:list={['pi-box', cls]}><img class="pi-flat" src={src} alt={alt} loading={loading} /></span>
)}

<style>
  .pi { position: relative; display: block; width: 100%; overflow: hidden; }
  .pi img { position: absolute; max-width: none; height: auto; }
  /* Eigen (lokale) foto's: altijd volledig binnen het vak, in de juiste verhouding, ongeacht of de foto hoog of breed is */
  .pi-box { position: relative; display: block; align-self: stretch; justify-self: center; height: 100%; min-height: 0; }
  .pi-flat { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
</style>
