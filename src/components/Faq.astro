---
// Accordion met veelgestelde vragen (werkt zonder JavaScript via <details>)
interface Props { title?: string; items: { q: string; a: string }[] }
const { title = 'Veelgestelde vragen', items } = Astro.props;
---
<div class="faq">
  {title && <h2>{title}</h2>}
  {items.map((it, i) => (
    <details class="faq__item" open={i === 0}>
      <summary>{it.q}</summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>

<style>
  .faq__item { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 10px; }
  .faq__item summary { cursor: pointer; list-style: none; padding: 16px 44px 16px 16px; font-weight: 700; position: relative; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--red); font-size: 1.4rem; font-weight: 400; }
  .faq__item[open] summary::after { content: '–'; }
  .faq__item p { padding: 0 16px 16px; margin: 0; color: var(--muted); }
</style>
