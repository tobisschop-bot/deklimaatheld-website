---
// Desktopontwerp /lt-verwarming/ (vanaf 1024 px). Mobiel blijft DienstPagina.
// Opbouw (gekozen door Tycho, 8 nov 2026):
//   1. hero + showcase (Strada / Strada Hybrid)
//   2. temperatuurschuif: gewone radiator vs LT-radiator
//   3. COP-blok "Hoe lager het water, hoe zuiniger je warmtepomp"
//   4. Welke oplossing past bij jou? (Jaga-kaarten)
//   5. Wat past bij jouw huis? (vloer / LT / combinatie)
//   6. Wat zit er in de prijs + Zo werkt het
//   7. Vragen over LT + rode afsluiter
// Tekst en prijzen komen uit src/data/diensten.ts (ltVerwarming). Beelden van Jaga = fabrikantbeeld.
import { site } from '../../data/site';
import type { DienstData } from '../../data/diensten';

interface Props { data: DienstData }
const { data } = Astro.props;
const [strada, hybrid] = data.keuze.kaarten;
const modellen = [
  { id: 'strada', ...strada },
  { id: 'hybrid', ...hybrid },
];
const offerte = data.cta.href ?? '/offerte/?dienst=LT-verwarming';
---
<div class="ltd">

  <!-- 1. HERO + SHOWCASE -->
  <section class="ltd-hero">
    <div class="ltd-wrap ltd-hero__grid">
      <div>
        <nav class="ltd-crumbs" aria-label="Kruimelpad"><a href="/">Home</a> / <span aria-current="page">{data.hero.label}</span></nav>
        <span class="label">{data.hero.label}</span>
        <h1>{data.hero.title}</h1>
        <p class="ltd-lead">{data.hero.lead}</p>
        <div class="ltd-btns">
          <a class="ltd-pill ltd-pill--red" href={data.hero.cta.href}>{data.hero.cta.label} →</a>
          <a class="ltd-pill ltd-pill--outline" href={site.phoneHref} aria-label={`Bel ons: ${site.phone}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
            Bel ons
          </a>
        </div>
      </div>

      <div class="ltd-show" data-show>
        <div class="ltd-show__glow" aria-hidden="true"></div>
        <div class="ltd-tabs" role="group" aria-label="Kies een model">
          {modellen.map((m, i) => (
            <button type="button" class="ltd-tab" data-model={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.title}</button>
          ))}
        </div>
        {modellen.map((m, i) => (
          <div class="ltd-show__model" data-panel={m.id} hidden={i !== 0}>
            <figure class="ltd-show__fig">
              <img src={m.img} alt={m.imgAlt ?? ''} width="900" height="750" loading={i === 0 ? 'eager' : 'lazy'} />
              <figcaption>Beeld: Jaga</figcaption>
            </figure>
            <div class="ltd-podium" aria-hidden="true"></div>
            <div class="ltd-show__onder">
            <ul class="ltd-show__punten">
              {m.punten?.map((p) => <li>{p}</li>)}
            </ul>
            <div class="ltd-prijskaart">
              <span class="ltd-prijskaart__tag">{m.tag}</span>
              <strong class="ltd-prijskaart__naam">{m.title}</strong>
              <span class="ltd-prijskaart__prijs">{m.prijs}</span>
              <small>{m.prijsNoot}</small>
              <a class="ltd-pill ltd-pill--red ltd-pill--block" href={m.href}>{m.cta}</a>
            </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. TEMPERATUURSCHUIF -->
  <section class="ltd-sec ltd-sec--top0" aria-labelledby="ltd-schuif-t">
    <div class="ltd-wrap">
      <span class="label">Zelf zien</span>
      <h2 id="ltd-schuif-t">Draai aan de aanvoertemperatuur</h2>
      <p class="ltd-lead ltd-lead--smal">Een cv-ketel stookt het water vaak naar 60–80 °C. Een warmtepomp werkt het zuinigst rond 35–45 °C. Schuif en kijk wat er met je radiatoren gebeurt.</p>

      <div class="ltd-schuif" data-schuif>
        <label class="ltd-schuif__kop" for="ltd-temp">
          <span>Aanvoertemperatuur van het water</span>
          <output class="ltd-schuif__waarde" for="ltd-temp" data-out>70 °C</output>
        </label>
        <input id="ltd-temp" type="range" min="35" max="70" step="1" value="70" aria-valuetext="70 graden" />
        <div class="ltd-schuif__as"><span>35 °C · warmtepomp</span><span>70 °C · cv-ketel</span></div>

        <div class="ltd-vgl">
          <div class="ltd-vgl__kaart">
            <span class="ltd-mini">Gewone radiator</span>
            <svg viewBox="0 0 220 110" role="img" aria-label="Gewone paneelradiator">
              <rect x="10" y="10" width="200" height="80" rx="6" class="ltd-hot-fill" fill="#D6283A" />
              <g stroke="rgba(255,255,255,.55)" stroke-width="2"><path d="M45 18v64M80 18v64M115 18v64M150 18v64M185 18v64" /></g>
              <path d="M22 90h8v14h-8zM190 90h8v14h-8z" fill="#5A6475" />
            </svg>
            <p class="ltd-vgl__titel" data-g-titel>Genoeg warmte</p>
            <p class="ltd-vgl__tekst" data-g-tekst>Op deze temperatuur doet een gewone radiator zijn werk. Maar je warmtepomp moet hard stoken.</p>
          </div>
          <div class="ltd-vgl__kaart ltd-vgl__kaart--lt">
            <span class="ltd-mini ltd-mini--red">LT-radiator</span>
            <svg viewBox="0 0 220 110" role="img" aria-label="LT-radiator met lamellen en ventilatoren">
              <rect x="10" y="10" width="200" height="80" rx="6" fill="#141A2E" />
              <g class="ltd-hot-stroke" stroke="#D6283A" stroke-width="3"><path d="M30 22v56M44 22v56M58 22v56M72 22v56M86 22v56M100 22v56M114 22v56M128 22v56" /></g>
              <circle cx="168" cy="38" r="12" fill="none" stroke="#FF8A95" stroke-width="2" /><circle cx="168" cy="66" r="12" fill="none" stroke="#FF8A95" stroke-width="2" />
              <path d="M22 90h8v14h-8zM190 90h8v14h-8z" fill="#5A6475" />
            </svg>
            <p class="ltd-vgl__titel ltd-ok" data-l-titel>Genoeg warmte, maar het kan zuiniger</p>
            <p class="ltd-vgl__tekst" data-l-tekst>Een LT-radiator kan dit ook, maar hij heeft deze hoge temperatuur niet nodig.</p>
          </div>
        </div>

        <div class="ltd-wp">
          <span class="ltd-wp__label">Je warmtepomp</span>
          <div class="ltd-wp__balk" aria-hidden="true"><div class="ltd-wp__vul" data-wp-vul></div></div>
          <span class="ltd-wp__tekst" data-wp-tekst>Moet hard stoken</span>
        </div>
        <p class="ltd-noot">Illustratief, geen berekening. Wat jouw woning nodig heeft, rekenen we per ruimte uit.</p>
      </div>
    </div>
  </section>

  <!-- 3. COP-BLOK -->
  <section class="ltd-sec ltd-sec--top0" aria-labelledby="ltd-cop-t">
    <div class="ltd-wrap">
      <div class="ltd-cop">
        <div class="ltd-cop__glow" aria-hidden="true"></div>
        <div class="ltd-cop__tekst">
          <span class="label ltd-label-roze">Waarom lager water</span>
          <h2 id="ltd-cop-t">Hoe lager het water, hoe zuiniger je warmtepomp</h2>
          <p>De COP zegt hoeveel warmte je krijgt per kWh stroom. Die zakt als het water heter moet. LT-radiatoren geven ook met lauw water genoeg warmte. Daarom ontwerpen we als De Klimaatheld × Heat Geek op lage temperatuur.</p>
        </div>
        <figure class="ltd-cop__kaart">
          <img class="ltd-cop__bron" src="/img/heatgeek-stempel.png?v=2" alt="Heat Geek" width="228" height="101" loading="lazy" />
          <svg viewBox="0 -26 310 226" role="img" aria-label="Grafiek: COP van De Klimaatheld hoger dan standaard installateur" font-family="Archivo,sans-serif" font-size="10" fill="#5A6475"><path d="M40 160H300M40 125H300M40 90H300M40 55H300M40 20H300" stroke="#E3E7ED"/><text x="32" y="164" text-anchor="end">2</text><text x="32" y="129" text-anchor="end">3</text><text x="32" y="94" text-anchor="end">4</text><text x="32" y="59" text-anchor="end">5</text><text x="32" y="24" text-anchor="end">6</text><text x="40" y="178" text-anchor="middle">-10°</text><text x="92" y="178" text-anchor="middle">-5°</text><text x="144" y="178" text-anchor="middle">0°</text><text x="196" y="178" text-anchor="middle">5°</text><text x="248" y="178" text-anchor="middle">10°</text><text x="300" y="178" text-anchor="middle">15°</text><polygon points="40,132 92,111 144,90 196,69 248,52 300,38 300,94 248,104 196,118 144,132 92,146 40,160" fill="#D6283A" opacity=".08"/><polyline points="40,160 92,146 144,132 196,118 248,104 300,94" fill="none" stroke="#9AA3B2" stroke-width="2.5" stroke-dasharray="5 4" stroke-linecap="round"/><polyline points="40,132 92,111 144,90 196,69 248,52 300,38" fill="none" stroke="#D6283A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="300" cy="38" r="4.5" fill="#D6283A" stroke="#fff" stroke-width="2"/><g transform="rotate(8 282 24)"><image href="/img/kh-held.webp" x="264" y="6" width="36" height="34"/></g><text x="40" y="196">Buitentemperatuur</text><text x="40" y="10">COP</text></svg>
          <div class="ltd-legend"><span><i class="ltd-l-red"></i>De Klimaatheld × Heat Geek</span><span><i class="ltd-l-grey"></i>Standaard installateur</span></div>
          <figcaption class="ltd-noot">Indicatief. Werkelijke COP hangt af van woning en systeem.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 4. WELKE OPLOSSING -->
  <section class="ltd-sec ltd-sec--wit" aria-labelledby="ltd-keuze-t">
    <div class="ltd-wrap">
      <span class="label">Wat we plaatsen</span>
      <h2 id="ltd-keuze-t">{data.keuze.title}</h2>
      {data.keuze.lead && <p class="ltd-lead ltd-lead--smal">{data.keuze.lead}</p>}
      <div class="ltd-producten">
        {data.keuze.kaarten.map((k) => (
          <article class="ltd-product">
            {k.img && <figure class="ltd-product__img"><img src={k.img} alt={k.imgAlt ?? ''} width="900" height="750" loading="lazy" /><figcaption>Beeld: Jaga</figcaption></figure>}
            <div class="ltd-product__top">
              <div><span class="label">{k.tag}</span><h3>{k.title}</h3></div>
              <div class="ltd-product__prijs"><strong>{k.prijs}</strong><small>{k.prijsNoot}</small></div>
            </div>
            <p>{k.tekst}</p>
            {k.punten && <ul class="ltd-checks">{k.punten.map((pt) => <li>{pt}</li>)}</ul>}
            <a class="ltd-link" href={k.href}>{k.cta} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. WAT PAST BIJ JOUW HUIS -->
  <section class="ltd-sec" aria-labelledby="ltd-huis-t">
    <div class="ltd-wrap">
      <span class="label">Vloer, radiator of allebei</span>
      <h2 id="ltd-huis-t">Wat past bij jouw huis?</h2>
      <div class="ltd-huis">
        <a class="ltd-huis__kaart" href="/vloerverwarming/">
          <span class="ltd-mini">Vloerverwarming</span>
          <h3>Je gaat toch verbouwen</h3>
          <p>Nieuwe vloer of uitbouw? Dan is vloerverwarming vaak de mooiste LT-oplossing.</p>
          <span class="ltd-link">Naar vloerverwarming <span aria-hidden="true">→</span></span>
        </a>
        <a class="ltd-huis__kaart ltd-huis__kaart--navy" href={offerte}>
          <span class="ltd-mini ltd-label-roze">LT-radiatoren</span>
          <h3>De vloer blijft liggen</h3>
          <p>Radiatoren vervangen kan meestal op de bestaande leidingen. Alleen waar het nodig is.</p>
          <span class="ltd-link">Vraag advies <span aria-hidden="true">→</span></span>
        </a>
        <a class="ltd-huis__kaart" href={offerte}>
          <span class="ltd-mini">Combinatie</span>
          <h3>Beneden vloer, boven radiatoren</h3>
          <p>Veel woningen doen het zo. We stemmen alles op elkaar af.</p>
          <span class="ltd-link">Bespreek je situatie <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. PRIJS + STAPPEN -->
  <section class="ltd-sec ltd-sec--wit">
    <div class="ltd-wrap ltd-twee">
      <div>
        <h2 class="ltd-h2-s">{data.prijs.title}</h2>
        <ul class="ltd-prijs">
          {data.prijs.items.map((p) => (
            <li>
              <span class="ltd-vink" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              <div><strong>{p.title}</strong><span>{p.tekst}</span></div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="ltd-h2-s">{data.stappen.title}</h2>
        <ol class="ltd-stappen">
          {data.stappen.items.map((s, i) => (
            <li>
              <span class:list={['ltd-stappen__n', { 'ltd-stappen__n--rood': i === data.stappen.items.length - 1 }]}>{String(i + 1).padStart(2, '0')}</span>
              <div><strong>{s.title}</strong><span>{s.tekst}</span></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 7. VRAGEN OVER LT + AFSLUITER -->
  <section class="ltd-sec" aria-labelledby="ltd-faq-t">
    <div class="ltd-wrap ltd-slot">
      <div class="ltd-faq">
        <h2 id="ltd-faq-t">Vragen over LT</h2>
        {data.faq.map((f, i) => (
          <details class="ltd-faq__item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <aside class="ltd-cta" aria-labelledby="ltd-cta-t">
        <h2 id="ltd-cta-t">{data.cta.title}</h2>
        {data.cta.text && <p>{data.cta.text}</p>}
        <div class="ltd-cta__btns">
          <a class="ltd-pill ltd-pill--navy ltd-pill--block" href="/#besparingscheck">Doe de besparingscheck</a>
          <a class="ltd-pill ltd-pill--roze ltd-pill--block" href={offerte}>{data.cta.button}</a>
        </div>
      </aside>
    </div>
  </section>
</div>

<script>
  // Showcase: Strada / Strada Hybrid
  document.querySelectorAll<HTMLElement>('[data-show]').forEach((show) => {
    const tabs = show.querySelectorAll<HTMLButtonElement>('[data-model]');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
      show.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.model; });
    }));
  });

  // Temperatuurschuif (kwalitatief, geen berekening)
  document.querySelectorAll<HTMLElement>('[data-schuif]').forEach((el) => {
    const input = el.querySelector<HTMLInputElement>('input[type=range]')!;
    const $ = (s: string) => el.querySelector<HTMLElement>(s)!;
    const update = () => {
      const t = Number(input.value);
      const f = (t - 35) / 35;
      const mix = (a: number, b: number) => Math.round(a + (b - a) * f);
      const hot = `rgb(${mix(244, 214)},${mix(199, 40)},${mix(203, 58)})`;
      el.querySelectorAll<SVGElement>('.ltd-hot-fill').forEach((r) => r.setAttribute('fill', hot));
      el.querySelectorAll<SVGElement>('.ltd-hot-stroke').forEach((g) => g.setAttribute('stroke', hot));
      $('[data-out]').textContent = `${t} °C`;
      input.setAttribute('aria-valuetext', `${t} graden`);

      const g = t >= 60
        ? ['Genoeg warmte', 'Op deze temperatuur doet een gewone radiator zijn werk. Maar je warmtepomp moet hard stoken.', false]
        : t >= 50
          ? ['Net te weinig', 'De radiator wordt lauw. In koude weken haalt de kamer de gewenste temperatuur niet altijd.', true]
          : ['Te weinig warmte', 'Het water is te koel voor deze radiator. De kamer blijft fris.', true];
      $('[data-g-titel]').textContent = g[0] as string;
      $('[data-g-titel]').classList.toggle('ltd-slecht', g[2] as boolean);
      $('[data-g-tekst]').textContent = g[1] as string;

      const laag = t <= 50;
      $('[data-l-titel]').textContent = laag ? 'Genoeg warmte' : 'Genoeg warmte, maar het kan zuiniger';
      $('[data-l-tekst]').textContent = laag
        ? 'Meer lamellen en (bij de Hybrid) ventilatoren halen genoeg warmte uit lauw water.'
        : 'Een LT-radiator kan dit ook, maar hij heeft deze hoge temperatuur niet nodig.';

      const wp = t <= 45 ? ['Werkt zuinig', 'ltd-wp--goed'] : t <= 55 ? ['Minder zuinig', 'ltd-wp--matig'] : ['Moet hard stoken', 'ltd-wp--slecht'];
      const wpEl = $('.ltd-wp');
      wpEl.classList.remove('ltd-wp--goed', 'ltd-wp--matig', 'ltd-wp--slecht');
      wpEl.classList.add(wp[1]);
      $('[data-wp-tekst]').textContent = wp[0];
      $('[data-wp-vul]').style.width = `${Math.round(92 - f * 66)}%`;
    };
    input.addEventListener('input', update);
    update();
  });

  // FAQ: één vraag tegelijk open
  document.querySelectorAll<HTMLDetailsElement>('.ltd-faq__item').forEach((el, _, all) => {
    el.addEventListener('toggle', () => { if (el.open) all.forEach((o) => { if (o !== el) o.open = false; }); });
  });
</script>

<style>
  /* Alleen zichtbaar op desktop; mobiel = DienstPagina */
  .ltd { display: none; }
  @media (min-width: 1024px) { :global(html.desktop-ok) .ltd { display: block; } }

  .ltd-wrap { max-width: 1264px; margin: 0 auto; padding: 0 32px; }
  .ltd h1, .ltd h2, .ltd h3 { hyphens: manual; }
  .ltd h1 { font-size: clamp(2.9rem, 4.2vw, 3.9rem); line-height: .95; font-weight: 900; font-stretch: 72%; margin: 0; }
  .ltd h2 { font-size: clamp(2.25rem, 3.4vw, 3rem); line-height: 1; font-weight: 900; font-stretch: 72%; margin: 0; }
  .ltd .label { margin-bottom: 12px; letter-spacing: .12em; font-weight: 800; }
  .ltd-label-roze { color: #FF8A95; }
  .ltd-lead { margin: 20px 0 0; font-size: 1.15rem; line-height: 1.55; color: var(--muted); }
  .ltd-lead--smal { max-width: 680px; }
  .ltd-mini { display: block; font-size: .75rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .ltd-mini--red { color: var(--red); }
  .ltd-noot { margin: 12px 0 0; font-size: .78rem; color: var(--muted); }

  /* Knoppen */
  .ltd-btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .ltd-pill { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 14px 28px; border-radius: 999px; font-weight: 800; text-decoration: none; transition: background-color .15s, color .15s, border-color .15s, transform .15s; }
  .ltd-pill:active { transform: translateY(1px); }
  .ltd-pill--block { width: 100%; }
  .ltd-pill--red { background: var(--red); color: #fff; }
  .ltd-pill--red:hover { background: var(--red-dark); }
  .ltd-pill--outline { border: 2px solid var(--navy); color: var(--navy); }
  .ltd-pill--outline:hover { background: var(--navy); color: #fff; }
  .ltd-pill--navy { background: #0B132B; color: #fff; }
  .ltd-pill--navy:hover { background: var(--navy-2); }
  .ltd-pill--roze { background: var(--red-soft); color: var(--red-dark); }
  .ltd-pill--roze:hover { background: #fff; }
  .ltd a:focus-visible, .ltd button:focus-visible, .ltd input:focus-visible, .ltd summary:focus-visible { outline: 3px solid #FF8A95; outline-offset: 3px; }

  /* 1. Hero + showcase */
  .ltd-hero { padding: 56px 0 104px; }
  .ltd-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 56px; align-items: center; }
  .ltd-crumbs { font-size: .85rem; color: var(--muted); margin-bottom: 18px; }
  .ltd-crumbs a { color: var(--muted); }
  .ltd-show { position: relative; background: var(--navy); color: #fff; border-radius: 28px; padding: 28px; min-height: 580px; overflow: hidden; }
  .ltd-show__glow { position: absolute; left: 50%; top: 58%; transform: translate(-50%, -50%); width: 640px; height: 440px; border-radius: 50%; background: radial-gradient(ellipse, rgba(214,40,58,.55), rgba(214,40,58,0) 65%); pointer-events: none; }
  .ltd-tabs { position: relative; display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.14); }
  .ltd-tab { min-height: 44px; padding: 10px 20px; border-radius: 999px; border: 0; background: transparent; color: #fff; font: 700 .9rem var(--font-body); cursor: pointer; transition: background-color .15s; }
  .ltd-tab:hover { background: rgba(255,255,255,.1); }
  .ltd-tab[aria-pressed='true'] { background: var(--red); }
  .ltd-show__model { position: relative; }
  .ltd-show__fig { margin: 28px auto 0; width: 64%; position: relative; z-index: 1; }
  .ltd-show__fig img { width: 100%; height: auto; border-radius: 16px; box-shadow: 0 24px 50px rgba(0,0,0,.4); }
