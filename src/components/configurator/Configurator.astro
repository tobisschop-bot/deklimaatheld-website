---
import ProductImage from '../ProductImage.astro';
// Data-gedreven productconfigurator voor een warmtepompmodel.
// Alle inhoud komt uit src/data/configurator.ts – een nieuw model heeft alleen data nodig.
import PageHero from '../PageHero.astro';
import { euro } from '../../data/warmtepompen';
import type { ConfigModel } from '../../data/configurator';
import ModelDetails from './ModelDetails.astro';
import ConfigBar from './ConfigBar.astro';

interface Props { model: ConfigModel }
const { model: m } = Astro.props;

// Beginkeuzes (ook de server-gerenderde samenvatting zonder JS)
const startU = m.uitvoeringen[0];
const startK = m.kleuren.find((k) => k.id === m.photoColor) ?? m.kleuren[0];
const startB = m.boilers.find((b) => b.id === m.defaultBoiler) ?? m.boilers[0];
const single = m.kleuren.length === 1;
const uid = `cfg-${m.slug}`;
---
<PageHero
  label={m.name}
  title={m.title}
  lead={m.lead}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Warmtepompen', href: '/warmtepompen/' }, { label: m.name }]}
/>

<div class="cfg" data-cfg data-model={m.slug} data-short={m.short}>
  <section class="cfg__photo-wrap container">
    <figure class="cfg__photo card">
      <ProductImage src={m.img} alt={m.imgAlt} loading="eager" class="cfg__img" />
      <figcaption class="cfg__shown">Getoonde kleur: {m.photoColor}</figcaption>
    </figure>
    <ul class="cfg__facts">
      {m.quickFacts.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}
    </ul>
  </section>

  <section class="section" aria-label="Configurator">
  <div class="cfg__steps container">
    <!-- Stap 1: uitvoering -->
    <fieldset class="step">
      <legend class="step__head"><span class="step__n">1</span><span><span class="step__title">Kies je uitvoering</span><span class="step__sub">Bepaalt of je cv-ketel blijft of helemaal verdwijnt.</span></span></legend>
      <div class="opts opts--2">
        {m.uitvoeringen.map((u) => (
          <label class="opt">
            <input class="sr" type="radio" name={`${uid}-u`} value={u.id} data-price={u.price ?? ''} data-boiler={u.needsBoiler ? '1' : '0'} data-name={u.name} checked={u.id === startU.id} />
            <span class="opt__body">
              <span class="opt__badge">{u.badge}</span>
              <span class="opt__name">{u.name}</span>
              <span class="opt__text">{u.text}</span>
              {u.price != null
                ? <span class="opt__price"><small>v.a.</small> {euro(u.price)}<small>* indicatief</small></span>
                : <span class="opt__price">Prijs op aanvraag</span>}
              <span class="opt__check" aria-hidden="true">✓ Gekozen</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <!-- Stap 2: afwerking -->
    <fieldset class="step">
      <legend class="step__head"><span class="step__n">2</span><span><span class="step__title">Kies de afwerking</span><span class="step__sub">Kleur van de lamelbehuizing.</span></span></legend>
      <div class:list={['swatches card', { 'swatches--single': single }]}>
        {m.kleuren.map((k) => (
          <label class="sw">
            <input class="sr" type="radio" name={`${uid}-k`} value={k.id} data-name={k.name} checked={k.id === startK.id} />
            <span class="sw__dot" style={`--sw:${k.hex}`} aria-hidden="true"></span>
            <span class="sw__name">{k.name}</span>
            {k.note && <span class="sw__note">{k.note}</span>}
          </label>
        ))}
        {m.kleurNote && <p class="swatches__note">{m.kleurNote}</p>}
      </div>
    </fieldset>

    <!-- Stap 3: boilervat (alleen bij all-electric) -->
    <fieldset class="step cfg__boiler" data-boiler-step>
      <legend class="step__head"><span class="step__n">3</span><span><span class="step__title">Boilervat</span><span class="step__sub">Alleen nodig bij all-electric, voor warm douche- en tapwater.</span></span></legend>
      <p class="boiler-off" data-boiler-off hidden>Bij <strong>hybride</strong> levert je cv-ketel het warme tapwater, dus een boilervat is niet nodig. Kies all-electric om een boilervat te selecteren.</p>
      <div class="opts">
        {m.boilers.map((b) => (
          <label class="opt opt--row">
            <input class="sr" type="radio" name={`${uid}-b`} value={b.id} data-price={b.price} checked={b.id === startB.id} />
            <span class="opt__body">
              <span class="opt__main">
                <span class="opt__name">{b.liters} liter {b.recommended && <span class="tag">Aanbevolen</span>}</span>
                <span class="opt__text">{b.persons} · {b.text}</span>
              </span>
              <span class="opt__plus">+ {euro(b.price)}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <aside class="isde">
      <strong>ISDE-subsidie: € [bedrag]</strong>
      <span>Indicatief, zie de actuele RVO-lijst. We helpen je met de aanvraag. <a href="/subsidie/">Meer over subsidie →</a></span>
    </aside>
  </div>
  </section>

  <ModelDetails model={m} />

  <ConfigBar
    short={m.short}
    uitvoering={startU.name}
    kleur={startK.name}
    total={startU.price == null ? null : startU.price + (startU.needsBoiler ? startB.price : 0)}
    boiler={startU.needsBoiler ? `${startB.liters} L` : ''}
    href={`/offerte/?${new URLSearchParams({ model: m.slug, uitvoering: startU.id, kleur: startK.id, ...(startU.needsBoiler ? { boiler: startB.id } : {}) })}`}
  />
</div>

<script>
  const fmt = (n: number) => '€ ' + n.toLocaleString('nl-NL');
  document.querySelectorAll<HTMLElement>('[data-cfg]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s);
    const checked = (suffix: string) => q<HTMLInputElement>(`input[name$="-${suffix}"]:checked`);
    const boilerStep = q<HTMLFieldSetElement>('[data-boiler-step]')!;
    const boilerOff = q<HTMLElement>('[data-boiler-off]')!;

    const update = () => {
      const u = checked('u')!;
      const k = checked('k')!;
      const b = checked('b');
      const needsBoiler = u.dataset.boiler === '1';

      boilerStep.disabled = !needsBoiler;
      boilerStep.classList.toggle('is-off', !needsBoiler);
      boilerOff.hidden = needsBoiler;

      const total = Number(u.dataset.price) + (needsBoiler && b ? Number(b.dataset.price) : 0);
      const params = new URLSearchParams({ model: root.dataset.model!, uitvoering: u.value, kleur: k.value });
      if (needsBoiler && b) params.set('boiler', b.value);

      const parts = [root.dataset.short, u.dataset.name, k.dataset.name];
      if (needsBoiler && b) parts.push(`${b.value} L`);

      q('[data-sum]')!.textContent = parts.join(' · ');
      q('[data-total]')!.textContent = u.dataset.price === '' ? 'Op aanvraag' : fmt(total);
      q<HTMLAnchorElement>('[data-cta]')!.href = `/offerte/?${params}`;
    };

    root.addEventListener('change', update);
    update();
  });
</script>

<style>
  .sr { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }

  /* Foto */
  .cfg__photo-wrap { padding-top: 24px; }
  .cfg__photo {
    margin: 0; padding: 20px 20px 44px; position: relative;
    background: var(--bg); aspect-ratio: 4 / 3;
    display: grid; place-items: center; overflow: hidden;
  }
  .cfg__photo :global(.cfg__img) {
    width: 84%;
    filter: drop-shadow(0 14px 14px rgba(20, 26, 46, .22));
  }
  .cfg__shown {
    position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%);
    background: rgba(255, 255, 255, .92); border: 1px solid var(--border); border-radius: 999px;
    padding: 3px 12px; font-size: .75rem; font-weight: 600; color: var(--muted); white-space: nowrap;
  }
  .cfg__facts { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .cfg__facts li { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 6px; text-align: center; display: grid; gap: 2px; }
  .cfg__facts strong { font-size: 1.05rem; color: var(--navy); }
  .cfg__facts span { font-size: .72rem; color: var(--muted); line-height: 1.2; }

  /* Stappen */
  .cfg__steps { display: grid; gap: 36px; }
  .step { border: 0; margin: 0; padding: 0; min-width: 0; }
  .step__head { display: flex; gap: 12px; align-items: flex-start; padding: 0; margin-bottom: 14px; }
  .step__n { flex: 0 0 32px; height: 32px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 800; }
  .step__title { display: block; font-family: var(--font-display); font-weight: 800; font-stretch: 75%; text-transform: uppercase; font-size: 1.5rem; line-height: 1.05; }
  .step__sub { display: block; color: var(--muted); font-size: .9rem; margin-top: 4px; }

  .opts { display: grid; gap: 10px; }
  .opts--2 { grid-template-columns: 1fr 1fr; }
  .opt { display: block; cursor: pointer; }
  .opt__body {
    position: relative; display: flex; flex-direction: column; gap: 6px; height: 100%; min-height: 44px;
    background: var(--card); border: 2px solid var(--border); border-radius: var(--radius); padding: 14px;
    box-shadow: var(--shadow); transition: border-color .15s, box-shadow .15s;
  }
  .opt input:checked + .opt__body { border-color: var(--red); box-shadow: 0 0 0 3px rgba(214, 40, 58, .12); }
  .opt input:focus-visible + .opt__body { outline: 3px solid var(--navy); outline-offset: 2px; }
  .opt__badge { align-self: flex-start; font-size: .68rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); background: var(--bg); border-radius: 4px; padding: 2px 6px; }
  .opt__name { font-weight: 800; font-size: 1.1rem; }
  .opt__text { font-size: .85rem; color: var(--muted); line-height: 1.4; flex: 1; }
  .opt__price { font-weight: 800; color: var(--navy); font-size: 1.05rem; }
  .opt__price small { font-weight: 500; font-size: .72rem; color: var(--muted); }
  .opt__check { display: none; position: absolute; top: -10px; right: 8px; background: var(--red); color: #fff; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; border-radius: 999px; padding: 2px 8px; }
  .opt input:checked + .opt__body .opt__check { display: block; }

  .opt--row .opt__body { flex-direction: row; align-items: center; gap: 12px; }
  .opt__main { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .opt__plus { font-weight: 800; color: var(--navy); white-space: nowrap; }
  .tag { display: inline-block; vertical-align: middle; margin-left: 4px; background: var(--green-soft); color: var(--green); font-size: .66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; border-radius: 4px; padding: 2px 6px; }

  /* Kleuren */
  .swatches { display: flex; justify-content: space-around; flex-wrap: wrap; gap: 12px; }
  .sw { display: grid; justify-items: center; gap: 4px; cursor: pointer; min-width: 96px; padding: 4px; text-align: center; }
  .sw__dot { width: 56px; height: 56px; border-radius: 50%; background: var(--sw); box-shadow: inset 0 0 0 3px #fff, 0 0 0 1px var(--border); transition: box-shadow .15s; }
  .sw input:checked ~ .sw__dot { box-shadow: inset 0 0 0 3px #fff, 0 0 0 3px var(--red); }
  .sw input:focus-visible ~ .sw__dot { outline: 3px solid var(--navy); outline-offset: 4px; }
  .sw__name { font-weight: 700; }
  .sw__note { font-size: .78rem; color: var(--muted); }
  .swatches--single .sw { cursor: default; }
  .swatches__note { width: 100%; text-align: center; margin: 4px 0 0; font-size: .85rem; color: var(--muted); }

  /* Boilervat uit bij hybride */
  .boiler-off { background: var(--bg); border: 1px dashed var(--border); border-radius: var(--radius); padding: 12px 14px; font-size: .9rem; color: var(--muted); margin: 0 0 10px; }
  .cfg__boiler.is-off .opts { opacity: .45; }
  .cfg__boiler.is-off .opt { cursor: not-allowed; }
  .cfg__boiler.is-off .opt input:checked + .opt__body { border-color: var(--border); box-shadow: var(--shadow); }

  .isde { display: grid; gap: 4px; background: var(--green-soft); border-radius: var(--radius); padding: 14px 16px; font-size: .88rem; }
  .isde strong { color: var(--green); font-size: 1rem; }
  .isde a { font-weight: 700; color: var(--navy); }
</style>
