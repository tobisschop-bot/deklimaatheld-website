  .dkc__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dkc__sr { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .dkc__opt { position: relative; display: block; cursor: pointer; }
  .dkc__opt-body { position: relative; height: 100%; display: flex; flex-direction: column; gap: 8px; padding: 18px; background: #fff; border: 2px solid var(--dk-line); border-radius: 14px; transition: border-color .15s, box-shadow .15s; }
