---
// Desktopversie (≥ 1024 px) van de configuratorpagina per warmtepompmodel (/warmtepompen/<model>/).
// Ontwerp "C · split-screen": links een vaste kaart met foto, kerncijfers en prijs, rechts de keuzes,
// daaronder "Wat levert het op?" (ISDE + gasbesparing) en de modelinformatie.
// Alle inhoud komt uit src/data/configurator.ts en warmtepompen.ts; de mobiele configurator blijft ongewijzigd.
import '../../styles/desktop-home.css';
import DkHeader from './DkHeader.astro';
import DkFooter from './DkFooter.astro';
import ProductImage from '../ProductImage.astro';
import { euro, warmtepompen } from '../../data/warmtepompen';
import type { ConfigModel } from '../../data/configurator';
import { AANNAMES, bereken } from '../../lib/rekenmodel';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props { model: ConfigModel }
const { model: m } = Astro.props;
const wp = warmtepompen.find((w) => w.slug === m.slug);
const isde = wp?.isde ?? null;

const startU = m.uitvoeringen[0];
const startK = m.kleuren.find((k) => k.id === m.photoColor) ?? m.kleuren[0];
const startB = m.boilers.find((b) => b.id === m.defaultBoiler) ?? m.boilers[0];
const startV = m.vermogens?.find((v) => v.id === m.defaultVermogen) ?? m.vermogens?.[0];
const single = m.kleuren.length === 1;
const toonBoiler = m.uitvoeringen.some((u) => u.needsBoiler);
const bNaam = (b: { naam?: string; liters: number }) => (b.naam ? (b.liters ? `${b.naam} ${b.liters} L` : b.naam) : `${b.liters} L`);
const bTitel = (b: { naam?: string; liters: number }) => (b.naam ? (b.liters ? `${b.naam}` : b.naam) : `${b.liters} L`);
const uid = `dkc-${m.slug}`;
let n = 0; const nr = () => ++n;

// Besparing per jaar: zelfde rekenmodel en referentiewoning als de terugverdien-meter op de homepage.
const REF = { gasM3: 1200, personen: 3, label: 'rijtjeshuis' };
const perJaar = (uitvoering: 'hybride' | 'all-electric') => {
  const u = bereken({ soort: 'lucht-water', uitvoering, gasM3: REF.gasM3, personen: REF.personen });
  return { euro: Math.round((u.nettoZonderInvestering * 12) / 10) * 10, m3: u.gasM3Bespaard };
};
const SCEN = { hybride: perJaar('hybride'), 'all-electric': perJaar('all-electric') };
const JAREN = [1, 3, 7, 10];

// Geluid (voor de decibelschaal), uit de specificaties of kerncijfers
const dbTekst = [...m.specs, ...m.quickFacts].find((f) => /dB/.test(f.value))?.value;
const db = dbTekst ? Number(dbTekst.replace(',', '.').replace(/[^0-9.]/g, '')) : null;
const dbPos = db ? Math.max(0, Math.min(100, ((db - 20) / 60) * 100)) : 0;
const schaal = [
  { db: 20, t: 'Vallende bladeren' }, { db: 30, t: 'Fluisteren' }, { db: 40, t: 'Stille bibliotheek' },
  { db: 50, t: 'Koelkast' }, { db: 60, t: 'Gesprek' }, { db: 70, t: 'Stofzuiger' }, { db: 80, t: 'Druk verkeer' },
];

// Foto's die (nog) niet in public/ staan, tonen we niet. In een Netlify-preview of lokaal tonen we een placeholder.
const heeft = (src?: string) => !!src && existsSync(join(process.cwd(), 'public', src));
const isPreview = process.env.CONTEXT !== 'production';
const galerij = (m.galerij ?? []).filter((f) => heeft(f.src));
const sfeer = m.sfeer && (heeft(m.sfeer.src) || isPreview) ? { ...m.sfeer, ok: heeft(m.sfeer.src) } : null;
const opbouw = m.opbouw && (heeft(m.opbouw.img) || isPreview) ? { ...m.opbouw, ok: heeft(m.opbouw.img) } : null;

const specsKort = 8;
const stappen = [
  { t: 'Offerte aanvragen', d: 'Je keuzes uit deze pagina gaan mee in je aanvraag.' },
  { t: 'Installatiecheck', d: 'We komen langs, bekijken je huis en rekenen het vermogen uit.' },
  { t: 'Installatie', d: 'Plaatsen, aansluiten en waterzijdig inregelen volgens de Heat Geek-methode.' },
  { t: 'Subsidie en nazorg', d: 'We helpen met de ISDE-aanvraag en blijven je aanspreekpunt.' },
];
---
<DkHeader />
<main class="dkc" data-dkc data-model={m.slug} data-short={m.short}
  data-isde={isde ?? ''} data-pj-hybride={SCEN.hybride.euro} data-pj-ae={SCEN['all-electric'].euro}
  data-m3-hybride={SCEN.hybride.m3} data-m3-ae={SCEN['all-electric'].m3}>
  <div class="dk-wrap">
    <nav class="dkc__crumbs" aria-label="Kruimelpad">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/warmtepompen/">Warmtepompen</a><span aria-hidden="true">/</span><span>{m.name}</span>
    </nav>

    <div class="dkc__split">
      <!-- LINKS: foto, kerncijfers, prijs (blijft in beeld) -->
      <aside class="dkc__side" aria-label="Product en prijs">
        <div class="dkc__card">
          <figure class="dkc__photo">
            <span class="dkc__chip" data-shown>Getoonde kleur: {startK.img ? startK.name.toLowerCase() : m.photoColor}</span>
            <span class="dkc__chip dkc__chip--dark">× HEAT GEEK</span>
            <div class="dkc__img" data-img><ProductImage src={startK.img ?? m.img} alt={m.imgAlt} loading="eager" /></div>
            {galerij.length > 0 && (
              <>
                <img class="dkc__alt" data-alt hidden src={galerij[0].src} alt="" />
                <div class="dkc__thumbs" role="group" aria-label="Foto's">
                  <button type="button" class="dkc__thumb is-on" data-thumb="" aria-label="Productfoto in gekozen kleur" aria-pressed="true"><img data-thumb-kleur src={startK.img ?? m.img} alt="" /></button>
                  {galerij.map((f) => <button type="button" class="dkc__thumb" data-thumb={f.src} data-thumb-alt={f.alt} aria-label={f.alt} aria-pressed="false"><img src={f.src} alt="" loading="lazy" /></button>)}
                </div>
              </>
            )}
          </figure>
          <dl class="dkc__facts">
            {m.quickFacts.map((f) => <div><dd>{f.value}</dd><dt>{f.label}</dt></div>)}
          </dl>
        </div>

        <div class="dkc__price">
          <div class="dkc__price-top">
            <div>
              <span class="dk-kicker dk-kicker--light">Jouw samenstelling</span>
              <p class="dkc__sum" data-sum></p>
            </div>
            <div class="dkc__total">
              <span data-lead>Totaal v.a.</span>
              <strong data-total aria-live="polite">–</strong>
            </div>
          </div>
          <div class="dkc__btns">
            <a class="dk-btn dk-btn--red" data-cta href={`/offerte/?model=${m.slug}`}>Vraag offerte aan →</a>
            <a class="dk-btn dkc__btn-soft" href="/#besparingscheck">Doe de besparingscheck</a>
          </div>
          <a class="dkc__netline" href="#dkc-besparing" data-netline>
            <span><span data-netlabel>Nog te verdienen na 3 jaar</span>, incl. ISDE <b data-netshort></b></span>
            <span class="dkc__netlink">Bekijk berekening ↓</span>
          </a>
          <p class="dkc__note">Indicatieve v.a.-prijs incl. montage. Je krijgt altijd een offerte op maat.</p>
        </div>
      </aside>

      <!-- RECHTS: keuzes -->
      <div class="dkc__main">
        <header class="dkc__intro">
          <span class="dk-kicker">{wp?.merk ?? 'Warmtepomp'} · stel samen</span>
          <h1>{m.short}</h1>
          <p>{m.lead}</p>
        </header>

        <fieldset class="dkc__step">
          <legend><span class="dkc__n">{nr()}</span>Kies je uitvoering</legend>
          <div class:list={['dkc__grid', { 'dkc__grid--2': m.uitvoeringen.length > 1 }]}>
            {m.uitvoeringen.map((u) => (
              <label class="dkc__opt">
                <input class="dkc__sr" type="radio" name={`${uid}-u`} value={u.id} data-price={u.price ?? ''} data-boiler={u.needsBoiler ? '1' : '0'} data-name={u.name} checked={u.id === startU.id} />
                <span class="dkc__opt-body">
                  <span class="dkc__opt-head"><span class="dkc__opt-name">{u.name}</span><span class:list={['dkc__badge', { 'is-green': u.needsBoiler }]}>{u.badge}</span></span>
                  <span class="dkc__opt-text">{u.text}</span>
                  {m.vermogens ? null : <span class="dkc__opt-price">{u.price != null ? `v.a. ${euro(u.price)}${u.needsBoiler ? ' + boilervat' : ''}` : 'Prijs op aanvraag'}</span>}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {m.vermogens && startV && (
          <fieldset class="dkc__step">
            <legend><span class="dkc__n">{nr()}</span>Kies het vermogen</legend>
            <p class="dkc__sub">Twijfel je? Het juiste vermogen berekenen we bij de installatiecheck.</p>
            <div class="dkc__grid dkc__grid--3">
              {m.vermogens.map((v) => (
                <label class="dkc__opt">
                  <input class="dkc__sr" type="radio" name={`${uid}-v`} value={v.id} data-name={v.label} data-prijs={JSON.stringify(v.prijs ?? {})} checked={v.id === startV.id} />
                  <span class="dkc__opt-body">
                    <span class="dkc__opt-name">{v.label}</span>
                    <span class="dkc__opt-text">{v.sub}</span>
                    <span class="dkc__opt-price" data-vprijs></span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <fieldset class="dkc__step">
          <legend><span class="dkc__n">{nr()}</span>Kies de afwerking</legend>
          <div class:list={['dkc__grid', { 'dkc__grid--2': m.kleuren.length === 2, 'dkc__grid--3': m.kleuren.length > 2 }]}>
            {m.kleuren.map((k) => (
              <label class="dkc__opt">
                <input class="dkc__sr" type="radio" name={`${uid}-k`} value={k.id} data-name={k.name} data-img={k.img ?? ''} checked={k.id === startK.id} />
                <span class="dkc__opt-body dkc__opt-body--row">
                  <span class="dkc__swatch" style={`--sw:${k.hex}`} aria-hidden="true"></span>
                  <span><span class="dkc__opt-name">{k.name}</span>{k.note && <span class="dkc__opt-text">{k.note}</span>}</span>
                </span>
              </label>
            ))}
          </div>
          {single && m.kleurNote && <p class="dkc__after">{m.kleurNote}</p>}
        </fieldset>

        {m.bediening && (
          <fieldset class="dkc__step">
            <legend><span class="dkc__n">{nr()}</span>{m.bediening.titel}</legend>
            <p class="dkc__sub">{m.bediening.sub}</p>
            <div class="dkc__grid dkc__grid--3">
              {m.bediening.opties.map((o, i) => (
                <label class="dkc__opt">
                  <input class="dkc__sr" type="radio" name={`${uid}-c`} value={o.id} data-name={`Madoka ${o.naam.toLowerCase()}`} checked={i === 0} />
                  <span class="dkc__opt-body dkc__opt-body--tile">
                    <img src={o.img} alt={`Daikin Madoka ${o.naam.toLowerCase()}`} width="300" height="300" loading="lazy" />
                    <span class="dkc__opt-name">{o.naam}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        {toonBoiler && (
          <fieldset class="dkc__step" data-boiler-step>
            <legend><span class="dkc__n" data-boiler-n>{nr()}</span>{m.boilers.some((b) => b.naam) ? 'Kies je buffer' : 'Kies je boilervat'}</legend>
            <p class="dkc__sub" data-boiler-sub>Voor je warme tapwater. Kies op basis van je huishouden.</p>
            <div class="dkc__grid dkc__grid--3">
              {m.boilers.map((b) => {
                const h = b.liters ? Math.min(58, 34 + b.liters / 12) : 46;
                return (
                  <label class="dkc__opt">
                    <input class="dkc__sr" type="radio" name={`${uid}-b`} value={b.id} data-price={b.price ?? ''} data-name={bNaam(b)} checked={b.id === startB.id} />
                    <span class="dkc__opt-body dkc__opt-body--row">
                      {b.recommended && <span class="dkc__rec">Aanbevolen</span>}
                      <svg class="dkc__vat" width="34" height="64" viewBox="0 0 34 64" aria-hidden="true"><rect x="2" y={62 - h} width="30" height={h} rx="13" fill="#fff" stroke="#141A2E" stroke-width="2"></rect><rect class="dkc__water" x="5" y={59 - (h - 6) * 0.85} width="24" height={(h - 6) * 0.85} rx="10" fill="#CFE0F5" style={`--lo:${(h - 6) * 0.65}px`}></rect></svg>
                      <span>
                        <span class="dkc__opt-name">{bTitel(b)}</span>
                        <span class="dkc__opt-text">{b.persons}</span>
                        <span class="dkc__opt-price">{b.price == null ? 'Op aanvraag' : `+ ${euro(b.price)}`}</span>
                      </span>
                    </span>
                  </label>
                );
              })}
            </div>
          </fieldset>
        )}

        <!-- Wat levert het op? -->
        <section id="dkc-besparing" class="dkc__bes" aria-labelledby="dkc-bes-h">
          <div class="dkc__bes-head">
            <div>
              <span class="dk-kicker">Wat levert het op?</span>
              <h2 id="dkc-bes-h">Aanschaf min subsidie en besparing</h2>
            </div>
            <div class="dkc__jaren" role="group" aria-label="Periode">
              {JAREN.map((y) => <button type="button" data-jaar={y} aria-pressed={y === 3 ? 'true' : 'false'}>{y} jaar</button>)}
            </div>
          </div>
          <div data-bes-on>
            <dl class="dkc__cijfers">
              <div><dt>Aanschaf v.a.</dt><dd data-b="prijs"></dd></div>
              <div><dt>ISDE-subsidie</dt><dd class="is-green" data-b="isde"></dd></div>
              <div><dt>Gasbesparing <span data-b="jl"></span></dt><dd class="is-green" data-b="gas"></dd></div>
              <div><dt data-b="restlabel">Nog te verdienen</dt><dd class="is-strong" data-b="rest"></dd></div>
            </dl>
            <div class="dkc__balk" aria-hidden="true"><span class="is-isde" data-b="bisde"></span><span class="is-gas" data-b="bgas"></span></div>
            <div class="dkc__legenda" aria-hidden="true"><span><i class="is-isde"></i>ISDE-subsidie</span><span><i class="is-gas"></i>Gasbesparing <span data-b="jl2"></span></span><span><i class="is-rest"></i>Nog te verdienen</span></div>
            <p class="dkc__uitkomst" data-b="uitkomst"></p>
            <p class="dkc__voetnoot">
              Indicatief. Netto besparing = minder gas min extra stroom, voor een {REF.label} met {REF.gasM3.toLocaleString('nl-NL')} m³ gas per jaar en {REF.personen} personen,
              gas € {AANNAMES.gasprijs.toFixed(2).replace('.', ',')}/m³ en stroom € {AANNAMES.stroomprijs.toFixed(2).replace('.', ',')}/kWh (zelfde rekenmodel als de besparingscheck).
              Hybride ± {euro(SCEN.hybride.euro)} per jaar, all-electric ± {euro(SCEN['all-electric'].euro)} per jaar. Energieprijzen gelijk gehouden; onderhoud niet meegerekend.
              {isde != null ? ' ISDE is het maximale bedrag volgens de RVO-lijst.' : ''} Je eigen besparing zie je in de besparingscheck.
            </p>
          </div>
          <p class="dkc__opaanvraag" data-bes-off hidden>Bij deze keuze is de prijs op aanvraag. Je besparing en terugverdientijd rekenen we voor je uit in de offerte.</p>
        </section>
      </div>
    </div>
  </div>

  <!-- MODELINFORMATIE -->
  <div class="dkc__info">
    <div class="dk-wrap dkc__info-wrap">
      {m.waarom.length > 0 && (
        <section aria-labelledby="dkc-w-h">
          <span class="dk-kicker">Waarom deze?</span>
          <h2 id="dkc-w-h" class="dkc__h2">Waarom kiezen voor de {m.short}?</h2>
          <div class:list={['dkc__waarom', `is-${Math.min(4, m.waarom.length)}`]}>
            {m.waarom.map((w) => (
              <div class="dkc__wcard">
                <h3>{w.title}</h3>
                <p>{w.text}</p>
                {w.check && <span class="dkc__check">✓ {w.check}</span>}
              </div>
            ))}
          </div>
        </section>
      )}

      {opbouw && (
        <section class="dkc__opbouw" aria-labelledby="dkc-o-h" data-opbouw>
          <div>
            <span class="dk-kicker">Binnenkant</span>
            <h2 id="dkc-o-h" class="dkc__h2">Zo is de {m.short} opgebouwd</h2>
          </div>
          <div class="dkc__opbouw-grid">
            <div class="dkc__opbouw-beeld">
              <div class="dkc__opbouw-fig">
                {opbouw.ok
                  ? <img src={opbouw.img} alt={opbouw.alt} loading="lazy" />
                  : <div class="dkc__placeholder">Foto volgt: {opbouw.img.split('/').pop()}<br /><small>(alleen zichtbaar in de preview)</small></div>}
                {opbouw.onderdelen.map((o, i) => (
                  <button type="button" class="dkc__dot" style={`left:${o.x}%;top:${o.y}%`} data-dot={i} aria-label={`${i + 1}. ${o.titel}`}>{i + 1}</button>
                ))}
              </div>
            </div>
            <ol class="dkc__onderdelen">
              {opbouw.onderdelen.map((o, i) => (
                <li data-part={i} class:list={{ 'is-on': i === 0 }}><h3>{i + 1}. {o.titel}</h3><p>{o.tekst}</p></li>
              ))}
            </ol>
          </div>
        </section>
      )}

      {sfeer && (
        <figure class="dkc__sfeer">
          {sfeer.ok
            ? <img src={sfeer.src} alt={sfeer.alt} loading="lazy" />
            : <div class="dkc__placeholder">Foto volgt: {sfeer.src.split('/').pop()}<br /><small>(alleen zichtbaar in de preview)</small></div>}
          {sfeer.caption && <figcaption>{sfeer.caption}</figcaption>}
        </figure>
      )}

      {db && (
        <section class="dkc__geluid" aria-labelledby="dkc-g-h">
          <div class="dkc__geluid-head">
            <div><span class="dk-kicker">Geluid</span><h2 id="dkc-g-h" class="dkc__h2 dkc__h2--s">Stiller dan je denkt</h2></div>
            <p>Een goede plek en een stevige ondergrond maken het verschil. Waar hij het best kan staan, bekijken we samen bij de installatiecheck.</p>
          </div>
          <div class="dkc__schaal">
            <div class="dkc__marker" style={`left:${dbPos}%`}><span>{m.short} · {dbTekst}</span><i aria-hidden="true"></i></div>
            <div class="dkc__schaal-balk" aria-hidden="true"></div>
            <ul>{schaal.map((s) => <li><b>{s.db} dB</b>{s.t}</li>)}</ul>
          </div>
        </section>
      )}

      {m.specs.length > 0 && (
        <section class="dkc__2col" aria-labelledby="dkc-s-h">
          <div>
            <span class="dk-kicker">Specificaties</span>
            <h2 id="dkc-s-h" class="dkc__h2">Technische gegevens</h2>
            <p class="dkc__lead">De belangrijkste cijfers van de {m.short} op een rij. Of hij past bij jouw huis, rekenen we bij de installatiecheck voor je uit.</p>
          </div>
          <div class="dkc__specs" data-specs>
            <dl>
              {m.specs.map((s, i) => <div class:list={{ 'is-extra': i >= specsKort }}><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
            </dl>
            {m.specs.length > specsKort && <button type="button" data-specs-btn aria-expanded="false">Toon alle {m.specs.length} specificaties ↓</button>}
          </div>
        </section>
      )}

      <section class="dkc__inbegrepen" aria-labelledby="dkc-i-h">
        <div>
          <span class="dk-kicker dk-kicker--light">De Klimaatheld × Heat Geek</span>
          <h2 id="dkc-i-h" class="dkc__h2">Inbegrepen in de offerte</h2>
          <p>Geen losse posten achteraf. Dit zit standaard in je offerte.</p>
        </div>
        <ul>
          {m.inbegrepen.map((f) => <li><b>{f.value}</b><span>{f.label}</span></li>)}
        </ul>
      </section>

      <section aria-labelledby="dkc-z-h">
        <span class="dk-kicker">Zo werkt het</span>
        <h2 id="dkc-z-h" class="dkc__h2">Van aanvraag tot warm huis</h2>
        <ol class="dkc__stappen">
          {stappen.map((s, i) => <li class:list={{ 'is-first': i === 0 }}><span>0{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p></li>)}
        </ol>
      </section>

      {m.faq.length > 0 && (
        <section class="dkc__2col" aria-labelledby="dkc-f-h">
          <div>
            <span class="dk-kicker">Veelgestelde vragen</span>
            <h2 id="dkc-f-h" class="dkc__h2">Vragen over de {m.short}</h2>
            <p class="dkc__lead">Staat je vraag er niet bij? <a href="/offerte/">Stel hem bij je aanvraag</a>, we denken graag mee.</p>
          </div>
          <div class="dkc__faq">
            {m.faq.map((f, i) => (
              <details open={i === 0}>
                <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>

    <section class="dkc__cta" aria-labelledby="dkc-cta-h">
      <div class="dk-wrap dkc__cta-wrap">
        <div>
          <span class="dk-kicker dk-kicker--light">Besparingscheck</span>
          <h2 id="dkc-cta-h" class="dkc__h2">Hoeveel kan jij besparen?</h2>
          <p>Vul je gasverbruik en huistype in en zie wat de {m.short} voor jou betekent. Of vraag direct een offerte aan.</p>
        </div>
        <div class="dkc__cta-btns">
          <a class="dk-btn dkc__btn-soft" href="/#besparingscheck">Doe de besparingscheck</a>
          <a class="dk-btn dk-btn--red" data-cta href={`/offerte/?model=${m.slug}`}>Vraag offerte aan →</a>
        </div>
      </div>
    </section>
  </div>
</main>
<DkFooter />

<script>
  const eur = (n: number) => '€ ' + Math.round(n).toLocaleString('nl-NL');
  const komma = (n: number) => n.toLocaleString('nl-NL', { maximumFractionDigits: 1 });
  document.querySelectorAll<HTMLElement>('[data-dkc]').forEach((root) => {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s);
    const checked = (suffix: string) => q<HTMLInputElement>(`input[name$="-${suffix}"]:checked`);
    const b = (k: string) => q(`[data-b="${k}"]`)!;
    const isde = root.dataset.isde ? Number(root.dataset.isde) : 0;
    const jaarBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-jaar]')];
    let jaar = 3;

    const alt = q<HTMLImageElement>('[data-alt]');
    const toonFoto = (src: string) => {
      if (!alt) return;
      alt.hidden = !src;
      if (src) alt.src = src;
      q('[data-img]')!.style.visibility = src ? 'hidden' : '';
      q('[data-shown]')!.style.visibility = src ? 'hidden' : '';
      root.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((t) => {
        const on = t.dataset.thumb === src;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-pressed', String(on));
      });
    };
    root.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((t) => t.addEventListener('click', () => toonFoto(t.dataset.thumb!)));

    // Opbouw: stip en kaart lichten samen op
    const parts = [...root.querySelectorAll<HTMLElement>('[data-part]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const kies = (i: number) => {
      parts.forEach((p, j) => p.classList.toggle('is-on', i === j));
      dots.forEach((d, j) => { d.classList.toggle('is-on', i === j); d.setAttribute('aria-pressed', String(i === j)); });
    };
    dots.forEach((d, i) => { d.addEventListener('mouseenter', () => kies(i)); d.addEventListener('focus', () => kies(i)); d.addEventListener('click', () => kies(i)); });
    parts.forEach((p, i) => p.addEventListener('mouseenter', () => kies(i)));
    if (dots.length) kies(0);

    const update = (e?: Event) => {
      const u = checked('u')!, k = checked('k')!, bo = checked('b'), v = checked('v'), c = checked('c');
      const needsBoiler = u.dataset.boiler === '1';
      let base: number | null = u.dataset.price === '' ? null : Number(u.dataset.price);
      if (v) {
        base = JSON.parse(v.dataset.prijs || '{}')[u.value] ?? null;
        root.querySelectorAll<HTMLInputElement>('input[name$="-v"]').forEach((i) => {
          const p = JSON.parse(i.dataset.prijs || '{}')[u.value];
          i.closest('label')!.querySelector('[data-vprijs]')!.textContent = p == null ? 'Op aanvraag' : 'v.a. ' + eur(p);
        });
      }
      const bPrice = needsBoiler && bo ? (bo.dataset.price === '' ? null : Number(bo.dataset.price)) : 0;
      const total = base == null || bPrice == null ? null : base + bPrice;

      // Boilerstap aan/uit
      const step = q<HTMLFieldSetElement>('[data-boiler-step]');
      if (step) {
        step.disabled = !needsBoiler;
        step.classList.toggle('is-off', !needsBoiler);
        q('[data-boiler-sub]')!.textContent = needsBoiler ? 'Voor je warme tapwater. Kies op basis van je huishouden.' : 'Niet nodig bij hybride: je cv-ketel levert het warme tapwater.';
      }

      // Foto wisselt mee met de kleur (korte fade)
      const holder = q('[data-img]');
      const img = holder?.querySelector('img');
      if (img && k.dataset.img && !img.src.endsWith(k.dataset.img)) {
        holder!.classList.add('is-fade');
        setTimeout(() => { img.src = k.dataset.img!; img.onload = () => holder!.classList.remove('is-fade'); }, 160);
      }
      const tk = q<HTMLImageElement>('[data-thumb-kleur]');
      if (tk && k.dataset.img) tk.src = k.dataset.img;
      if (e?.target instanceof HTMLInputElement && e.target.name.endsWith('-k')) toonFoto('');
      if (k.dataset.img) q('[data-shown]')!.textContent = `Getoonde kleur: ${k.dataset.name!.toLowerCase()}`;

      // Samenvatting, prijs, offertelink
      const parts = [root.dataset.short, u.dataset.name, v?.dataset.name, k.dataset.name, c?.dataset.name];
      if (needsBoiler && bo) parts.push(bo.dataset.name!);
      q('[data-sum]')!.textContent = parts.filter(Boolean).join(' · ');
      q('[data-lead]')!.textContent = total == null ? 'Prijs' : 'Totaal v.a.';
      q('[data-total]')!.textContent = total == null ? 'Op aanvraag' : eur(total);
      const params = new URLSearchParams({ model: root.dataset.model!, uitvoering: u.value });
      if (v) params.set('vermogen', v.dataset.name!);
      params.set('kleur', k.value);
      if (c) params.set('bediening', c.dataset.name!);
      if (needsBoiler && bo) params.set('boiler', bo.value);
      root.querySelectorAll<HTMLAnchorElement>('[data-cta]').forEach((a) => (a.href = `/offerte/?${params}`));

      // Besparing: aanschaf − ISDE − gasbesparing over de gekozen periode
      const ae = u.value === 'all-electric';
      const pj = Number(ae ? root.dataset.pjAe : root.dataset.pjHybride);
      const on = total != null && pj > 0;
      q('[data-bes-on]')!.hidden = !on;
      q('[data-bes-off]')!.hidden = on;
      q('[data-netline]')!.hidden = !on;
      if (!on) return;
      const sub = Math.min(isde, total!);
      const gas = pj * jaar;
      const rest = total! - sub - gas;
      const terug = Math.max(0, (total! - sub) / pj);
      const jl = jaar + ' jaar';
      b('prijs').textContent = eur(total!);
      b('isde').textContent = isde ? '− ' + eur(sub) : 'n.v.t.';
      b('gas').textContent = '− ' + eur(gas);
      b('jl').textContent = jl; b('jl2').textContent = jl;
      b('restlabel').textContent = rest > 0 ? 'Nog te verdienen' : 'Terugverdiend';
      b('rest').textContent = rest > 0 ? eur(rest) : '+ ' + eur(-rest);
      b('bisde').style.width = ((sub / total!) * 100).toFixed(1) + '%';
      b('bgas').style.width = ((Math.min(gas, total! - sub) / total!) * 100).toFixed(1) + '%';
      b('uitkomst').textContent = rest > 0
        ? `Met ISDE en ${jl} gasbesparing staat er nog ± ${eur(rest)} open. Terugverdiend na ± ${komma(terug)} jaar.`
        : `Na ${jl} is hij terugverdiend (na ± ${komma(terug)} jaar) en houd je ± ${eur(-rest)} over.`;
      q('[data-netlabel]')!.textContent = (rest > 0 ? 'Nog te verdienen na ' : 'Terugverdiend na ') + jl;
      q('[data-netshort]')!.textContent = rest > 0 ? eur(rest) : '+ ' + eur(-rest);
    };

    jaarBtns.forEach((btn) => btn.addEventListener('click', () => {
      jaar = Number(btn.dataset.jaar);
      jaarBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
      update();
    }));
    root.querySelectorAll<HTMLInputElement>('input[data-img]').forEach((i) => { if (i.dataset.img) new Image().src = i.dataset.img; });
    root.addEventListener('change', (e) => update(e));
    update();

    // Specificaties uitklappen
    const sb = q<HTMLButtonElement>('[data-specs-btn]');
    const sbLabel = sb?.textContent ?? '';
    sb?.addEventListener('click', () => {
      const open = q('[data-specs]')!.classList.toggle('is-open');
      sb.setAttribute('aria-expanded', String(open));
      sb.textContent = open ? 'Toon minder ↑' : sbLabel;
    });
  });
</script>

<style>
  .dkc { background: var(--dk-bg); color: var(--dk-navy); padding-top: 20px; }
