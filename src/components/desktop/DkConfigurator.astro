  .dkc__img { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; transition: opacity .18s; filter: drop-shadow(0 16px 16px rgba(20,26,46,.22)); }
  .dkc__img :global(.pi) { width: auto; height: 100%; max-width: 82%; }
  .dkc__img :global(.pi-box) { width: 82%; height: 100%; }
  .dkc__img.is-fade { opacity: 0; }
  .dkc__alt { position: absolute; inset: 24px 48px 56px; width: calc(100% - 96px); height: calc(100% - 80px); object-fit: contain; }
  .dkc__thumbs { position: absolute; left: 16px; bottom: 16px; display: flex; gap: 6px; z-index: 1; }
  .dkc__thumb { width: 52px; height: 52px; padding: 4px; border-radius: 10px; border: 2px solid var(--dk-line); background: #fff; cursor: pointer; }
  .dkc__thumb img { width: 100%; height: 100%; object-fit: contain; }
  .dkc__thumb.is-on { border-color: var(--dk-red); }
  .dkc__chip { position: absolute; top: 16px; left: 16px; font-size: 12px; font-weight: 700; padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--dk-line); z-index: 1; }
  .dkc__chip--dark { left: auto; right: 16px; background: var(--dk-navy); color: #fff; border-color: var(--dk-navy); font-weight: 800; letter-spacing: .08em; font-size: 11px; }
  .dkc__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--dk-line); }
