  .dkc__dot.is-on { background: var(--dk-red); transform: translate(-50%, -50%) scale(1.12); }
  .dkc__onderdelen { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .dkc__onderdelen li { padding: 18px 22px; border-radius: 14px; border: 2px solid var(--dk-line); background: #fff; transition: border-color .15s, box-shadow .15s; }
  .dkc__onderdelen li.is-on { border-color: var(--dk-red); box-shadow: 0 0 0 4px #FBE3E5; }
  .dkc__onderdelen h3 { font-size: 18px; font-weight: 800; }
  .dkc__onderdelen p { margin-top: 4px !important; font-size: 15px; line-height: 1.55; color: var(--dk-muted); }
  .dkc__sfeer { margin: 0; }
  .dkc__sfeer img, .dkc__sfeer .dkc__placeholder { width: 100%; height: 460px; object-fit: cover; border-radius: 18px; display: block; }
  .dkc__sfeer figcaption { margin-top: 10px; font-size: 13px; color: var(--dk-muted); }
  .dkc__placeholder { width: 100%; min-height: 440px; border: 2px dashed #C9CFDA; border-radius: 14px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: var(--dk-muted); font-weight: 700; background: repeating-linear-gradient(45deg, #F4F6F9 0 12px, #EEF1F6 12px 24px); }
  .dkc__placeholder small { font-weight: 500; }
  .dkc__geluid { background: var(--dk-bg); border-radius: 18px; padding: 40px 44px; }
