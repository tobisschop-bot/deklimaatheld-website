  .dkc__sr:focus-visible + .dkc__opt-body { outline: 3px solid #FFB020; outline-offset: 2px; }
  .dkc__sr:disabled + .dkc__opt-body { cursor: not-allowed; }
  .dkc__opt-body--row { flex-direction: row; align-items: center; gap: 14px; }
  .dkc__opt-body--tile { align-items: center; text-align: center; }
  .dkc__opt-body--tile img { width: 100%; max-width: 120px; height: auto; }
  .dkc__opt-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .dkc__opt-name { display: block; font-size: 19px; font-weight: 900; font-stretch: 75%; text-transform: uppercase; }
  .dkc__opt-text { display: block; font-size: 14px; line-height: 1.45; color: var(--dk-muted); }
  .dkc__opt-price { display: block; font-size: 15px; font-weight: 800; margin-top: auto; }
  .dkc__badge { font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: #EEF1F6; color: var(--dk-navy); white-space: nowrap; }
  .dkc__badge.is-green { background: #E3F4EC; color: #13744C; }
  .dkc__swatch { width: 48px; height: 48px; flex: none; border-radius: 12px; background: var(--sw); box-shadow: inset 0 0 0 1px rgba(0,0,0,.1); }
