  .dkc__facts dd { margin: 0; font-size: 22px; font-weight: 900; font-stretch: 75%; }

  .dkc__price { background: var(--dk-navy); color: #fff; border-radius: 18px; padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; }
  .dkc__price-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .dkc__sum { margin-top: 6px !important; font-size: 15px; color: rgba(255,255,255,.85); }
  .dkc__total { text-align: right; flex: none; }
  .dkc__total span { display: block; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .dkc__total strong { display: block; font-size: 40px; line-height: 1; font-weight: 900; font-stretch: 72%; white-space: nowrap; }
  .dkc__btns { display: flex; gap: 10px; }
