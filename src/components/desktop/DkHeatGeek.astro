---
// "Ontworpen, niet gegokt": Heat Geek-methode
const pijlers = [
  { t: 'Warmteverlies per kamer', d: 'Geen vuistregel, maar een berekening per ruimte. Zo kies je het juiste vermogen, niet te groot en niet te klein.', icon: 'M3 10 12 3l9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1ZM12 21v-8M3 13h18' },
  { t: 'Ontwerpen op lage temperatuur', d: 'Radiatoren en vloerverwarming afgestemd op een lage aanvoertemperatuur. Hoe lager, hoe hoger de COP.', icon: 'M14 14.8V4a2 2 0 0 0-4 0v10.8a4 4 0 1 0 4 0ZM12 10v6' },
  { t: 'Waterzijdig inregelen', d: 'Elke radiator krijgt precies de juiste hoeveelheid water. Overal even warm, en de warmtepomp draait rustig.', icon: 'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6' },
];
const rijen = [
  ['Vermogen bepalen', 'Vuistregel per m²', 'Berekend per kamer'],
  ['Aanvoertemperatuur', 'Zoals de oude ketel', 'Zo laag mogelijk'],
  ['Inregeling', 'Vaak niet', 'Waterzijdig, per radiator'],
];
---
<section class="dkhg">
  <div class="dk-wrap">
    <div class="dkhg__kader">
      <div class="dkhg__top">
        <div>
          <div class="dkhg__merk"><span class="dkhg__logo"><img src="/img/heatgeek-logo.png" alt="Heat Geek" width="360" height="149" /></span><span class="dk-kicker dk-kicker--light">De Klimaatheld × Heat Geek</span></div>
          <h2 class="dk-h2">Ontworpen, <span class="dk-red-l">niet gegokt</span></h2>
          <p class="dkhg__lead">Een warmtepomp is zo zuinig als het ontwerp eromheen. Daarom werken wij volgens de Heat Geek-methode: we rekenen je huis kamer voor kamer door en stellen het hele systeem af op een zo laag mogelijke temperatuur.</p>
          <p class="dkhg__klein">Heat Geek is een opleidings- en kwaliteitsnetwerk voor warmtepompinstallateurs, met uitgebreide training in warmteverlies, hydraulica en systeemontwerp, afgesloten met een praktijktoets.</p>
        </div>
        <figure class="dkhg__grafiek">
          <span class="dk-kicker">Meer rendement</span>
          <p class="dkhg__gtitel">COP bij buitentemperatuur</p>
          <svg viewBox="0 -26 310 226" role="img" aria-label="Grafiek: COP van een Heat Geek-ontwerp ligt hoger dan bij een standaard installateur" font-family="Archivo,sans-serif" font-size="10" fill="#5A6475"><path d="M40 160H300M40 125H300M40 90H300M40 55H300M40 20H300" stroke="#E3E7ED"/><text x="32" y="164" text-anchor="end">2</text><text x="32" y="129" text-anchor="end">3</text><text x="32" y="94" text-anchor="end">4</text><text x="32" y="59" text-anchor="end">5</text><text x="32" y="24" text-anchor="end">6</text><text x="40" y="178" text-anchor="middle">-10°</text><text x="92" y="178" text-anchor="middle">-5°</text><text x="144" y="178" text-anchor="middle">0°</text><text x="196" y="178" text-anchor="middle">5°</text><text x="248" y="178" text-anchor="middle">10°</text><text x="300" y="178" text-anchor="middle">15°</text><polygon points="40,132 92,111 144,90 196,69 248,52 300,38 300,94 248,104 196,118 144,132 92,146 40,160" fill="#D6283A" opacity=".08"/><polyline points="40,160 92,146 144,132 196,118 248,104 300,94" fill="none" stroke="#9AA3B2" stroke-width="2.5" stroke-dasharray="5 4" stroke-linecap="round"/><polyline points="40,132 92,111 144,90 196,69 248,52 300,38" fill="none" stroke="#D6283A" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="300" cy="38" r="4.5" fill="#D6283A" stroke="#fff" stroke-width="2"/><text x="40" y="196">Buitentemperatuur</text><text x="40" y="10">COP</text></svg>
          <figcaption><span><i class="is-rood"></i>Heat Geek-ontwerp</span><span><i></i>Standaard installateur</span><span class="dkhg__ind">Indicatief</span></figcaption>
        </figure>
      </div>
      <ol class="dkhg__pijlers">
        {pijlers.map((p, i) => (
          <li><div class="dkhg__pkop"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#FF8A95" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.icon} /></svg><span>{'0' + (i + 1)}</span></div><h3>{p.t}</h3><p>{p.d}</p></li>
        ))}
      </ol>
      <div class="dkhg__onder">
        <div class="dkhg__tabel">
          <table>
            <thead><tr><th scope="col"></th><th scope="col">Standaard</th><th scope="col" class="is-rood">Heat Geek-ontwerp</th></tr></thead>
            <tbody>
              {rijen.map((r) => <tr><th scope="row">{r[0]}</th><td class="is-grijs">{r[1]}</td><td>{r[2]}</td></tr>)}
              <tr><th scope="row">Resultaat</th><td class="is-grijs">Lagere COP, hoger verbruik</td><td class="is-groen">Hogere COP, lagere rekening</td></tr>
            </tbody>
          </table>
        </div>
        <a class="dkhg__case" href="/verduurzamen/">
          <img src="/img/werk-installatie-binnen.webp" alt="Heat Geek-ontworpen installatie met boiler- en buffervat" loading="lazy" />
          <span class="dkhg__case-tekst"><span class="dk-kicker dk-kicker--light">Ons werk</span><strong>Bekijk onze installaties →</strong></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .dkhg { background: #fff; color: #141A2E; padding-bottom: 120px; }
  .dkhg__kader { background: radial-gradient(70% 60% at 100% 0%, rgba(214,40,58,.3), rgba(214,40,58,0) 60%), #141A2E; color: #fff; border-radius: 28px; padding: 64px 56px; overflow: hidden; }
  .dkhg__top { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .dkhg__merk { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
  .dkhg__logo { background: #fff; border-radius: 10px; padding: 8px 12px; }
  .dkhg__logo img { height: 34px; width: auto; }
  .dkhg__top .dk-h2 { margin-bottom: 20px; font-size: clamp(60px, 5.4vw, 80px); }
  .dkhg__lead { font-size: 18px; line-height: 1.6; color: #C9CFDA; max-width: 520px; margin-bottom: 14px !important; }
  .dkhg__klein { font-size: 15px; line-height: 1.6; color: #9AA3B2; max-width: 520px; }
  .dkhg__grafiek { margin: 0; background: #fff; color: #141A2E; border-radius: 18px; padding: 24px; }
  .dkhg__gtitel { font-size: 22px; font-weight: 900; font-stretch: 80%; text-transform: uppercase; margin: 4px 0 8px !important; }
  .dkhg__grafiek svg { width: 100%; height: auto; display: block; }
  .dkhg__grafiek figcaption { display: flex; flex-wrap: wrap; gap: 18px; font-size: 13px; margin-top: 6px; }
  .dkhg__grafiek figcaption span { display: flex; align-items: center; gap: 8px; }
  .dkhg__grafiek i { display: inline-block; width: 20px; height: 3px; background: #9AA3B2; }
  .dkhg__grafiek i.is-rood { background: #D6283A; }
  .dkhg__ind { color: #5A6475; }
  .dkhg__pijlers { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .dkhg__pijlers li { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 18px; padding: 28px; }
  .dkhg__pkop { display: flex; justify-content: space-between; align-items: center; }
  .dkhg__pkop span { font-size: 40px; font-weight: 900; font-stretch: 62%; color: rgba(255,255,255,.25); }
  .dkhg__pijlers h3 { margin: 16px 0 8px; font-size: 26px; font-weight: 900; font-stretch: 75%; text-transform: uppercase; color: #fff; }
  .dkhg__pijlers p { font-size: 15px; line-height: 1.6; color: #C9CFDA; }
  .dkhg__onder { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; margin-top: 16px; }
  .dkhg__tabel { background: #fff; color: #141A2E; border-radius: 18px; padding: 8px 28px; }
  .dkhg__tabel table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .dkhg__tabel thead th { text-align: left; padding: 18px 12px 12px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: #5A6475; }
  .dkhg__tabel thead th.is-rood { color: #D6283A; }
  .dkhg__tabel tbody tr { border-top: 1px solid #E3E7ED; }
  .dkhg__tabel tbody th { text-align: left; padding: 14px 0; font-weight: 800; }
  .dkhg__tabel td { padding: 14px 12px; font-weight: 700; }
  .dkhg__tabel td.is-grijs { color: #5A6475; font-weight: 400; }
  .dkhg__tabel td.is-groen { color: #1A7D55; font-weight: 800; }
  .dkhg__case { position: relative; display: block; min-height: 280px; border-radius: 18px; overflow: hidden; text-decoration: none; color: #fff; }
  .dkhg__case img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dkhg__case::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(11,19,43,.92) 0%, rgba(11,19,43,0) 65%); }
  .dkhg__case-tekst { position: absolute; left: 22px; right: 22px; bottom: 22px; z-index: 1; display: grid; gap: 4px; }
  .dkhg__case-tekst strong { font-size: 22px; font-weight: 900; font-stretch: 78%; text-transform: uppercase; }
</style>
