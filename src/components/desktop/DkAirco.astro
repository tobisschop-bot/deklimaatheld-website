  .dka button { font-family: inherit; }
  .dka button:focus-visible, .dka a:focus-visible, .dka input:focus-visible + *, .dka select:focus-visible, .dka summary:focus-visible { outline: 3px solid #D6283A; outline-offset: 3px; }
  .dka-sr { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
