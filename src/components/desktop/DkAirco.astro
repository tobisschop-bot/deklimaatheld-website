  .dka-stage__kern span { color: #5A6475; }

  /* stap 1 */
  .dka-modes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .dka-mode { cursor: pointer; text-align: left; border-radius: 16px; padding: 16px 18px; display: flex; gap: 14px; align-items: center; font-size: 16px; }
