  .dka-mode__t strong { font-size: 18px; }
  .dka-mode__t span { font-size: 14px; }
  .dka-mode--single { background: #fff; border: 2px solid #E3E7ED; color: #141A2E; }
  .dka-mode--single .dka-mode__t span { color: #5A6475; }
  .dka-mode--single.is-on { border-color: #D6283A; }
