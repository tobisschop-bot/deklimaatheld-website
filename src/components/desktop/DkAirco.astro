  .dka-mode--multi.is-on { border-color: #D6283A; box-shadow: 0 0 0 4px rgba(214,40,58,.35); }
  .dka-mode__go { width: 34px; height: 34px; border-radius: 50%; background: #D6283A; display: grid; place-items: center; font-weight: 800; }

  /* één ruimte */
  .dka-sizes { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 8px; }
  .dka-size { cursor: pointer; }
  .dka-size__box { display: flex; flex-direction: column; gap: 2px; border-radius: 14px; padding: 14px 10px; background: #fff; border: 1px solid #E3E7ED; }
  .dka-size__box strong { font-size: 22px; font-weight: 900; font-stretch: 70%; line-height: 1; }
  .dka-size__box span { font-size: 12px; color: #5A6475; }
  .dka-size__box b { font-size: 12px; margin-top: 4px; }
  .dka-size input:checked + .dka-size__box { background: #141A2E; border-color: #141A2E; color: #fff; }
  .dka-size input:checked + .dka-size__box span { color: rgba(255,255,255,.8); }
  .dka-more { cursor: pointer; margin-top: 10px; display: inline-flex; align-items: center; gap: 8px; background: transparent; color: #141A2E; font-weight: 700; font-size: 15px; border: 2px dashed #CBD2DB; border-radius: 999px; padding: 8px 16px; }
  .dka-more span { color: #D6283A; font-size: 18px; line-height: 1; }
  .dka-colors { display: flex; gap: 22px; flex-wrap: wrap; }
  .dka-color { cursor: pointer; display: flex; align-items: center; gap: 10px; }
  .dka-color__dot { width: 48px; height: 48px; border-radius: 50%; border: 1px solid #CBD2DB; box-shadow: 0 0 0 3px #fff inset; outline: 3px solid transparent; outline-offset: 3px; }
  .dka-color input:checked + .dka-color__dot { outline-color: #D6283A; }
  .dka-color__t { display: flex; flex-direction: column; }
  .dka-color__t strong { font-size: 15px; }
  .dka-color__t span { font-size: 12px; color: #5A6475; }

  /* meerdere ruimtes */
  .dka-systeem { margin-bottom: 22px; }
  .dka-room { display: flex; gap: 14px; }
  .dka-pijp { flex: 0 0 44px; position: relative; }
  .dka-pijp__lijn { position: absolute; left: 20px; top: 0; bottom: 0; width: 4px; background: #D6283A; }
  .dka-pijp__lijn--eind { bottom: auto; height: 24px; }
  .dka-pijp__node { position: absolute; left: 6px; top: 14px; width: 32px; height: 32px; border-radius: 50%; background: #fff; color: #141A2E; border: 3px solid #D6283A; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
  .dka-pijp__node.is-open { background: #D6283A; color: #fff; }
  .dka-room__body { flex: 1; min-width: 0; padding-bottom: 12px; }
  .dka-room__dicht { cursor: pointer; width: 100%; display: flex; align-items: center; gap: 14px; text-align: left; background: #fff; border: 1px solid #E3E7ED; border-radius: 12px; padding: 12px 18px; color: #141A2E; font-size: 16px; }
  .dka-room__dicht img { width: 70px; height: auto; }
  .dka-room__dicht strong { font-size: 17px; }
  .dka-room__kort { flex: 1; color: #5A6475; font-size: 15px; }
  .dka-room__wijzig { font-size: 14px; font-weight: 700; color: #D6283A; }
  .dka-room__open { background: #fff; border: 1px solid #E3E7ED; border-left: 4px solid #D6283A; border-radius: 12px; padding: 18px 20px; display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-end; box-shadow: 0 14px 30px rgba(20,26,46,.08); }
  .dka-room__kop { flex: 1 1 100%; display: flex; align-items: center; gap: 12px; }
  .dka-room__kop strong { flex: 1; font-size: 18px; }
