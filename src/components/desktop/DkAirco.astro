  .dka-crumbs a { color: #5A6475; }
  .dka-grid { display: flex; gap: 32px; align-items: flex-start; }
  .dka-left { flex: 1.7 1 0; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .dka-h1 { font-size: 64px; line-height: .95; font-weight: 900; font-stretch: 65%; text-transform: uppercase; margin-top: 6px !important; }
  .dka-h2 { font-size: 56px; line-height: .95; font-weight: 900; font-stretch: 65%; text-transform: uppercase; }
  .dka-h3 { font-size: 34px; line-height: 1; font-weight: 900; font-stretch: 65%; text-transform: uppercase; margin: 6px 0 14px !important; }
  .dka-step { font-size: 24px; font-weight: 900; font-stretch: 70%; text-transform: uppercase; margin: 0 0 10px; padding: 0; }
  .dka-step span { font-size: 16px; font-weight: 600; font-stretch: 100%; text-transform: none; color: #5A6475; }
