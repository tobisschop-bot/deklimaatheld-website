---
// Spotlight "Ontdek ons assortiment" met kleurkeuze en terugverdien-meter.
// Besparing per jaar komt uit hetzelfde rekenmodel als de besparingscheck (src/lib/rekenmodel.ts).
import { warmtepompen, euro, kaartLink, fotoCrop } from '../../data/warmtepompen';
import { configurators } from '../../data/configurator';
import { AANNAMES, bereken } from '../../lib/rekenmodel';

// Referentiewoning voor de meter (indicatief). Pas hier aan als je een ander voorbeeld wilt.
const REF = { gasM3: 1200, personen: 3, label: 'rijtjeshuis' };
const scenario = (uitvoering: 'hybride' | 'all-electric') => {
  const u = bereken({ soort: 'lucht-water', uitvoering, gasM3: REF.gasM3, personen: REF.personen });
  return { perJaar: Math.round((u.nettoZonderInvestering * 12) / 10) * 10, m3: u.gasM3Bespaard };
};
const SCEN = { hybride: scenario('hybride'), 'all-electric': scenario('all-electric') };

// Bijsnijden van foto's met transparante rand (zelfde kaders als ProductImage)
// Extra bijsnijdkaders alleen voor de spotlight (de rest van de site blijft ongewijzigd).
// Quatt: de foto heeft rechtsonder een ingebakken schaduw; we snijden bij tot op de unit (incl. pootjes).
const quattImg = warmtepompen.find((w) => w.slug === 'quatt')?.img ?? '';
const SPOT_CROP: Record<string, { w: number; h: number; box: [number, number, number, number] }> = quattImg ? { [quattImg]: { w: 752, h: 433, box: [134, 57, 614, 385] } } : {};
const kader = (src: string) => fotoCrop[src] ?? SPOT_CROP[src];
const crop = (src: string) => { const c = kader(src); if (!c) return null; const bw = c.box[2] - c.box[0], bh = c.box[3] - c.box[1]; return { ar: `${bw}/${bh}`, w: (c.w / bw) * 100, l: (-c.box[0] / bw) * 100, t: (-c.box[1] / bh) * 100 }; };
// Zichtbare verhouding (b/h) per foto, zodat alle warmtepompen ongeveer even groot ogen (gelijke oppervlakte).
import sharp from 'sharp';
import { fileURLToPath } from 'node:url';
const pub = fileURLToPath(new URL('../../../public', import.meta.url));
const arCache: Record<string, number> = {};
const aspect = async (src: string) => {
  if (arCache[src]) return arCache[src];
  const c = kader(src);
  let ar = 1.3;
  if (c) ar = (c.box[2] - c.box[0]) / (c.box[3] - c.box[1]);
  else if (src.startsWith('/')) {
    try { const m = await sharp(pub + src).trim({ threshold: 1 }).toBuffer({ resolveWithObject: true }); ar = m.info.width / m.info.height; } catch { /* fallback */ }
  }
  return (arCache[src] = ar);
};
// Afmeting bij gelijke oppervlakte: podium in % van de breedte, rail in px
const podiumW = (ar: number) => Math.min(74, 54 * Math.sqrt(ar));
const railSize = (ar: number) => { let w = 58 * Math.sqrt(ar), h = w / ar; if (h > 62) { h = 62; w = h * ar; } if (w > 90) { w = 90; h = w / ar; } return { w: Math.round(w), h: Math.round(h) }; };
// Foto's van een externe server zonder bekend bijsnijdkader hebben soms veel lege rand: hier iets inzoomen.
const ZOOM: Record<string, number> = {};
const typeLabel: Record<string, string> = { hybride: 'Hybride', 'all-electric': 'All-electric', dakmontage: 'Dakmontage' };

// Volgorde in de spotlight: Quatt direct na de Vaillant aroTHERM plus (alleen hier; de data-volgorde blijft gelijk)
const volgorde = [...warmtepompen];
const qi = volgorde.findIndex((w) => w.slug === 'quatt'), vi = volgorde.findIndex((w) => w.slug === 'arotherm-plus');
if (qi > -1 && vi > -1) { const [q] = volgorde.splice(qi, 1); volgorde.splice(volgorde.findIndex((w) => w.slug === 'arotherm-plus') + 1, 0, q); }
const pumps = await Promise.all(volgorde.map(async (w) => {
  const cfg = configurators[w.slug];
  const basis: 'hybride' | 'all-electric' = w.types.includes('hybride') || !w.types.includes('all-electric') ? 'hybride' : 'all-electric';
  const kleuren = await Promise.all((cfg?.kleuren?.length ? cfg.kleuren : [{ id: 'std', name: 'Standaard', hex: '#9AA3B2' }]).map(async (k) => {
    const img = k.img ?? w.img;
    const ar = await aspect(img);
    return { name: k.name, hex: k.hex, img, crop: crop(img), ar, pw: podiumW(ar), rail: railSize(ar), zoom: ZOOM[w.slug] ?? 1 };
  }));
  return {
    merk: w.merk,
    name: w.name,
    short: w.name.replace(new RegExp('^' + w.merk + ' '), ''),
    tag: w.tag,
    types: w.types.map((t) => typeLabel[t] ?? t),
    href: kaartLink(w).href,
    from: w.from,
    isde: w.isde ?? 0,
    basis,
    perJaar: SCEN[basis].perJaar,
    m3: SCEN[basis].m3,
    kleuren,
    kleurNote: kleuren.length === 1 ? cfg?.kleurNote ?? '' : '',
  };
}));
const start = Math.max(0, pumps.findIndex((p) => p.short.startsWith('Sparrow')));
const cur = pumps[start];
const pad = (n: number) => String(n).padStart(2, '0');
const terug = (p: (typeof pumps)[number]) => (p.from == null ? null : Math.max(0, (p.from - p.isde) / p.perJaar));
const jr = (x: number) => x.toFixed(1).replace('.', ',');
const JAREN = [1, 3, 5, 7, 10];
const cfg = { gasprijs: AANNAMES.gasprijs, jaren: JAREN, startJaar: 3 };
---
<section class="dksp" data-dk-spot>
  <script type="application/json" data-dk-spot-data set:html={JSON.stringify({ pumps, cfg })} />
  <div class="dk-wrap">
    <div class="dksp__kop">
      <div><span class="dk-kicker dk-kicker--light">De showroom</span><h2 class="dk-h2">Ontdek ons assortiment</h2></div>
      <p class="dksp__teller"><strong data-f="pos">{pad(start + 1)}</strong> / {pad(pumps.length)}</p>
    </div>
    <div class="dksp__podium">
      <div class="dksp__stage">
        <span class="dksp__schaduw" aria-hidden="true"></span>
        <span class="dksp__pi" data-f="pi"><img data-f="img" src={cur.kleuren[0].img} alt={cur.name} /></span>
        <span class="dksp__kleurlabel"><span data-f="kleurdot"></span><span data-f="kleurnaam">{cur.kleuren[0].name}</span></span>
        <button type="button" class="dksp__pijl dksp__pijl--l" data-act="prev" aria-label="Vorig model">←</button>
        <button type="button" class="dksp__pijl dksp__pijl--r" data-act="next" aria-label="Volgend model">→</button>
      </div>
      <div class="dksp__info">
        <span class="dk-kicker dk-kicker--light" data-f="merk">{cur.merk}</span>
        <h3 data-f="short">{cur.short}</h3>
        <p class="dksp__tag" data-f="tag">{cur.tag}</p>
        <div class="dksp__chips" data-f="types">{cur.types.map((t) => <span>{t}</span>)}</div>

        <div class="dksp__kleuren" role="group" aria-label="Kies een kleur">
          <span class="dksp__kleuren-label">Kleur</span>
          <div data-f="kleuren"></div>
          <p class="dksp__kleurnote" data-f="kleurnote" hidden></p>
        </div>

        <div class="dksp__meter" data-f="meter">
          <div class="dksp__prijsregel"><span>Prijs incl. montage</span><strong data-f="prijs">{cur.from == null ? 'Op aanvraag' : euro(cur.from)}</strong></div>
          <div data-f="metermet">
            <div class="dksp__balk" aria-hidden="true"><span class="is-isde" data-f="bisde"></span><span class="is-gas" data-f="bgas"></span></div>
            <div class="dksp__legenda"><span><i class="is-isde"></i>ISDE <b data-f="isde"></b></span><span><i class="is-gas"></i>Gasbesparing <b data-f="gasjaren"></b></span><span><i class="is-rest"></i>Nog te verdienen</span></div>
            <div class="dksp__jaren" role="group" aria-label="Jaren na installatie">
              <span>Na</span>
              {JAREN.map((y) => <button type="button" data-jaar={y} aria-pressed={y === 3 ? 'true' : 'false'} class:list={{ 'is-on': y === 3 }}>{y === 1 ? '1 jaar' : y + ' jaar'}</button>)}
            </div>
            <p class="dksp__uitkomst" data-f="uitkomst" aria-live="polite"></p>
            <ul class="dksp__inzicht" data-f="inzicht"></ul>
          </div>
          <p class="dksp__opaanvraag" data-f="meterzonder" hidden>Prijs op aanvraag. Je terugverdientijd rekenen we voor je uit in de offerte.</p>
        </div>

        <div class="dksp__knoppen">
          <a class="dk-btn dk-btn--red" data-f="href" href={cur.href}>Stel samen →</a>
          <a class="dk-btn dk-btn--ghost" href="#dk-besparingscheck">Bereken jouw besparing</a>
        </div>
      </div>
    </div>
    <div class="dksp__rail" role="group" aria-label="Kies een model">
      {pumps.map((p, i) => (
        <button type="button" data-i={i} aria-label={p.name} aria-pressed={i === start ? 'true' : 'false'} class:list={['dksp__thumb', { 'is-on': i === start }]}>
          <span class="dksp__thumb-img"><span class:list={['dksp__tpi', { 'is-crop': !!p.kleuren[0].crop }]} style={`width:${p.kleuren[0].rail.w}px;height:${p.kleuren[0].rail.h}px`}><img src={p.kleuren[0].img} alt="" loading="lazy" style={p.kleuren[0].crop ? `width:${p.kleuren[0].crop.w}%;left:${p.kleuren[0].crop.l}%;top:${p.kleuren[0].crop.t}%` : p.kleuren[0].zoom !== 1 ? `transform:scale(${p.kleuren[0].zoom})` : ''} /></span></span>
          <span class="dksp__thumb-naam">{p.short}</span>
          <span class="dksp__thumb-sub">{p.from == null ? 'op aanvraag' : 'v.a. ' + euro(p.from)}</span>
        </button>
      ))}
    </div>
    <p class="dksp__voetnoot">
      * Indicatief. Netto besparing = minder gas min extra stroom, voor een {REF.label} met {REF.gasM3.toLocaleString('nl-NL')} m³ gas per jaar en {REF.personen} personen,
      gas € {AANNAMES.gasprijs.toFixed(2).replace('.', ',')}/m³ en stroom € {AANNAMES.stroomprijs.toFixed(2).replace('.', ',')}/kWh (zelfde rekenmodel als de besparingscheck).
      Hybride ± {euro(SCEN.hybride.perJaar)} per jaar, all-electric ± {euro(SCEN['all-electric'].perJaar)} per jaar. Energieprijzen gelijk gehouden; onderhoud niet meegerekend.
      ISDE is het maximale bedrag volgens de RVO-lijst. Jouw eigen besparing zie je in de besparingscheck.
    </p>
  </div>
</section>

<script>
  type Kleur = { name: string; hex: string; img: string; crop: { ar: string; w: number; l: number; t: number } | null; ar: number; pw: number; zoom: number };
  type Pump = { merk: string; name: string; short: string; tag: string; types: string[]; href: string; from: number | null; isde: number; basis: string; perJaar: number; m3: number; kleuren: Kleur[]; kleurNote: string };

  document.querySelectorAll<HTMLElement>('[data-dk-spot]').forEach((root) => {
    const { pumps: data, cfg } = JSON.parse(root.querySelector('[data-dk-spot-data]')!.textContent || '{}') as { pumps: Pump[]; cfg: { gasprijs: number; jaren: number[]; startJaar: number } };
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('.dksp__thumb')];
    const jaarBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-jaar]')];
    const f = (k: string) => root.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
    const eur = (n: number) => '€ ' + Math.round(n).toLocaleString('nl-NL');
    const jl = (y: number) => (y === 1 ? '1 jaar' : y + ' jaar');
    const komma = (x: number) => x.toFixed(1).replace('.', ',');
    let i = thumbs.findIndex((t) => t.classList.contains('is-on'));
    let k = 0;
    let jaar = cfg.startJaar;

    const toonKleur = () => {
      const p = data[i], kl = p.kleuren[Math.min(k, p.kleuren.length - 1)];
      const img = f('img') as HTMLImageElement, pi = f('pi');
      img.src = kl.img; img.alt = `${p.name} in ${kl.name.toLowerCase()}`;
      pi.style.aspectRatio = String(kl.ar); pi.style.width = kl.pw.toFixed(1) + '%';
      if (kl.crop) { pi.classList.add('is-crop'); img.style.width = kl.crop.w + '%'; img.style.left = kl.crop.l + '%'; img.style.top = kl.crop.t + '%'; }
      else { pi.classList.remove('is-crop'); img.style.width = ''; img.style.left = ''; img.style.top = ''; }
      img.style.transform = kl.zoom !== 1 ? `scale(${kl.zoom})` : '';
      f('kleurdot').style.background = kl.hex;
      f('kleurnaam').textContent = kl.name;
      f('kleuren').querySelectorAll<HTMLButtonElement>('button').forEach((b, j) => { b.classList.toggle('is-on', j === k); b.setAttribute('aria-pressed', String(j === k)); });
    };

    const meter = () => {
      const p = data[i];
      jaarBtns.forEach((b) => { const on = Number(b.dataset.jaar) === jaar; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
      const heeftPrijs = p.from != null;
      f('metermet').hidden = !heeftPrijs; f('meterzonder').hidden = heeftPrijs;
      if (!heeftPrijs) return;
      const prijs = p.from as number;
      const gas = p.perJaar * jaar;
      const rest = prijs - p.isde - gas;
      const terug = Math.max(0, (prijs - p.isde) / p.perJaar);
      const iP = Math.min(100, (p.isde / prijs) * 100), gP = Math.max(0, Math.min(100 - iP, (gas / prijs) * 100));
      f('bisde').style.width = iP.toFixed(1) + '%';
      f('bgas').style.width = gP.toFixed(1) + '%';
      f('isde').textContent = p.isde ? '− ' + eur(p.isde) : 'n.v.t.';
      f('gasjaren').textContent = jl(jaar);
      const uit = f('uitkomst');
      uit.textContent = rest > 0 ? `Na ${jl(jaar)}: nog ${eur(rest)}` : `Na ${jl(jaar)}: terugverdiend, + ${eur(-rest)} voordeel`;
      uit.classList.toggle('is-winst', rest <= 0);

      // Wat de jaren betekenen
      const regels: string[] = [];
      regels.push(`${(p.m3 * jaar).toLocaleString('nl-NL')} m³ minder gas verstookt (± ${p.m3.toLocaleString('nl-NL')} m³ per jaar, ${p.basis}).`);
      if (rest > 0) regels.push(`Nog ± ${komma(terug - jaar)} jaar tot hij is terugverdiend (na ± ${komma(terug)} jaar).`);
      else regels.push(`Terugverdiend na ± ${komma(terug)} jaar. Daarna elk jaar ± ${eur(p.perJaar)} extra in je zak.`);
      if (jaar >= 5) {
        const extra = p.m3 * jaar * cfg.gasprijs * 0.1;
        regels.push(`Stijgt de gasprijs 10%? Dan bespaar je over ${jl(jaar)} nog ± ${eur(extra)} extra.`);
      }
      if (jaar >= 7 && p.basis === 'all-electric') regels.push('Gasaansluiting opgezegd? Dan vervalt ook het vastrecht voor gas (niet meegerekend).');
      if (jaar >= 10) regels.push('Een warmtepomp gaat doorgaans 15 jaar of langer mee: het voordeel loopt na jaar 10 gewoon door.');
      const ul = f('inzicht'); ul.innerHTML = '';
      regels.forEach((r) => { const li = document.createElement('li'); li.textContent = r; ul.appendChild(li); });
    };

    const show = (n: number) => {
      i = (n + data.length) % data.length; k = 0;
      const p = data[i];
      f('merk').textContent = p.merk; f('short').textContent = p.short; f('tag').textContent = p.tag;
      f('prijs').textContent = p.from == null ? 'Op aanvraag' : eur(p.from);
      (f('href') as HTMLAnchorElement).href = p.href;
      f('types').innerHTML = '';
      p.types.forEach((t) => { const s = document.createElement('span'); s.textContent = t; f('types').appendChild(s); });
      // kleurknoppen
      const kc = f('kleuren'); kc.innerHTML = '';
      p.kleuren.forEach((kl, j) => {
        const b = document.createElement('button'); b.type = 'button';
        const dot = document.createElement('span'); dot.className = 'dksp__dot'; dot.style.background = kl.hex;
        b.append(dot, document.createTextNode(kl.name));
        b.addEventListener('click', () => { k = j; toonKleur(); });
        kc.appendChild(b);
      });
      const note = f('kleurnote'); note.textContent = p.kleurNote; note.hidden = !p.kleurNote;
      f('pos').textContent = String(i + 1).padStart(2, '0');
      thumbs.forEach((t, x) => { t.classList.toggle('is-on', x === i); t.setAttribute('aria-pressed', x === i ? 'true' : 'false'); });
      toonKleur();
      meter();
    };
    root.querySelector('[data-act="prev"]')!.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-act="next"]')!.addEventListener('click', () => show(i + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.i))));
    jaarBtns.forEach((b) => b.addEventListener('click', () => { jaar = Number(b.dataset.jaar); meter(); }));
    show(i);
  });
</script>

<style>
  .dksp { padding: 32px 0 112px; background: #0B132B; }
  .dksp__kop { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 24px; }
  .dksp__kop .dk-h2 { margin-top: 12px; font-size: 64px; color: #fff; }
  .dksp__teller { color: #C9CFDA; font-size: 15px; white-space: nowrap; }
  .dksp__teller strong { color: #fff; font-size: 28px; font-stretch: 62%; }
  .dksp__podium { display: grid; grid-template-columns: 1.1fr 1fr; background: linear-gradient(135deg, rgba(255,255,255,.07), rgba(255,255,255,.02)); border: 1px solid rgba(255,255,255,.12); border-radius: 28px; overflow: hidden; }
  .dksp__stage { position: relative; min-height: 560px; display: grid; place-items: center; background: radial-gradient(55% 45% at 50% 62%, rgba(214,40,58,.45), rgba(214,40,58,0) 70%); }
  .dksp__pi { position: relative; display: block; width: 60%; max-height: 420px; filter: drop-shadow(0 30px 30px rgba(0,0,0,.5)); }
  .dksp__pi img { width: 100%; height: 100%; object-fit: contain; }
  .dksp__pi.is-crop { overflow: hidden; }
  .dksp__pi.is-crop img { position: absolute; max-width: none; max-height: none; height: auto; }
  .dksp__schaduw { position: absolute; left: 18%; right: 18%; bottom: 80px; height: 60px; border-radius: 50%; background: radial-gradient(closest-side, rgba(0,0,0,.55), rgba(0,0,0,0)); }
  .dksp__kleurlabel { position: absolute; left: 24px; bottom: 24px; display: inline-flex; align-items: center; gap: 8px; background: rgba(11,19,43,.75); border: 1px solid rgba(255,255,255,.2); border-radius: 999px; padding: 7px 14px 7px 8px; font-size: 13px; font-weight: 800; color: #fff; }
  .dksp__kleurlabel [data-f="kleurdot"] { width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255,255,255,.35); }
  .dksp__pijl { position: absolute; top: 50%; transform: translateY(-50%); width: 56px; height: 56px; border-radius: 50%; font: inherit; font-size: 22px; font-weight: 800; color: #fff; cursor: pointer; }
  .dksp__pijl--l { left: 24px; border: 1px solid rgba(255,255,255,.3); background: rgba(11,19,43,.6); }
  .dksp__pijl--r { right: 24px; border: 0; background: #D6283A; }
  .dksp__info { padding: 40px 40px 36px; display: flex; flex-direction: column; gap: 16px; background: rgba(11,19,43,.5); min-width: 0; }
  .dksp__info h3 { margin-top: -6px; font-size: 60px; line-height: .88; font-weight: 900; font-stretch: 62%; text-transform: uppercase; color: #fff; }
  .dksp__tag { font-size: 17px; color: #C9CFDA; }
  .dksp__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .dksp__chips :global(span) { font-size: 12px; font-weight: 800; border: 1px solid rgba(255,255,255,.3); padding: 5px 11px; border-radius: 999px; color: #fff; }
  /* kleurkeuze */
  .dksp__kleuren { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .dksp__kleuren-label { font-size: 13px; font-weight: 800; color: #9AA3B2; }
  .dksp__kleuren [data-f="kleuren"] { display: flex; flex-wrap: wrap; gap: 8px; }
  .dksp__kleuren :global(button) { font: inherit; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 800; padding: 7px 14px 7px 8px; border-radius: 999px; cursor: pointer; color: #fff; background: transparent; border: 2px solid rgba(255,255,255,.2); }
  .dksp__kleuren :global(button.is-on) { background: rgba(255,255,255,.14); border-color: #fff; }
  .dksp__kleuren :global(.dksp__dot) { width: 16px; height: 16px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(255,255,255,.35); }
  .dksp__kleurnote { flex-basis: 100%; font-size: 12px; color: #9AA3B2; }
  /* terugverdien-meter */
  .dksp__meter { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 18px; padding: 18px 20px; }
  .dksp__prijsregel { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .dksp__prijsregel span { font-size: 12px; color: #9AA3B2; }
  .dksp__prijsregel strong { font-size: 24px; font-weight: 900; color: #fff; }
  .dksp__balk { display: flex; height: 22px; border-radius: 999px; overflow: hidden; background: #D6283A; margin: 12px 0 8px; }
  .dksp__balk span { display: block; height: 100%; transition: width .45s ease; }
  .dksp__balk .is-isde, .dksp__legenda i.is-isde { background: #1E9E6A; }
  .dksp__balk .is-gas, .dksp__legenda i.is-gas { background: #7FD9AE; }
  .dksp__legenda i.is-rest { background: #D6283A; }
  .dksp__legenda { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: #C9CFDA; margin-bottom: 14px; }
  .dksp__legenda i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; }
