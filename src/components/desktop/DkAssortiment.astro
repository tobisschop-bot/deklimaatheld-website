---
// Assortiment als merkschappen (donkerblauw)
import { warmtepompen, euro, kaartLink, fotoCrop } from '../../data/warmtepompen';
import ProductImage from '../ProductImage.astro';
const notes: Record<string, string> = {
  Weheat: 'Nederlands ontwerp, van compact tot dakintegratie.',
  Vaillant: 'Stil en betrouwbaar, op R290.',
  Daikin: 'Van hybride tot krachtig all-electric.',
  Haier: 'Scherp geprijsd, ook op R290.',
  Quatt: 'Slimme hybride, ook all-electric.',
};
const merken = [...new Set(warmtepompen.map((w) => w.merk))];
const groepen = merken.map((m) => {
  const items = warmtepompen.filter((w) => w.merk === m);
  return { merk: m, note: notes[m] ?? '', n: items.length + (items.length === 1 ? ' model' : ' modellen'), items };
});
---
<section class="dkas" id="dk-assortiment">
  <div class="dk-wrap">
    <div class="dkas__kop">
      <span class="dk-kicker dk-kicker--light">De showroom</span>
      <h2 class="dk-h2">Ons assortiment</h2>
      <p>{merken.length} merken, {warmtepompen.length} modellen. Alles met vaste prijs inclusief montage, ontworpen volgens de Heat Geek-methode.</p>
    </div>
    <div class="dkas__schappen">
      {groepen.map((g) => (
        <div class="dkas__schap">
          <div class="dkas__merk"><div><p class="dkas__naam">{g.merk}</p><p class="dkas__note">{g.note}</p></div><span>{g.n}</span></div>
          <div class="dkas__items">
            {g.items.map((w) => (
              <article>
                <div class="dkas__plank"><span aria-hidden="true"></span>{fotoCrop[w.img] ? <div class="dkas__crop"><ProductImage src={w.img} alt={w.name} /></div> : <img src={w.img} alt={w.name} loading="lazy" />}</div>
                <h3>{w.name.replace(new RegExp('^' + w.merk + ' '), '')}</h3>
                <p class="dkas__tag">{w.tag}</p>
                <div class="dkas__voet">
                  <div><p class="dkas__prijs">{w.from == null ? 'Op aanvraag' : 'v.a. ' + euro(w.from)}</p><p class="dkas__isde">{w.isde ? euro(w.isde) + ' ISDE' : 'Incl. montage'}</p></div>
                  <a class="dkas__knop" href={kaartLink(w).href}>Stel samen</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="dkas__onder"><a class="dk-btn dk-btn--red" href="#dk-besparingscheck">Doe de besparingscheck →</a><a class="dk-btn dk-btn--ghost" href="/warmtepompen/">Vergelijk modellen</a></div>
  </div>
</section>

<style>
  .dkas { background: linear-gradient(180deg, #141A2E 0%, #0B132B 100%); color: #fff; padding: 112px 0 120px; }
  .dkas__kop { text-align: center; margin-bottom: 64px; }
  .dkas__kop .dk-h2 { margin: 12px auto 16px; font-size: clamp(72px, 6.6vw, 96px); color: #fff; }
  .dkas__kop p { margin: 0 auto; max-width: 560px; font-size: 17px; line-height: 1.6; color: #C9CFDA; }
  .dkas__schappen { display: flex; flex-direction: column; gap: 20px; }
  .dkas__schap { display: grid; grid-template-columns: 220px 1fr; gap: 32px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); border-radius: 24px; padding: 28px 32px; }
  .dkas__merk { display: flex; flex-direction: column; justify-content: space-between; gap: 12px; }
  .dkas__naam { font-size: 46px; line-height: .9; font-weight: 900; font-stretch: 62%; text-transform: uppercase; overflow-wrap: normal; }
  .dkas__note { margin-top: 8px !important; font-size: 14px; color: #9AA3B2; line-height: 1.45; }
  .dkas__merk > span { font-size: 13px; font-weight: 800; color: #FF8A95; }
  .dkas__items { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
  .dkas__items article { display: flex; flex-direction: column; }
  .dkas__plank { position: relative; height: 160px; display: grid; place-items: end center; padding-bottom: 14px; border-bottom: 3px solid rgba(255,255,255,.18); }
  .dkas__plank span { position: absolute; left: 10%; right: 10%; bottom: -10px; height: 26px; border-radius: 50%; background: radial-gradient(closest-side, rgba(214,40,58,.5), rgba(214,40,58,0)); filter: blur(3px); }
  .dkas__crop { position: relative; width: 78%; filter: drop-shadow(0 12px 12px rgba(0,0,0,.45)); }
  .dkas__plank > img { position: relative; max-width: 80%; max-height: 140px; object-fit: contain; filter: drop-shadow(0 12px 12px rgba(0,0,0,.45)); }
  .dkas__items h3 { margin-top: 16px; font-size: 22px; line-height: 1.05; font-weight: 900; font-stretch: 78%; text-transform: uppercase; color: #fff; }
  .dkas__tag { margin: 2px 0 10px !important; font-size: 13px; color: #9AA3B2; }
  .dkas__voet { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; }
  .dkas__prijs { font-size: 17px; font-weight: 800; white-space: nowrap; }
  .dkas__isde { font-size: 12px; font-weight: 700; color: #4CC38A; }
  .dkas__knop { flex: none; background: #fff; color: #141A2E; font-weight: 800; text-decoration: none; padding: 10px 16px; border-radius: 999px; font-size: 14px; }
  .dkas__knop:hover { background: #FFE3E6; }
  .dkas__onder { margin-top: 40px; display: flex; justify-content: center; gap: 14px; }
</style>
